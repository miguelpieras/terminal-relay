#!/usr/bin/python3
"""Reusable, capped device enrollment command for the App Review worker."""

from __future__ import annotations

import base64
import binascii
import fcntl
import hashlib
import os
from pathlib import Path
import re
import sys
import tempfile
import time
import uuid


ENROLLMENT_MARKER = "__TERMINAL_RELAY_DEVICE_ENROLLMENT_V1__"
INVITATION_PREFIX = "terminal-relay-review-invitation:"
DEVICE_PREFIX = "terminal-relay-review-device:"
PUBLIC_KEY = re.compile(r"^ssh-ed25519 ([A-Za-z0-9+/=]+) terminal-relay-ios$")


def fail(message: str, status: int = 64) -> "NoReturn":
    print(message, file=sys.stderr)
    raise SystemExit(status)


def validate_arguments() -> tuple[str, int, int]:
    if len(sys.argv) != 4:
        fail("The review enrollment command is invalid.")
    try:
        token = str(uuid.UUID(sys.argv[1]))
        expires_at = int(sys.argv[2])
        maximum_devices = int(sys.argv[3])
    except (ValueError, OverflowError):
        fail("The review enrollment command is invalid.")
    if token != sys.argv[1] or not 1 <= maximum_devices <= 20:
        fail("The review enrollment command is invalid.")
    if int(time.time()) > expires_at:
        fail("This App Review invitation has expired.", 75)
    return token, expires_at, maximum_devices


def decode_device_key() -> tuple[str, str]:
    original = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    prefix = "terminal-relay-enroll-device "
    if not original.startswith(prefix):
        fail("This SSH key can only enroll a Terminal Relay review device.")
    encoded = original[len(prefix) :]
    if not encoded or len(encoded) > 16_384:
        fail("The Terminal Relay device key is invalid.")
    try:
        line = base64.b64decode(encoded, validate=True).decode("utf-8")
    except (binascii.Error, UnicodeDecodeError):
        fail("The Terminal Relay device key is invalid.")
    match = PUBLIC_KEY.fullmatch(line)
    if not match:
        fail("The Terminal Relay device key is invalid.")
    try:
        wire_key = base64.b64decode(match.group(1), validate=True)
    except binascii.Error:
        fail("The Terminal Relay device key is invalid.")
    if len(wire_key) < 32:
        fail("The Terminal Relay device key is invalid.")
    fingerprint = base64.b64encode(hashlib.sha256(wire_key).digest()).decode().rstrip("=")
    return f"ssh-ed25519 {match.group(1)}", fingerprint


def safe_authorized_keys() -> tuple[Path, Path]:
    home = Path(os.environ.get("HOME", "")).resolve()
    ssh_directory = home / ".ssh"
    authorized_keys = ssh_directory / "authorized_keys"
    if (
        not home.is_absolute()
        or not ssh_directory.is_dir()
        or ssh_directory.is_symlink()
        or not authorized_keys.is_file()
        or authorized_keys.is_symlink()
    ):
        fail("The worker SSH authorization file is unsafe.", 78)
    if ssh_directory.stat().st_uid != os.getuid() or authorized_keys.stat().st_uid != os.getuid():
        fail("The worker SSH authorization file has an unexpected owner.", 78)
    if ssh_directory.stat().st_mode & 0o077 or authorized_keys.stat().st_mode & 0o177:
        fail("The worker SSH authorization permissions are unsafe.", 78)
    return ssh_directory, authorized_keys


def install_device(
    token: str,
    maximum_devices: int,
    key: str,
    fingerprint: str,
) -> None:
    ssh_directory, authorized_keys = safe_authorized_keys()
    lock_path = ssh_directory / ".terminal-relay-pairing.lock"
    lock_path.touch(mode=0o600, exist_ok=True)
    os.chmod(lock_path, 0o600)

    with lock_path.open("r+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        lines = authorized_keys.read_text(encoding="utf-8").splitlines()
        invitation_marker = f"{INVITATION_PREFIX}{token}"
        if not any(line.endswith(invitation_marker) for line in lines):
            fail("This App Review invitation has been revoked.", 76)

        device_marker_prefix = f"{DEVICE_PREFIX}{token}:"
        existing = [
            line
            for line in lines
            if line.endswith(f"{device_marker_prefix}{fingerprint}")
        ]
        if not existing:
            enrolled = sum(device_marker_prefix in line for line in lines)
            if enrolled >= maximum_devices:
                fail("This App Review invitation reached its device limit.", 76)
            options = (
                'no-agent-forwarding,no-port-forwarding,no-X11-forwarding,no-user-rc,'
                'command="/usr/local/bin/terminal-relay-review-gateway"'
            )
            lines.append(
                f"{options} {key} {device_marker_prefix}{fingerprint}"
            )

        descriptor, temporary_name = tempfile.mkstemp(
            prefix=".authorized_keys.",
            dir=ssh_directory,
            text=True,
        )
        try:
            os.fchmod(descriptor, 0o600)
            with os.fdopen(descriptor, "w", encoding="utf-8") as temporary:
                temporary.write("\n".join(lines) + "\n")
                temporary.flush()
                os.fsync(temporary.fileno())
            os.replace(temporary_name, authorized_keys)
        finally:
            if os.path.exists(temporary_name):
                os.unlink(temporary_name)


def main() -> None:
    token, _, maximum_devices = validate_arguments()
    key, fingerprint = decode_device_key()
    install_device(token, maximum_devices, key, fingerprint)
    print(ENROLLMENT_MARKER)
    print("paired")


if __name__ == "__main__":
    main()
