# Terminal Relay worker host baseline template.
#
# Copy this file to Server/worker-baseline.local.env and replace every
# REPLACE_ME value. The local file is ignored by Git and is the only baseline
# read by the worker lifecycle commands. Never add credentials or private keys.

TERMINAL_RELAY_BASELINE_VERSION="terminal-relay-host-v1"
TERMINAL_RELAY_PROVIDER_PROJECT_ID="REPLACE_ME"
TERMINAL_RELAY_HCLOUD_CONTEXT="terminal-relay"
# Optional separate hcloud config for App Review lifecycle commands. Leave this
# empty to use the normal hcloud config without changing its active context.
TERMINAL_RELAY_REVIEW_HCLOUD_CONFIG=""
TERMINAL_RELAY_SERVER_TYPE="cpx22"
TERMINAL_RELAY_SERVER_LOCATION="fsn1"
TERMINAL_RELAY_SERVER_IMAGE="ubuntu-24.04"
TERMINAL_RELAY_PROVIDER_FIREWALL_NAME="terminal-relay-worker-ingress"
TERMINAL_RELAY_PROVIDER_FIREWALL_ID="REPLACE_ME"

# The isolated App Review worker uses these public, non-secret lifecycle names.
# It is never enrolled in Tailscale and never shares the private worker firewall.
TERMINAL_RELAY_REVIEW_SERVER_NAME="terminal-relay-app-review"
TERMINAL_RELAY_REVIEW_SERVER_TYPE="cpx22"
TERMINAL_RELAY_REVIEW_SERVER_LOCATION="fsn1"
TERMINAL_RELAY_REVIEW_SERVER_IMAGE="ubuntu-24.04"
TERMINAL_RELAY_REVIEW_FIREWALL_NAME="terminal-relay-app-review-ingress"

TERMINAL_RELAY_TAILSCALE_TAG="tag:terminal-relay-worker"
TERMINAL_RELAY_TAILSCALE_VERSION="1.98.9"
TERMINAL_RELAY_MONITOR_IPV4="REPLACE_ME"
TERMINAL_RELAY_MONITOR_IPV6="REPLACE_ME"
TERMINAL_RELAY_DESKTOP_IPV4="REPLACE_ME"
TERMINAL_RELAY_DESKTOP_IPV6="REPLACE_ME"

TERMINAL_RELAY_DOCKER_VERSION="29.1.3-0ubuntu3~24.04.2"
TERMINAL_RELAY_CONTAINERD_VERSION="2.2.1-0ubuntu1~24.04.3"
TERMINAL_RELAY_RUNC_VERSION="1.3.4-0ubuntu1~24.04.1"
TERMINAL_RELAY_NODE_EXPORTER_VERSION="1.7.0-1ubuntu0.3"
TERMINAL_RELAY_UFW_VERSION="0.36.2-6"

TERMINAL_RELAY_OPERATOR_KEY_FINGERPRINT="REPLACE_ME"
TERMINAL_RELAY_OPERATOR_AUTHORIZED_KEY="REPLACE_ME"
TERMINAL_RELAY_OPERATOR_PRIVATE_KEY="${HOME}/.ssh/terminal-relay-operator"
