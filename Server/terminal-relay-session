#!/bin/bash
set -euo pipefail

readonly protocol_marker="__TERMINAL_RELAY_SESSION_V1__"
readonly agent_update_protocol_marker="__TERMINAL_RELAY_AGENT_UPDATE_V1__"
readonly installed_helper_path="/usr/local/bin/terminal-relay-session"
readonly default_agent_update_status_path="/var/lib/terminal-relay/agent-update-status"
readonly default_tmux_path="/usr/bin/tmux"
readonly default_tmux_socket="terminal-relay"
readonly default_workspace_root="/workspace"
readonly default_codex_path="/usr/bin/codex"
readonly default_claude_path="/usr/bin/claude"
readonly default_flock_path="/usr/bin/flock"
readonly default_python_path="/usr/bin/python3"
readonly default_getent_path="/usr/bin/getent"
readonly default_boot_id_path="/proc/sys/kernel/random/boot_id"
readonly default_safe_path="/usr/local/bin:/usr/bin:/bin"

resolve_helper_path() {
    local path="$0"
    local directory

    case "$path" in
        /*) ;;
        */*)
            directory="$(cd "$(dirname "$path")" && pwd -P)"
            path="$directory/$(basename "$path")"
            ;;
        *)
            path="$(command -v "$path")"
            ;;
    esac
    printf '%s\n' "$path"
}

helper_path="$(resolve_helper_path)"
test_environment_present=0
if /usr/bin/env | /usr/bin/grep -q '^TERMINAL_RELAY_TEST_'; then
    test_environment_present=1
fi

helper_is_installed=0
if [[ "$helper_path" == "$installed_helper_path" ]]; then
    helper_is_installed=1
elif [[ -e "$installed_helper_path" ]] \
    && [[ "$helper_path" -ef "$installed_helper_path" ]]; then
    helper_is_installed=1
fi

if [[ $helper_is_installed -eq 1 ]]; then
    if [[ $test_environment_present -eq 1 ]]; then
        echo "The installed terminal-relay-session helper refuses test overrides." >&2
        exit 78
    fi
    test_mode=0
elif [[ "${TERMINAL_RELAY_TEST_MODE:-}" == "1" ]]; then
    test_mode=1
elif [[ $test_environment_present -eq 1 ]]; then
    echo "Test overrides require TERMINAL_RELAY_TEST_MODE=1 and a non-installed helper path." >&2
    exit 78
else
    test_mode=0
fi

user_id="$(/usr/bin/id -u)"
if [[ $test_mode -eq 1 ]]; then
    tmux_path="${TERMINAL_RELAY_TEST_TMUX_PATH:-$default_tmux_path}"
    tmux_socket="${TERMINAL_RELAY_TEST_TMUX_SOCKET:-$default_tmux_socket}"
    workspace_root="${TERMINAL_RELAY_TEST_WORKSPACE_ROOT:-$default_workspace_root}"
    runtime_directory="${TERMINAL_RELAY_TEST_RUNTIME_ROOT:-/run/user/$user_id/terminal-relay}"
    codex_path="${TERMINAL_RELAY_TEST_CODEX_PATH:-$default_codex_path}"
    claude_path="${TERMINAL_RELAY_TEST_CLAUDE_PATH:-$default_claude_path}"
    flock_path="${TERMINAL_RELAY_TEST_FLOCK_PATH:-$default_flock_path}"
    signal_path="${TERMINAL_RELAY_TEST_SIGNAL_PATH:-}"
    boot_id_path="${TERMINAL_RELAY_TEST_BOOT_ID_PATH:-$default_boot_id_path}"
    codex_shared_account_enabled="${TERMINAL_RELAY_TEST_CODEX_SHARED_ACCOUNT:-0}"
    codex_app_server_socket="${TERMINAL_RELAY_TEST_CODEX_APP_SERVER_SOCKET:-$runtime_directory/codex.sock}"
    agent_update_status_path="${TERMINAL_RELAY_TEST_AGENT_UPDATE_STATUS_PATH:-$default_agent_update_status_path}"
else
    if [[ ! -x "$default_getent_path" ]]; then
        echo "Required account database command is unavailable: $default_getent_path" >&2
        exit 69
    fi
    runtime_home="$($default_getent_path passwd "$user_id" \
        | /usr/bin/awk -F: -v expected_uid="$user_id" \
            '$3 == expected_uid { count++; home = $6 } END { if (count == 1) print home }')"
    if [[ "$runtime_home" != /* || "$runtime_home" == "/" \
        || "$runtime_home" == *$'\n'* || ! -d "$runtime_home" ]]; then
        echo "Unable to derive a safe home directory for uid $user_id." >&2
        exit 78
    fi
    runtime_home="$(cd "$runtime_home" && pwd -P)"
    tmux_path="$default_tmux_path"
    tmux_socket="$default_tmux_socket"
    workspace_root="$default_workspace_root"
    runtime_directory="$runtime_home/.local/state/terminal-relay"
    codex_path="$default_codex_path"
    claude_path="$default_claude_path"
    flock_path="$default_flock_path"
    signal_path=""
    boot_id_path="$default_boot_id_path"
    codex_shared_account_enabled=1
    codex_app_server_socket="$runtime_directory/codex.sock"
    agent_update_status_path="$default_agent_update_status_path"
fi
readonly codex_app_server_session="terminal-relay-account-server"

usage() {
    cat >&2 <<'EOF'
usage:
  terminal-relay-session list-projects
  terminal-relay-session status
  terminal-relay-session resources
  terminal-relay-session update-status
  terminal-relay-session restore
  terminal-relay-session start <codex|claude> <repository> [agent arguments...]
  terminal-relay-session attach <codex|claude> <repository> [agent arguments...]
  terminal-relay-session reattach <codex|claude> <repository> <instance>
  terminal-relay-session stop <codex|claude> <repository> <instance>
  terminal-relay-session codex-account
  terminal-relay-session claude-account
  terminal-relay-session codex-login
  terminal-relay-session codex-reset <idempotency-key> [credit-id]
  terminal-relay-session <codex|claude> [agent arguments...]
EOF
}

fail_usage() {
    echo "$1" >&2
    usage
    exit 64
}

validate_absolute_path() {
    local label="$1"
    local path="$2"

    if [[ "$path" != /* || "$path" == *$'\n'* || "$path" == "/" ]]; then
        echo "Invalid $label path: $path" >&2
        exit 78
    fi
}

validate_absolute_path "tmux" "$tmux_path"
validate_absolute_path "workspace root" "$workspace_root"
validate_absolute_path "runtime root" "$runtime_directory"
validate_absolute_path "Codex executable" "$codex_path"
validate_absolute_path "Claude executable" "$claude_path"
validate_absolute_path "flock executable" "$flock_path"
validate_absolute_path "boot id" "$boot_id_path"
validate_absolute_path "Codex app-server socket" "$codex_app_server_socket"
validate_absolute_path "agent update status" "$agent_update_status_path"

if [[ "$codex_shared_account_enabled" == "1" ]]; then
    codex_socket_bytes="$(printf '%s' "$codex_app_server_socket" | /usr/bin/wc -c | /usr/bin/tr -d '[:space:]')"
    if [[ ! "$codex_socket_bytes" =~ ^[0-9]+$ || $codex_socket_bytes -gt 100 ]]; then
        echo "Codex app-server socket path is too long: $codex_app_server_socket" >&2
        exit 78
    fi
fi

if [[ ! "$tmux_socket" =~ ^[A-Za-z0-9._-]+$ || ${#tmux_socket} -gt 64 ]]; then
    echo "Invalid tmux socket label: $tmux_socket" >&2
    exit 78
fi

while [[ "$workspace_root" == */ ]]; do
    workspace_root="${workspace_root%/}"
done
while [[ "$runtime_directory" == */ ]]; do
    runtime_directory="${runtime_directory%/}"
done
readonly codex_app_server_restart_marker="$runtime_directory/codex-app-server-restart-required"

umask 077
if [[ -L "$runtime_directory" ]] \
    || { [[ -e "$runtime_directory" ]] && [[ ! -d "$runtime_directory" ]]; }; then
    echo "Runtime state root is not a safe directory: $runtime_directory" >&2
    exit 78
fi
/usr/bin/install -d -m 700 "$runtime_directory"
/bin/chmod 700 "$runtime_directory"

tmux_command() {
    "$tmux_path" -f /dev/null -L "$tmux_socket" "$@" 3>&- 6>&- 7>&- 8>&-
}

run_codex_rpc() {
    local mode="$1"
    shift

    [[ -x "$default_python_path" ]] || {
        echo "Required Python executable is unavailable: $default_python_path" >&2
        return 69
    }

    "$default_python_path" - "$codex_app_server_socket" "$mode" "$@" <<'PYTHON_CODEX_RPC'
import base64
import hashlib
import json
import os
import signal
import socket
import struct
import sys
import time

socket_path, mode, *arguments = sys.argv[1:]
maximum_frame_bytes = 8 * 1024 * 1024


class WebSocket:
    def __init__(self, path):
        self.socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.socket.settimeout(5)
        self.socket.connect(path)
        self.buffer = b""
        key = base64.b64encode(os.urandom(16)).decode("ascii")
        request = (
            "GET / HTTP/1.1\r\n"
            "Host: localhost\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "\r\n"
        ).encode("ascii")
        self.socket.sendall(request)
        headers = self._read_headers()
        status_line, *header_lines = headers.split(b"\r\n")
        if b" 101 " not in status_line:
            raise RuntimeError("Codex app-server rejected the websocket connection.")
        response_headers = {}
        for line in header_lines:
            name, separator, value = line.partition(b":")
            if separator:
                response_headers[name.strip().lower()] = value.strip()
        expected_accept = base64.b64encode(
            hashlib.sha1(
                key.encode("ascii") + b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
            ).digest()
        )
        if response_headers.get(b"sec-websocket-accept") != expected_accept:
            raise RuntimeError("Codex app-server returned an invalid websocket handshake.")

    def _read_headers(self):
        while b"\r\n\r\n" not in self.buffer:
            chunk = self.socket.recv(4096)
            if not chunk:
                raise EOFError("Codex app-server closed during websocket setup.")
            self.buffer += chunk
            if len(self.buffer) > 64 * 1024:
                raise RuntimeError("Codex app-server returned oversized websocket headers.")
        headers, self.buffer = self.buffer.split(b"\r\n\r\n", 1)
        return headers

    def _read_exact(self, length):
        while len(self.buffer) < length:
            chunk = self.socket.recv(max(4096, length - len(self.buffer)))
            if not chunk:
                raise EOFError("Codex app-server closed the connection.")
            self.buffer += chunk
        result, self.buffer = self.buffer[:length], self.buffer[length:]
        return result

    def send_frame(self, opcode, payload=b""):
        if isinstance(payload, str):
            payload = payload.encode("utf-8")
        length = len(payload)
        header = bytes([0x80 | opcode])
        if length < 126:
            header += bytes([0x80 | length])
        elif length < 65_536:
            header += bytes([0x80 | 126]) + struct.pack("!H", length)
        else:
            header += bytes([0x80 | 127]) + struct.pack("!Q", length)
        mask = os.urandom(4)
        masked = bytes(value ^ mask[index % 4] for index, value in enumerate(payload))
        self.socket.sendall(header + mask + masked)

    def send_json(self, value):
        self.send_frame(1, json.dumps(value, separators=(",", ":")))

    def receive_message(self):
        fragments = []
        message_opcode = None
        while True:
            first, second = self._read_exact(2)
            final = bool(first & 0x80)
            opcode = first & 0x0F
            masked = bool(second & 0x80)
            length = second & 0x7F
            if length == 126:
                length = struct.unpack("!H", self._read_exact(2))[0]
            elif length == 127:
                length = struct.unpack("!Q", self._read_exact(8))[0]
            if length > maximum_frame_bytes:
                raise RuntimeError("Codex app-server returned an oversized websocket frame.")
            mask = self._read_exact(4) if masked else None
            payload = self._read_exact(length)
            if mask is not None:
                payload = bytes(
                    value ^ mask[index % 4] for index, value in enumerate(payload)
                )
            if opcode == 8:
                raise EOFError("Codex app-server closed the connection.")
            if opcode == 9:
                self.send_frame(10, payload)
                continue
            if opcode in (1, 2):
                message_opcode = opcode
                fragments = [payload]
            elif opcode == 0 and message_opcode is not None:
                fragments.append(payload)
            else:
                continue
            if final:
                return message_opcode, b"".join(fragments)

    def receive_json(self, deadline):
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("Timed out waiting for Codex app-server.")
            self.socket.settimeout(min(remaining, 2))
            try:
                opcode, payload = self.receive_message()
            except socket.timeout:
                continue
            if opcode == 1:
                return json.loads(payload)

    def close(self):
        try:
            self.send_frame(8)
        except (OSError, RuntimeError):
            pass
        self.socket.close()


def initialize(client):
    client.send_json(
        {
            "method": "initialize",
            "id": 0,
            "params": {
                "clientInfo": {
                    "name": "terminal_relay",
                    "title": "Terminal Relay",
                    "version": "1.0.0",
                }
            },
        }
    )
    client.send_json({"method": "initialized", "params": {}})


def wait_for_response(client, request_id, timeout):
    deadline = time.monotonic() + timeout
    while True:
        value = client.receive_json(deadline)
        if value.get("id") == request_id:
            return value


def account_is_available(response):
    result = response.get("result")
    return isinstance(result, dict) and (
        isinstance(result.get("account"), dict)
        or result.get("requiresOpenaiAuth") is False
    )


client = None
pending_login_id = None
login_completed = False


def interrupt_login(_signal_number, _frame):
    raise InterruptedError


try:
    client = WebSocket(socket_path)
    if mode == "ready":
        raise SystemExit(0)

    initialize(client)

    if mode == "account":
        client.send_json(
            {"method": "account/rateLimits/read", "id": 1, "params": None}
        )
        client.send_json(
            {
                "method": "account/read",
                "id": 2,
                "params": {"refreshToken": False},
            }
        )
        pending = {1, 2}
        deadline = time.monotonic() + 15
        while pending:
            response = client.receive_json(deadline)
            response_id = response.get("id")
            if response_id in (0, 1, 2):
                print(json.dumps(response, separators=(",", ":")), flush=True)
            if response_id in pending:
                pending.remove(response_id)
    elif mode == "require-account":
        client.send_json(
            {
                "method": "account/read",
                "id": 2,
                "params": {"refreshToken": False},
            }
        )
        response = wait_for_response(client, 2, 15)
        if not account_is_available(response):
            print(
                "Codex is not authenticated for this worker account. "
                "Sign in before opening a terminal.",
                file=sys.stderr,
            )
            raise SystemExit(77)
    elif mode == "reset":
        if not (1 <= len(arguments) <= 2):
            raise RuntimeError("Invalid Codex reset request.")
        params = {"idempotencyKey": arguments[0]}
        if len(arguments) == 2:
            params["creditId"] = arguments[1]
        client.send_json(
            {
                "method": "account/rateLimitResetCredit/consume",
                "id": 2,
                "params": params,
            }
        )
        response = wait_for_response(client, 2, 30)
        print(json.dumps(response, separators=(",", ":")), flush=True)
        if "error" in response:
            raise SystemExit(1)
    elif mode == "login":
        signal.signal(signal.SIGINT, interrupt_login)
        signal.signal(signal.SIGTERM, interrupt_login)
        signal.signal(signal.SIGHUP, interrupt_login)
        client.send_json(
            {
                "method": "account/login/start",
                "id": 1,
                "params": {"type": "chatgptDeviceCode"},
            }
        )
        response = wait_for_response(client, 1, 30)
        result = response.get("result")
        if not isinstance(result, dict):
            print("Codex could not start device authorization.", file=sys.stderr)
            raise SystemExit(77)
        pending_login_id = result.get("loginId")
        verification_url = result.get("verificationUrl")
        user_code = result.get("userCode")
        if not all(
            isinstance(value, str) and value
            for value in (pending_login_id, verification_url, user_code)
        ):
            print("Codex returned an invalid device authorization.", file=sys.stderr)
            raise SystemExit(77)
        print(f"Open {verification_url}", flush=True)
        print(f"Enter this one-time code: {user_code}", flush=True)

        deadline = time.monotonic() + 15 * 60
        while True:
            notification = client.receive_json(deadline)
            if notification.get("method") != "account/login/completed":
                continue
            params = notification.get("params")
            if not isinstance(params, dict) or params.get("loginId") != pending_login_id:
                continue
            login_completed = True
            if params.get("success") is True:
                print("Codex sign-in complete.", flush=True)
                break
            print("Codex sign-in was not completed.", file=sys.stderr)
            raise SystemExit(77)
    else:
        raise RuntimeError("Unsupported Codex account operation.")
except InterruptedError:
    raise SystemExit(130)
except SystemExit:
    raise
except (
    AttributeError,
    EOFError,
    OSError,
    RuntimeError,
    TimeoutError,
    TypeError,
    ValueError,
    json.JSONDecodeError,
):
    print("Codex account service is unavailable.", file=sys.stderr)
    raise SystemExit(70)
finally:
    if client is not None:
        if pending_login_id is not None and not login_completed:
            try:
                client.send_json(
                    {
                        "method": "account/login/cancel",
                        "id": 99,
                        "params": {"loginId": pending_login_id},
                    }
                )
            except (OSError, RuntimeError):
                pass
        client.close()
PYTHON_CODEX_RPC
}

codex_app_server_ready() {
    [[ -S "$codex_app_server_socket" ]] \
        && run_codex_rpc ready >/dev/null 2>&1
}

lock_codex_app_server() {
    require_flock
    exec 3>"$runtime_directory/codex-app-server.lock"
    "$flock_path" 3
}

unlock_codex_app_server() {
    exec 3>&-
}

schedule_codex_app_server_restart() {
    lock_codex_app_server || return $?

    if [[ -e "$codex_app_server_restart_marker" \
        || -L "$codex_app_server_restart_marker" ]]; then
        if [[ ! -f "$codex_app_server_restart_marker" \
            || -L "$codex_app_server_restart_marker" ]]; then
            unlock_codex_app_server
            echo "Codex app-server restart marker is not a safe file." >&2
            return 78
        fi
    elif ! /usr/bin/touch "$codex_app_server_restart_marker"; then
        unlock_codex_app_server
        echo "Unable to schedule the shared Codex account service restart." >&2
        return 70
    fi

    if ! /bin/chmod 600 "$codex_app_server_restart_marker"; then
        unlock_codex_app_server
        echo "Unable to secure the Codex app-server restart marker." >&2
        return 70
    fi
    unlock_codex_app_server
}

ensure_codex_app_server_locked() {
    local launch_file
    local launch_command
    local attempt
    local restart_required=0

    [[ -x "$codex_path" ]] || {
        echo "Required Codex executable is unavailable: $codex_path" >&2
        return 69
    }
    [[ -x "$tmux_path" ]] || {
        echo "Required tmux executable is unavailable: $tmux_path" >&2
        return 69
    }

    if [[ -e "$codex_app_server_restart_marker" \
        || -L "$codex_app_server_restart_marker" ]]; then
        if [[ ! -f "$codex_app_server_restart_marker" \
            || -L "$codex_app_server_restart_marker" ]]; then
            echo "Codex app-server restart marker is not a safe file." >&2
            return 78
        fi
        restart_required=1
    fi

    if [[ $restart_required -eq 1 ]] && any_tool_session_exists codex; then
        if codex_app_server_ready; then
            return 0
        fi
        echo "The shared Codex account service cannot be restarted while Codex terminals are active." >&2
        return 70
    fi

    if [[ $restart_required -eq 0 ]] && codex_app_server_ready; then
        return 0
    fi

    if tmux_command has-session -t "$codex_app_server_session" 2>/dev/null; then
        tmux_command kill-session -t "$codex_app_server_session" 2>/dev/null || true
    fi
    if [[ -e "$codex_app_server_socket" || -L "$codex_app_server_socket" ]]; then
        /bin/rm -f -- "$codex_app_server_socket"
    fi

    launch_file="$runtime_directory/codex-app-server.launch.$$.$RANDOM"
    {
        printf '#!/bin/bash\n'
        printf '/bin/rm -f -- %q\n' "$launch_file"
        printf 'export PATH=%q\n' "$default_safe_path"
        printf 'exec %q app-server --listen %q\n' \
            "$codex_path" "unix://$codex_app_server_socket"
    } > "$launch_file"
    /bin/chmod 700 "$launch_file"
    printf -v launch_command '%q' "$launch_file"
    if ! tmux_command new-session -d -s "$codex_app_server_session" \
        -c "${runtime_home:-${HOME:-/}}" "$launch_command"; then
        /bin/rm -f -- "$launch_file"
        echo "Unable to start the shared Codex account service." >&2
        return 70
    fi
    configure_tmux || true

    for attempt in $(seq 1 100); do
        if [[ -S "$codex_app_server_socket" ]]; then
            break
        fi
        if ! tmux_command has-session -t "$codex_app_server_session" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    if ! codex_app_server_ready; then
        tmux_command kill-session -t "$codex_app_server_session" 2>/dev/null || true
        /bin/rm -f -- "$codex_app_server_socket"
        echo "The shared Codex account service did not become ready." >&2
        return 70
    fi

    if [[ $restart_required -eq 1 ]] \
        && ! /bin/rm -f -- "$codex_app_server_restart_marker"; then
        echo "The shared Codex account service restarted, but its restart marker could not be cleared." >&2
        return 70
    fi
}

reserve_codex_account_server() {
    local status=0

    lock_codex_app_server || return $?
    ensure_codex_app_server_locked || {
        status=$?
        unlock_codex_app_server
        return "$status"
    }
    run_codex_rpc require-account || {
        status=$?
        unlock_codex_app_server
        return "$status"
    }
}

run_codex_rpc_with_app_server_lock() {
    local mode="$1"
    shift
    local status=0

    lock_codex_app_server || return $?
    ensure_codex_app_server_locked || {
        status=$?
        unlock_codex_app_server
        return "$status"
    }
    run_codex_rpc "$mode" "$@" || status=$?
    unlock_codex_app_server
    return "$status"
}

pause_after_codex_reservation_for_test() {
    local pause_file

    [[ $test_mode -eq 1 \
        && -n "${TERMINAL_RELAY_TEST_PAUSE_AFTER_CODEX_RESERVATION:-}" ]] \
        || return 0
    pause_file="$TERMINAL_RELAY_TEST_PAUSE_AFTER_CODEX_RESERVATION"
    [[ "$pause_file" == /* && "$pause_file" != *$'\n'* ]] || return 78
    printf 'ready\n' > "$pause_file.ready"
    while [[ -e "$pause_file" ]]; do sleep 0.05; done
}

validate_tool() {
    case "$1" in
        codex|claude) ;;
        *) fail_usage "Unsupported tool: $1" ;;
    esac
}

is_valid_repository_name() {
    local repository="$1"
    [[ -n "$repository" \
        && ${#repository} -le 100 \
        && "$repository" != "." \
        && "$repository" != ".." \
        && "$repository" =~ ^[A-Za-z0-9._-]+$ ]]
}

is_valid_instance() {
    [[ "$1" =~ ^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$ ]]
}

is_valid_process_identity() {
    [[ "$1" =~ ^[A-Za-z0-9._:-]{1,160}$ ]]
}

project_directory_for() {
    local repository="$1"
    local project_directory

    if ! is_valid_repository_name "$repository"; then
