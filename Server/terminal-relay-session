prepare_claude_onboarding() {
    local home_directory="${runtime_home:-${HOME:-}}"
    local lock_file="$runtime_directory/claude-onboarding.lock"
    local status=0

    if [[ ! -x "$default_python_path" ]]; then
        echo "Required Python executable is unavailable: $default_python_path" >&2
        return 69
    fi
    if [[ "$home_directory" != /* || "$home_directory" == "/" \
        || "$home_directory" == *$'\n'* || ! -d "$home_directory" ]]; then
        echo "Unable to derive a safe Claude configuration home." >&2
        return 78
    fi

    if ! exec 4>"$lock_file"; then
        echo "Unable to open Claude onboarding lock: $lock_file" >&2
        return 70
    fi
    if ! "$flock_path" 4; then
        exec 4>&-
        echo "Unable to lock Claude onboarding state." >&2
        return 70
    fi
    "$default_python_path" - "$claude_path" "$home_directory" <<'PYTHON_CLAUDE_ONBOARDING' \
        || status=$?
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile

claude_path, home_text = sys.argv[1:]
home = Path(home_text)
config_path = home / ".claude.json"


def load_config():
    try:
        path_stat = config_path.lstat()
    except FileNotFoundError:
        return {}
    if stat.S_ISLNK(path_stat.st_mode) or not stat.S_ISREG(path_stat.st_mode):
        raise RuntimeError("Claude's global configuration is not a regular file.")
    if path_stat.st_uid != os.getuid():
        raise RuntimeError("Claude's global configuration belongs to another account.")
    with config_path.open(encoding="utf-8") as config_file:
        value = json.load(config_file)
    if not isinstance(value, dict):
        raise RuntimeError("Claude's global configuration is not a JSON object.")
    return value


try:
    config = load_config()
    if config.get("hasCompletedOnboarding") is True:
        raise SystemExit(0)

    auth_result = subprocess.run(
        [claude_path, "auth", "status", "--json"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=15,
        check=False,
    )
    try:
        auth_status = json.loads(auth_result.stdout)
    except json.JSONDecodeError:
        auth_status = {}
    if auth_result.returncode != 0 or auth_status.get("loggedIn") is not True:
        print(
            "Claude is not authenticated for this worker account. Sign in before opening a terminal.",
            file=sys.stderr,
        )
        raise SystemExit(77)

    config = load_config()
    if config.get("hasCompletedOnboarding") is True:
        raise SystemExit(0)
    config["hasCompletedOnboarding"] = True

    descriptor, temporary_name = tempfile.mkstemp(
        prefix=".claude.json.terminal-relay.",
        dir=home,
    )
    try:
        os.fchmod(descriptor, 0o600)
        writable_descriptor = descriptor
        descriptor = -1
        with os.fdopen(writable_descriptor, "w", encoding="utf-8") as temporary_file:
            json.dump(config, temporary_file, ensure_ascii=False, indent=2)
            temporary_file.write("\n")
            temporary_file.flush()
            os.fsync(temporary_file.fileno())
        os.replace(temporary_name, config_path)
        directory_descriptor = os.open(home, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
    print(f"Unable to prepare Claude's interactive account state: {error}", file=sys.stderr)
    raise SystemExit(78)
PYTHON_CLAUDE_ONBOARDING
    exec 4>&-
    return "$status"
}

