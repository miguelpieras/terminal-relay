    case "$archive_filter" in
        active) run_codex_rpc_with_app_server_lock threads "$project_directory" 0 "$cursor" ;;
        archived) run_codex_rpc_with_app_server_lock threads "$project_directory" 1 "$cursor" ;;
        *) fail_usage "threads requires an active or archived filter." ;;
