    lock_tool_control "$tool"
    lock_tool_metadata "$tool"
    if load_metadata_unlocked "$tool"; then
        metadata_present=1
    fi

    if [[ $metadata_present -eq 1 ]] && session_exists "$tool" "$metadata_instance"; then
        if [[ "$metadata_repository" != "$repository" ]]; then
            active_repository="$metadata_repository"
            unlock_tool_metadata
            unlock_tool_control
            echo "A $tool session is already running for repository '$active_repository'; requested '$repository'." >&2
            exit 75
        fi
        instance="$metadata_instance"
        session_name="$(session_name_for "$tool" "$instance")"
        unlock_tool_metadata
    else
        if any_tool_session_exists "$tool"; then
            active_repository="${metadata_repository:-unknown}"
            unlock_tool_metadata
            unlock_tool_control
            echo "A $tool tmux session is already running with inconsistent launch metadata for repository '$active_repository'." >&2
            exit 75
        fi
        if [[ $metadata_present -eq 1 ]] && metadata_launch_is_running "$tool"; then
            active_repository="$metadata_repository"
            active_instance="$metadata_instance"
            unlock_tool_metadata
            unlock_tool_control
            echo "A $tool launch '$active_instance' for repository '$active_repository' is still running without an attachable tmux session." >&2
            exit 75
        fi

        remove_metadata_unlocked "$tool"
        intent_status=0
        clear_same_boot_stale_intent_unlocked "$tool" "$boot_id" || intent_status=$?
        if [[ $intent_status -ne 0 ]]; then
            unlock_tool_metadata
            unlock_tool_control
            exit "$intent_status"
        fi
        instance="$(generate_instance)" || {
            unlock_tool_metadata
            unlock_tool_control
            echo "Unable to generate a launch instance token." >&2
            exit 70
        }
        write_metadata_unlocked "$tool" "$repository" "$instance" 0 pending
        if ! write_intent_unlocked "$tool" "$repository" "$instance" "$boot_id" "$@"; then
            remove_metadata_unlocked "$tool"
            unlock_tool_metadata
            unlock_tool_control
            echo "Unable to persist the $tool restart intent." >&2
            exit 70
        fi
        session_name="$(session_name_for "$tool" "$instance")"
        unlock_tool_metadata

        launch_file="$runtime_directory/$tool.launch.$$.$RANDOM"
        write_launch_script "$launch_file" "$tool" "$repository" "$instance" initial "$@"
        printf -v launch_command '%q' "$launch_file"
        if ! tmux_command new-session -d -s "$session_name" -c "$project_directory" "$launch_command"; then
            /bin/rm -f -- "$launch_file"
            lock_tool_metadata "$tool"
            if load_metadata_unlocked "$tool" && [[ "$metadata_instance" == "$instance" ]]; then
                remove_metadata_unlocked "$tool"
            fi
            remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
            unlock_tool_metadata
            unlock_tool_control
            echo "Unable to start the $tool tmux session." >&2
            exit 70
        fi
        created_session=1
    fi

    if ! configure_tmux; then
        if [[ $created_session -eq 1 ]]; then
            terminate_launch "$tool" "$repository" "$instance" || true
            lock_tool_metadata "$tool"
            remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
            unlock_tool_metadata
        fi
        unlock_tool_control
        echo "Unable to configure tmux for the $tool launch." >&2
        exit 70
    fi
    if ! attached_client_count="$(tmux_command display-message -p -t "$session_name" '#{session_attached}' 2>/dev/null)" \
        || [[ ! "$attached_client_count" =~ ^[0-9]+$ ]]; then
        unlock_tool_control
        echo "The $tool tmux session ended before start completed." >&2
        exit 75
    fi

    unlock_tool_control
    printf '%s\n' "$protocol_marker"
    printf 'session|%s|%s|%s|%s\n' \
        "$tool" "$repository" "$attached_client_count" "$instance"
}

