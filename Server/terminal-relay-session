)
if (
    value.get("status") != "ready"
    or value.get("provider") != sys.argv[2]
    or value.get("repository") != sys.argv[3]
    or not pattern.fullmatch(str(value.get("providerThreadId", "")))
    or not pattern.fullmatch(str(value.get("relayId", "")))
):
    raise SystemExit(75)
print("{}|{}|chat".format(value["providerThreadId"], value["relayId"]))
PYTHON_CHAT_BINDING
)" || continue
        IFS='|' read -r chat_thread_id chat_relay_id chat_presentation <<< "$chat_fields"
        tmux_command has-session \
            -t "$(chat_session_name_for "$requested_provider" "$chat_relay_id")" \
            2>/dev/null || continue
