run_chat_broker() {
    local provider="$1"
    shift

    if [[ ! -f "$chat_path" || -L "$chat_path" || ! -r "$chat_path" ]]; then
        echo "Structured chat is unavailable." >&2
        return 69
    fi
    case "$provider" in
        codex)
            [[ -x "$default_python_path" ]] || {
                echo "Structured Codex chat is unavailable." >&2
                return 69
            }
            if [[ $test_mode -eq 1 \
                && "${TERMINAL_RELAY_TEST_CHAT_FAKE:-0}" == "1" ]]; then
                TERMINAL_RELAY_CHAT_TEST_MODE=1 \
                    "$default_python_path" "$chat_path" "$@"
            else
                "$default_python_path" "$chat_path" "$@"
            fi
            ;;
        claude)
            [[ -x "$claude_sessions_python_path" ]] || {
                echo "Structured Claude chat is unavailable." >&2
                return 69
            }
            if [[ $test_mode -eq 1 \
                && "${TERMINAL_RELAY_TEST_CHAT_FAKE:-0}" == "1" ]]; then
                TERMINAL_RELAY_CHAT_TEST_MODE=1 \
                    "$claude_sessions_python_path" "$chat_path" "$@"
            else
                "$claude_sessions_python_path" "$chat_path" "$@"
            fi
            ;;
        *) return 64 ;;
    esac
}

chat_session_name_for() {
    printf 'terminal-relay-chat-%s-%s\n' "$1" "$2"
}

chat_intent_file_for() {
    printf '%s/%s.chat-intent\n' "$runtime_directory" "$1"
}

write_chat_intent() {
    local provider="$1"
    local repository="$2"
    local relay_id="$3"
    local provider_thread_id="$4"
    local boot_id="$5"
    shift 5
    local path
    local temporary
    local argument

    validate_tool "$provider"
    is_valid_repository_name "$repository" || return 64
    is_valid_instance "$relay_id" || return 64
    is_valid_instance "$provider_thread_id" || return 64
    is_valid_boot_id "$boot_id" || return 64
    validate_launch_arguments "$provider" "$@" || return $?
    path="$(chat_intent_file_for "$relay_id")"
    [[ ! -L "$path" ]] || return 70
    temporary="$path.$$.$RANDOM.tmp"
    {
        printf 'version|1\nprovider|%s\nrepository|%s\nrelay|%s\nthread|%s\nboot|%s\nargc|%s\n' \
            "$provider" "$repository" "$relay_id" "$provider_thread_id" "$boot_id" "$#"
        for argument in "$@"; do
            printf 'arg|%s\n' "$(encode_argument_hex "$argument")"
        done
    } > "$temporary"
    /bin/chmod 600 "$temporary"
    /bin/mv -f -- "$temporary" "$path"
}

load_chat_intent() {
    local path="$1"
    local key
    local value
    local extra
    local declared_argc=""
    local argument_count=0
    local identity
    local seen_version=0
    local seen_provider=0
    local seen_repository=0
    local seen_relay=0
    local seen_thread=0
    local seen_boot=0
    local seen_argc=0

    chat_intent_provider=""
    chat_intent_repository=""
    chat_intent_relay_id=""
    chat_intent_thread_id=""
    chat_intent_boot_id=""
    chat_intent_arguments=()
    [[ -f "$path" && ! -L "$path" ]] || return 1
    identity="$(path_uid_mode "$path")" || return 2
    [[ "$identity" == "$user_id:600" ]] || return 2
    while IFS='|' read -r key value extra; do
        [[ -z "${extra:-}" ]] || return 2
        case "$key" in
            version)
                [[ $seen_version -eq 0 && "$value" == "1" ]] || return 2
                seen_version=1
                ;;
            provider)
                [[ $seen_provider -eq 0 ]] || return 2
                chat_intent_provider="$value"
                seen_provider=1
                ;;
            repository)
                [[ $seen_repository -eq 0 ]] || return 2
                chat_intent_repository="$value"
                seen_repository=1
                ;;
            relay)
                [[ $seen_relay -eq 0 ]] || return 2
                chat_intent_relay_id="$value"
                seen_relay=1
                ;;
            thread)
                [[ $seen_thread -eq 0 ]] || return 2
                chat_intent_thread_id="$value"
                seen_thread=1
                ;;
            boot)
                [[ $seen_boot -eq 0 ]] || return 2
                chat_intent_boot_id="$value"
                seen_boot=1
                ;;
            argc)
                [[ $seen_argc -eq 0 ]] || return 2
                [[ "$value" =~ ^(0|[1-9][0-9]*)$ && $value -le 64 ]] || return 2
                declared_argc="$value"
                seen_argc=1
                ;;
            arg)
                [[ -n "$declared_argc" && $argument_count -lt "$declared_argc" ]] \
                    || return 2
                decode_argument_hex "$value" || return 2
                chat_intent_arguments+=("$decoded_argument")
                argument_count=$((argument_count + 1))
                ;;
            *) return 2 ;;
        esac
    done < "$path"
    [[ $seen_version -eq 1 \
        && $seen_provider -eq 1 \
        && $seen_repository -eq 1 \
        && $seen_relay -eq 1 \
        && $seen_thread -eq 1 \
        && $seen_boot -eq 1 \
        && $seen_argc -eq 1 ]] || return 2
    validate_tool "$chat_intent_provider"
    is_valid_repository_name "$chat_intent_repository" || return 2
    is_valid_instance "$chat_intent_relay_id" || return 2
    is_valid_instance "$chat_intent_thread_id" || return 2
    is_valid_boot_id "$chat_intent_boot_id" || return 2
    [[ -n "$declared_argc" && "$argument_count" == "$declared_argc" ]] || return 2
    if [[ $argument_count -gt 0 ]]; then
        validate_launch_arguments \
            "$chat_intent_provider" "${chat_intent_arguments[@]}" >/dev/null || return 2
    else
        validate_launch_arguments "$chat_intent_provider" >/dev/null || return 2
    fi
}

chat_capability_json() {
    local provider="$1"
    local raw
    local readiness_status=0

    validate_tool "$provider"
    if [[ "$provider" == "codex" ]] \
        && ! [[ $test_mode -eq 1 && "${TERMINAL_RELAY_TEST_CHAT_FAKE:-0}" == "1" ]]; then
        lock_codex_app_server || return $?
        ensure_codex_app_server_locked || {
            readiness_status=$?
            unlock_codex_app_server
            return "$readiness_status"
        }
        unlock_codex_app_server
    fi
    local -a ready_arguments=(
        ready
        --provider "$provider"
        --codex-socket "$codex_app_server_socket"
    )
    if [[ $test_mode -eq 1 && "${TERMINAL_RELAY_TEST_CHAT_FAKE:-0}" == "1" ]]; then
        ready_arguments+=(--fake)
    fi
    raw="$(run_chat_broker "$provider" "${ready_arguments[@]}")" || return $?
    "$default_python_path" - "$provider" "$raw" <<'PYTHON_CHAT_CAPABILITY'
import json
import sys

provider = sys.argv[1]
try:
    capabilities = json.loads(sys.argv[2])
except (OSError, ValueError):
    raise SystemExit(70)
required = {
    "protocolVersion",
    "features",
    "supportsHistory",
    "supportsFilePreview",
    "supportsApprovals",
    "supportsQuestions",
    "supportsAttachments",
}
if (
    not isinstance(capabilities, dict)
    or set(capabilities) != required
    or capabilities["protocolVersion"] != 1
    or not isinstance(capabilities["features"], list)
    or any(not isinstance(value, bool) for key, value in capabilities.items()
           if key.startswith("supports"))
):
    raise SystemExit(70)
print(json.dumps({
    "provider": provider,
    "available": True,
    "capabilities": capabilities,
    "reason": None,
}, separators=(",", ":")))
PYTHON_CHAT_CAPABILITY
}

chat_capabilities_v1() {
    local provider="$1"
    local repository="$2"
    local output
    local status=0

    validate_tool "$provider"
    project_directory_for "$repository" >/dev/null || return $?
    if output="$(chat_capability_json "$provider")"; then
        :
    else
        status=$?
        output="$("$default_python_path" - "$provider" <<'PYTHON_CHAT_UNAVAILABLE'
import json
import sys
print(json.dumps({
    "provider": sys.argv[1],
    "available": False,
    "capabilities": None,
    "reason": "providerUnavailable",
}, separators=(",", ":")))
PYTHON_CHAT_UNAVAILABLE
)"
    fi
    printf '%s\n%s\n' "$chat_protocol_marker" "$output"
    return 0
}

chat_start_v1() {
    local provider="$1"
    local repository="$2"
    shift 2
    local project_directory
    local provider_thread_id=""
    local relay_id
    local session_name
    local launch_file
    local launch_command
    local capability_wrapper
    local capability_json
    local state_json=""
    local attempt
    local status=0
    local new_thread=0
    local argument
    local boot_id

    validate_tool "$provider"
    if [[ $# -gt 0 ]] && is_valid_instance "$1"; then
        provider_thread_id="$1"
        shift
    fi
    validate_launch_arguments "$provider" "$@" || return $?
    boot_id="$(current_boot_id)" || {
        echo "Unable to read the worker boot identity from $boot_id_path." >&2
        return 69
    }
    project_directory="$(project_directory_for "$repository")" || return $?
    [[ -x "$tmux_path" ]] || {
        echo "Required tmux executable is unavailable: $tmux_path" >&2
        return 69
    }
    require_flock
    if [[ -n "$provider_thread_id" ]] && thread_is_active "$provider" "$provider_thread_id"; then
        echo "The requested provider conversation is already active." >&2
        return 75
    fi
    if [[ "$provider" == "claude" && -z "$provider_thread_id" ]]; then
        provider_thread_id="$(generate_instance)" || return 70
        new_thread=1
    fi
    if [[ "$provider" == "claude" ]]; then
        prepare_claude_onboarding || return $?
    fi
    capability_wrapper="$(chat_capability_json "$provider")" || return $?
    capability_json="$(printf '%s\n' "$capability_wrapper" \
        | "$default_python_path" -c 'import json,sys; print(json.dumps(json.load(sys.stdin)["capabilities"],separators=(",",":")))')" \
        || return 70
    relay_id="${requested_chat_relay_id:-}"
    if [[ -z "$relay_id" ]]; then
        relay_id="$(generate_instance)" || return 70
    else
        is_valid_instance "$relay_id" || return 70
    fi
    session_name="$(chat_session_name_for "$provider" "$relay_id")"
    launch_file="$runtime_directory/$relay_id.chat-launch.$$.$RANDOM"
    {
        printf '#!/bin/bash\n'
        printf '/bin/rm -f -- %q\n' "$launch_file"
        printf 'export PATH=%q\n' "$default_safe_path"
        if [[ $test_mode -eq 1 && "${TERMINAL_RELAY_TEST_CHAT_FAKE:-0}" == "1" ]]; then
            printf 'export TERMINAL_RELAY_CHAT_TEST_MODE=1\n'
        fi
        if [[ "$provider" == "claude" ]]; then
            printf 'exec %q %q serve' "$claude_sessions_python_path" "$chat_path"
        else
            printf 'exec %q %q serve' "$default_python_path" "$chat_path"
        fi
        printf ' --provider %q --repository %q --project-directory %q --runtime-directory %q --relay-id %q' \
            "$provider" "$repository" "$project_directory" "$runtime_directory" "$relay_id"
        if [[ -n "$provider_thread_id" ]]; then
            printf ' --thread-id %q' "$provider_thread_id"
        fi
        if [[ $new_thread -eq 1 ]]; then
            printf ' --new-thread'
        fi
        printf ' --codex-socket %q' "$codex_app_server_socket"
        for argument in "$@"; do
            printf ' --launch-argument %q' "$argument"
        done
        if [[ $test_mode -eq 1 && "${TERMINAL_RELAY_TEST_CHAT_FAKE:-0}" == "1" ]]; then
            printf ' --fake'
        fi
        printf '\n'
    } > "$launch_file"
    /bin/chmod 700 "$launch_file"
    printf -v launch_command '%q' "$launch_file"
    if ! tmux_command new-session -d -s "$session_name" \
        -c "$project_directory" "$launch_command"; then
        /bin/rm -f -- "$launch_file"
        echo "Unable to start structured chat." >&2
        return 70
    fi
    for attempt in $(seq 1 160); do
        if state_json="$(run_chat_broker "$provider" inspect \
            --runtime-directory "$runtime_directory" \
            --relay-id "$relay_id" 2>/dev/null)"; then
            break
        fi
        if ! tmux_command has-session -t "$session_name" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    if [[ -z "$state_json" ]]; then
        tmux_command kill-session -t "$session_name" 2>/dev/null || true
        echo "Structured chat did not become ready." >&2
        return 70
    fi
    provider_thread_id="$(printf '%s\n' "$state_json" \
        | "$default_python_path" -c \
            'import json,sys; value=json.load(sys.stdin); print(value.get("providerThreadId",""))')" \
        || return 70
    is_valid_instance "$provider_thread_id" || {
        tmux_command kill-session -t "$session_name" 2>/dev/null || true
        echo "Structured chat returned an invalid provider conversation." >&2
        return 70
    }
    if ! write_chat_intent \
        "$provider" "$repository" "$relay_id" "$provider_thread_id" "$boot_id" "$@"; then
        run_chat_broker "$provider" stop \
            --runtime-directory "$runtime_directory" \
            --relay-id "$relay_id" \
            --provider "$provider" \
            --repository "$repository" >/dev/null 2>&1 || true
        echo "Unable to persist the structured chat restart intent." >&2
        return 70
    fi
    printf '%s\n' "$chat_protocol_marker"
    "$default_python_path" - "$provider" "$relay_id" \
        "$capability_json" "$state_json" <<'PYTHON_CHAT_START'
import json
import sys

provider, relay_id, capability_text, state_text = sys.argv[1:]
try:
    state = json.loads(state_text)
    capabilities = json.loads(capability_text)
except ValueError:
    raise SystemExit(70)
thread_id = state.get("providerThreadId")
if (
    state.get("status") != "ready"
    or state.get("provider") != provider
    or state.get("relayId") != relay_id
    or not isinstance(thread_id, str)
):
    raise SystemExit(70)
print(json.dumps({
    "relayId": relay_id,
    "provider": provider,
    "providerThreadId": thread_id,
    "capabilities": capabilities,
    "launchOptions": state.get("launchOptions", {}),
}, separators=(",", ":")))
PYTHON_CHAT_START
}

chat_attach_v1() {
    local provider="$1"
    local repository="$2"
    local relay_id="$3"

    validate_tool "$provider"
    is_valid_repository_name "$repository" \
        || fail_usage "Invalid chat repository: $repository"
    is_valid_instance "$relay_id" || fail_usage "Invalid chat relay identifier."
    project_directory_for "$repository" >/dev/null || return $?
    if [[ "$provider" == "claude" ]]; then
        exec "$claude_sessions_python_path" "$chat_path" attach \
            --runtime-directory "$runtime_directory" \
            --relay-id "$relay_id" \
            --provider "$provider" \
            --repository "$repository"
    fi
    exec "$default_python_path" "$chat_path" attach \
        --runtime-directory "$runtime_directory" \
        --relay-id "$relay_id" \
        --provider "$provider" \
        --repository "$repository"
}

chat_stop_v1() {
    local provider="$1"
    local repository="$2"
    local relay_id="$3"
    local session_name
    local attempt

    validate_tool "$provider"
    is_valid_repository_name "$repository" \
        || fail_usage "Invalid chat repository: $repository"
    is_valid_instance "$relay_id" || fail_usage "Invalid chat relay identifier."
    project_directory_for "$repository" >/dev/null || return $?
    run_chat_broker "$provider" stop \
        --runtime-directory "$runtime_directory" \
        --relay-id "$relay_id" \
        --provider "$provider" \
        --repository "$repository" || return $?
    session_name="$(chat_session_name_for "$provider" "$relay_id")"
    for attempt in $(seq 1 100); do
        if ! tmux_command has-session -t "$session_name" 2>/dev/null; then
            /bin/rm -f -- "$(chat_intent_file_for "$relay_id")"
            return 0
        fi
        sleep 0.05
    done
    echo "Structured chat did not stop cleanly." >&2
    return 70
}

require_flock() {
    if [[ ! -x "$flock_path" ]]; then
        echo "Required flock executable is unavailable: $flock_path" >&2
        exit 69
    fi
}

lock_provider_session() {
    local provider="$1"
    local thread_id="$2"
    local lock_file

    validate_tool "$provider"
    is_valid_instance "$thread_id" || return 64
    require_flock
    lock_file="$(provider_session_lock_file_for "$provider" "$thread_id")"
    if [[ -L "$lock_file" ]]; then
        echo "The provider session lock is invalid." >&2
        return 70
    fi
    exec 5>"$lock_file"
    if ! "$flock_path" --nonblock 5; then
        exec 5>&-
        echo "The requested provider session is already being managed." >&2
        return 75
    fi
}

unlock_provider_session() {
    exec 5>&-
}

lock_tool_control() {
    local lock_file
    require_flock
    lock_file="$(control_lock_file_for "$1")"
    exec 8>"$lock_file"
    "$flock_path" 8
}

unlock_tool_control() {
    exec 8>&-
}

lock_tool_metadata() {
    local lock_file
    require_flock
    lock_file="$(metadata_lock_file_for "$1")"
    exec 6>"$lock_file"
    "$flock_path" 6
}

unlock_tool_metadata() {
    exec 6>&-
}

session_exists() {
    local session_name
    session_name="$(session_name_for "$1" "$2")"
    tmux_command has-session -t "$session_name" 2>/dev/null
}

any_tool_session_exists() {
    tmux_command list-sessions -F '#{session_name}' 2>/dev/null \
        | /usr/bin/grep -Eq "^terminal-relay-($1($|-)|chat-$1-)"
}

load_metadata_unlocked() {
    local tool="$1"
    local instance="$2"
    local metadata_file
    local key
    local value
    local extra
    local tool_seen=0
    local repository_seen=0
    local instance_seen=0
    local pid_seen=0
    local start_seen=0
    local thread_seen=0

    metadata_tool=""
    metadata_repository=""
    metadata_instance=""
    metadata_pid=""
    metadata_start=""
    metadata_thread_id=""
    metadata_file="$(metadata_file_for "$instance")"
    [[ -f "$metadata_file" && ! -L "$metadata_file" ]] || return 1

    while IFS='|' read -r key value extra; do
        [[ -z "${extra:-}" ]] || return 1
        case "$key" in
            tool)
                [[ $tool_seen -eq 0 ]] || return 1
                metadata_tool="$value"
                tool_seen=1
                ;;
            repository)
                [[ $repository_seen -eq 0 ]] || return 1
                metadata_repository="$value"
                repository_seen=1
                ;;
            instance)
                [[ $instance_seen -eq 0 ]] || return 1
                metadata_instance="$value"
                instance_seen=1
                ;;
            pid)
                [[ $pid_seen -eq 0 ]] || return 1
                metadata_pid="$value"
                pid_seen=1
                ;;
            start)
                [[ $start_seen -eq 0 ]] || return 1
                metadata_start="$value"
                start_seen=1
                ;;
            thread)
                [[ $thread_seen -eq 0 ]] || return 1
                metadata_thread_id="$value"
                thread_seen=1
                ;;
            *) return 1 ;;
        esac
    done < "$metadata_file"

    [[ $tool_seen -eq 1 \
        && $repository_seen -eq 1 \
        && $instance_seen -eq 1 \
        && $pid_seen -eq 1 \
        && $start_seen -eq 1 ]] || return 1
    [[ "$metadata_tool" == "$tool" ]] || return 1
    is_valid_repository_name "$metadata_repository" || return 1
    is_valid_instance "$metadata_instance" || return 1
    [[ "$metadata_instance" == "$instance" ]] || return 1
    [[ "$metadata_pid" =~ ^(0|[1-9][0-9]*)$ ]] || return 1
    if [[ "$metadata_pid" == "0" ]]; then
        [[ "$metadata_start" == "pending" ]] || return 1
    else
        is_valid_process_identity "$metadata_start" || return 1
    fi
    [[ -z "$metadata_thread_id" ]] || is_valid_instance "$metadata_thread_id" || return 1
}

write_metadata_unlocked() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local pid="$4"
    local start="$5"
    local thread_id="${6:-}"
    local metadata_file
    local temporary_file

    metadata_file="$(metadata_file_for "$instance")"
    temporary_file="$metadata_file.$$.$RANDOM.tmp"
    [[ -z "$thread_id" ]] || is_valid_instance "$thread_id" || return 70
    printf 'tool|%s\nrepository|%s\ninstance|%s\npid|%s\nstart|%s\nthread|%s\n' \
        "$tool" "$repository" "$instance" "$pid" "$start" "$thread_id" > "$temporary_file"
    /bin/chmod 600 "$temporary_file"
    /bin/mv -f "$temporary_file" "$metadata_file"
}

remove_metadata_unlocked() {
    local metadata_file
    metadata_file="$(metadata_file_for "$1")"
    /bin/rm -f -- "$metadata_file"
}

path_uid_mode() {
    local path="$1"
    local result

    if result="$(/usr/bin/stat -c '%u:%a' "$path" 2>/dev/null)"; then
        printf '%s\n' "$result"
        return 0
    fi
    result="$(/usr/bin/stat -f '%u:%Lp' "$path" 2>/dev/null)" || return 1
    printf '%s\n' "$result"
}

is_valid_boot_id() {
    [[ "$1" =~ ^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$ ]]
}

current_boot_id() {
    local boot_id
    [[ -f "$boot_id_path" && ! -L "$boot_id_path" ]] || return 1
    IFS= read -r boot_id < "$boot_id_path" || return 1
    is_valid_boot_id "$boot_id" || return 1
    printf '%s\n' "$boot_id"
}

validate_launch_arguments() {
    local tool="$1"
    shift
    local argument
    local argument_bytes
    local total_bytes=0

    [[ $# -le 64 ]] || {
        echo "Too many $tool launch arguments to persist safely." >&2
        return 64
    }
    for argument in "$@"; do
        argument_bytes="$(printf '%s' "$argument" | /usr/bin/wc -c | /usr/bin/tr -d '[:space:]')"
        [[ "$argument_bytes" =~ ^[0-9]+$ && $argument_bytes -le 4096 ]] || {
            echo "A $tool launch argument is too large to persist safely." >&2
            return 64
        }
        total_bytes=$((total_bytes + argument_bytes))
        [[ $total_bytes -le 32768 ]] || {
            echo "The $tool launch arguments are too large to persist safely." >&2
            return 64
        }
        case "$tool:$argument" in
            codex:resume|codex:--last|codex:--include-non-interactive \
                |codex:--remote|codex:--remote=* \
                |codex:--remote-auth-token-env|codex:--remote-auth-token-env=*)
                echo "Terminal Relay manages Codex resume arguments itself: $argument" >&2
                return 64
                ;;
            claude:-c|claude:--continue|claude:-r|claude:--resume|claude:--resume=* \
                |claude:--session-id|claude:--session-id=*|claude:--fork-session|claude:--from-pr \
                |claude:--from-pr=*)
                echo "Terminal Relay manages Claude session arguments itself: $argument" >&2
                return 64
                ;;
        esac
    done
}

build_claude_resume_arguments() {
    local argument
    local skip_value=0

    claude_resume_arguments_result=()
    for argument in "$@"; do
        if [[ $skip_value -eq 1 ]]; then
            skip_value=0
            continue
        fi
        case "$argument" in
            --model|--effort)
                skip_value=1
                ;;
            --model=*|--effort=*)
                ;;
            *)
                claude_resume_arguments_result+=("$argument")
                ;;
        esac
    done
    if [[ ${#claude_resume_arguments_result[@]} -gt 0 ]]; then
        validate_launch_arguments claude "${claude_resume_arguments_result[@]}"
    else
        validate_launch_arguments claude
    fi
}

encode_argument_hex() {
    printf '%s' "$1" | /usr/bin/od -An -v -tx1 | /usr/bin/tr -d ' \n'
}

decode_argument_hex() {
    local encoded="$1"
    local escaped

    [[ ${#encoded} -le 8192 && $(( ${#encoded} % 2 )) -eq 0 \
        && "$encoded" =~ ^([a-f0-9]{2})*$ ]] || return 1
    [[ ! "$encoded" =~ ^([a-f0-9]{2})*00 ]] || return 1
    escaped="$(printf '%s' "$encoded" | /usr/bin/sed 's/../\\x&/g')"
    printf -v decoded_argument '%b' "$escaped"
}

load_intent_path_unlocked() {
    local tool="$1"
    local intent_file="$2"
    local key
    local value
    local extra
    local file_identity
    local version_seen=0
    local tool_seen=0
    local repository_seen=0
    local instance_seen=0
    local boot_seen=0
    local argc_seen=0
    local thread_seen=0
    local intent_version=""
    local declared_argc=""
    local argument_count=0

    intent_repository=""
    intent_instance=""
    intent_boot_id=""
    intent_thread_id=""
    intent_arguments=()

    [[ -f "$intent_file" && ! -L "$intent_file" ]] || return 1
    file_identity="$(path_uid_mode "$intent_file")" || return 2
    [[ "$file_identity" == "$user_id:600" ]] || return 2

    while IFS='|' read -r key value extra; do
        [[ -z "${extra:-}" ]] || return 2
        case "$key" in
            version)
                [[ $version_seen -eq 0 && "$value" =~ ^(1|2)$ ]] || return 2
                intent_version="$value"
                version_seen=1
                ;;
            tool)
                [[ $tool_seen -eq 0 && "$value" == "$tool" ]] || return 2
                tool_seen=1
                ;;
            repository)
                [[ $repository_seen -eq 0 ]] || return 2
                intent_repository="$value"
                repository_seen=1
                ;;
            instance)
                [[ $instance_seen -eq 0 ]] || return 2
                intent_instance="$value"
                instance_seen=1
                ;;
            boot)
                [[ $boot_seen -eq 0 ]] || return 2
                intent_boot_id="$value"
                boot_seen=1
                ;;
            thread)
                [[ $thread_seen -eq 0 ]] || return 2
                intent_thread_id="$value"
                thread_seen=1
                ;;
            argc)
                [[ $argc_seen -eq 0 && "$value" =~ ^(0|[1-9][0-9]*)$ \
                    && $value -le 64 ]] || return 2
                declared_argc="$value"
                argc_seen=1
                ;;
            arg)
                [[ $argc_seen -eq 1 && $argument_count -lt 64 ]] || return 2
                decode_argument_hex "$value" || return 2
                intent_arguments+=("$decoded_argument")
                argument_count=$((argument_count + 1))
                ;;
            *) return 2 ;;
        esac
    done < "$intent_file"

    [[ $version_seen -eq 1 && $tool_seen -eq 1 && $repository_seen -eq 1 \
        && $instance_seen -eq 1 && $boot_seen -eq 1 && $argc_seen -eq 1 \
        && "$argument_count" == "$declared_argc" ]] || return 2
    if [[ "$intent_version" == "2" ]]; then
        [[ $thread_seen -eq 1 ]] || return 2
    else
        [[ $thread_seen -eq 0 ]] || return 2
    fi
    is_valid_repository_name "$intent_repository" || return 2
    is_valid_instance "$intent_instance" || return 2
    is_valid_boot_id "$intent_boot_id" || return 2
    [[ -z "$intent_thread_id" ]] || is_valid_instance "$intent_thread_id" || return 2
    validate_launch_arguments "$tool" "${intent_arguments[@]}" >/dev/null || return 2
}

load_intent_unlocked() {
    load_intent_path_unlocked "$1" "$(intent_file_for "$2")"
}

write_intent_unlocked() {
