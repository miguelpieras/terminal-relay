        lock_tool_metadata "$instance"
        remove_metadata_unlocked "$instance"
        remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
        unlock_tool_metadata
        if [[ $codex_app_server_reserved -eq 1 ]]; then
            unlock_codex_app_server
        fi
        unlock_tool_control
        echo "Unable to start the $tool tmux session." >&2
        exit 70
    fi
    if [[ $codex_app_server_reserved -eq 1 ]]; then
        unlock_codex_app_server
    fi
    if ! configure_tmux; then
        terminate_launch "$tool" "$repository" "$instance" || true
        lock_tool_metadata "$instance"
        remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
        unlock_tool_metadata
        unlock_tool_control
        echo "Unable to configure tmux for the $tool launch." >&2
        exit 70
    fi
    if ! attached_client_count="$(tmux_command display-message -p -t "$session_name" \
        '#{session_attached}' 2>/dev/null)" \
        || [[ ! "$attached_client_count" =~ ^[0-9]+$ ]]; then
        unlock_tool_control
        echo "The $tool tmux session ended before start completed." >&2
        exit 75
    fi
    unlock_tool_control

    if ! session_display_fields \
        "$tool" "$instance" "$repository" "$provider_thread_id"; then
        session_activity=0
        session_title_hex=""
        session_working=""
        session_thread_id=""
    fi
    if [[ -z "$session_thread_id" && -n "$provider_thread_id" ]]; then
        session_thread_id="$provider_thread_id"
    fi
    printf '%s\n' "$protocol_marker"
    printf 'session|%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "$tool" "$repository" "$attached_client_count" "$instance" \
        "$session_activity" "$session_title_hex" "$session_working" "$session_thread_id"
    if [[ $provider_session_lock_acquired -eq 1 ]]; then
        unlock_provider_session
    fi
}

resume_codex_thread() {
    local repository="$1"
    local thread_id="$2"
    shift 2

    validate_thread_id "$thread_id"
    thread_is_active codex "$thread_id" && {
        echo "The requested Codex thread is already active." >&2
        return 75
    }
    codex_thread_read "$repository" "$thread_id" >/dev/null || return $?
    requested_provider_thread_id="$thread_id"
    requested_launch_mode=resume
    start_instance_session codex "$repository" "$@"
}

resume_provider_thread_v2() {
    local provider="$1"
    local repository="$2"
    local thread_id="$3"
    shift 3
    local archive_directory
    local project_directory
    local start_status

    validate_tool "$provider"
    validate_thread_id "$thread_id"
    project_directory="$(project_directory_for "$repository")" || return $?
    lock_provider_session "$provider" "$thread_id" || return $?
    case "$provider" in
        codex)
            if thread_is_active codex "$thread_id"; then
                unlock_provider_session
                echo "The requested Codex thread is already active." >&2
                return 75
            fi
            codex_thread_read "$repository" "$thread_id" >/dev/null || {
                start_status=$?
                unlock_provider_session
                return "$start_status"
            }
            ;;
        claude)
            archive_directory="$(claude_archive_directory_for "$repository")" || {
                start_status=$?
                unlock_provider_session
                return "$start_status"
            }
            require_inactive_claude_thread \
                "$project_directory" "$archive_directory" "$thread_id" || {
                start_status=$?
                unlock_provider_session
                return "$start_status"
            }
            if [[ "$claude_thread_archived" == "1" ]]; then
                unlock_provider_session
                echo "Archived Claude sessions must be restored before resuming." >&2
                return 75
            fi
            build_claude_resume_arguments "$@" || {
                start_status=$?
                unlock_provider_session
                return "$start_status"
            }
            if [[ ${#claude_resume_arguments_result[@]} -gt 0 ]]; then
                set -- "${claude_resume_arguments_result[@]}"
            else
                set --
            fi
            ;;
    esac
    requested_provider_thread_id="$thread_id"
    requested_launch_mode=resume
    requested_provider_session_lock_held=1
    if start_instance_session "$provider" "$repository" "$@"; then
        start_status=0
    else
        start_status=$?
    fi
    unlock_provider_session
    return "$start_status"
}

