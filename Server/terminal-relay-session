}

validate_launch_arguments() {
    local tool="$1"
    shift
    local argument
    local argument_bytes
    local total_bytes=0

    [[ $# -le 64 ]] || {
        echo "Too many $tool launch arguments to persist safely." >&2
        return 64
    }
    for argument in "$@"; do
        argument_bytes="$(printf '%s' "$argument" | /usr/bin/wc -c | /usr/bin/tr -d '[:space:]')"
        [[ "$argument_bytes" =~ ^[0-9]+$ && $argument_bytes -le 4096 ]] || {
            echo "A $tool launch argument is too large to persist safely." >&2
            return 64
        }
        total_bytes=$((total_bytes + argument_bytes))
        [[ $total_bytes -le 32768 ]] || {
            echo "The $tool launch arguments are too large to persist safely." >&2
            return 64
        }
        case "$tool:$argument" in
            codex:resume|codex:--last|codex:--include-non-interactive \
                |codex:--remote|codex:--remote=* \
                |codex:--remote-auth-token-env|codex:--remote-auth-token-env=*)
                echo "Terminal Relay manages Codex resume arguments itself: $argument" >&2
                return 64
                ;;
            claude:-c|claude:--continue|claude:-r|claude:--resume|claude:--resume=* \
                |claude:--session-id|claude:--session-id=*|claude:--fork-session|claude:--from-pr \
                |claude:--from-pr=*)
                echo "Terminal Relay manages Claude session arguments itself: $argument" >&2
                return 64
                ;;
        esac
    done
}

encode_argument_hex() {
    printf '%s' "$1" | /usr/bin/od -An -v -tx1 | /usr/bin/tr -d ' \n'
}

decode_argument_hex() {
    local encoded="$1"
    local escaped

    [[ ${#encoded} -le 8192 && $(( ${#encoded} % 2 )) -eq 0 \
        && "$encoded" =~ ^([a-f0-9]{2})*$ ]] || return 1
    [[ ! "$encoded" =~ ^([a-f0-9]{2})*00 ]] || return 1
    escaped="$(printf '%s' "$encoded" | /usr/bin/sed 's/../\\x&/g')"
    printf -v decoded_argument '%b' "$escaped"
}

load_intent_path_unlocked() {
    local tool="$1"
    local intent_file="$2"
    local key
    local value
    local extra
    local file_identity
    local version_seen=0
    local tool_seen=0
    local repository_seen=0
    local instance_seen=0
    local boot_seen=0
    local argc_seen=0
    local declared_argc=""
    local argument_count=0

    intent_repository=""
    intent_instance=""
    intent_boot_id=""
    intent_arguments=()

    [[ -f "$intent_file" && ! -L "$intent_file" ]] || return 1
    file_identity="$(path_uid_mode "$intent_file")" || return 2
    [[ "$file_identity" == "$user_id:600" ]] || return 2

    while IFS='|' read -r key value extra; do
        [[ -z "${extra:-}" ]] || return 2
        case "$key" in
            version)
                [[ $version_seen -eq 0 && "$value" == "1" ]] || return 2
                version_seen=1
                ;;
            tool)
                [[ $tool_seen -eq 0 && "$value" == "$tool" ]] || return 2
                tool_seen=1
                ;;
            repository)
                [[ $repository_seen -eq 0 ]] || return 2
                intent_repository="$value"
                repository_seen=1
                ;;
            instance)
                [[ $instance_seen -eq 0 ]] || return 2
                intent_instance="$value"
                instance_seen=1
                ;;
            boot)
                [[ $boot_seen -eq 0 ]] || return 2
                intent_boot_id="$value"
                boot_seen=1
                ;;
            argc)
                [[ $argc_seen -eq 0 && "$value" =~ ^(0|[1-9][0-9]*)$ \
                    && $value -le 64 ]] || return 2
                declared_argc="$value"
                argc_seen=1
                ;;
            arg)
                [[ $argc_seen -eq 1 && $argument_count -lt 64 ]] || return 2
                decode_argument_hex "$value" || return 2
                intent_arguments+=("$decoded_argument")
                argument_count=$((argument_count + 1))
                ;;
            *) return 2 ;;
        esac
    done < "$intent_file"

    [[ $version_seen -eq 1 && $tool_seen -eq 1 && $repository_seen -eq 1 \
        && $instance_seen -eq 1 && $boot_seen -eq 1 && $argc_seen -eq 1 \
        && "$argument_count" == "$declared_argc" ]] || return 2
    is_valid_repository_name "$intent_repository" || return 2
    is_valid_instance "$intent_instance" || return 2
    is_valid_boot_id "$intent_boot_id" || return 2
    validate_launch_arguments "$tool" "${intent_arguments[@]}" >/dev/null || return 2
}

load_intent_unlocked() {
    load_intent_path_unlocked "$1" "$(intent_file_for "$2")"
}

write_intent_unlocked() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local boot_id="$4"
    shift 4
    local intent_file
    local temporary_file
    local argument

    validate_launch_arguments "$tool" "$@" || return $?
    is_valid_boot_id "$boot_id" || return 70
    intent_file="$(intent_file_for "$instance")"
    temporary_file="$intent_file.$$.$RANDOM.tmp"
    {
        printf 'version|1\ntool|%s\nrepository|%s\ninstance|%s\nboot|%s\nargc|%s\n' \
            "$tool" "$repository" "$instance" "$boot_id" "$#"
        for argument in "$@"; do
            printf 'arg|%s\n' "$(encode_argument_hex "$argument")"
        done
    } > "$temporary_file"
    /bin/chmod 600 "$temporary_file"
    /bin/mv -f "$temporary_file" "$intent_file"
}

