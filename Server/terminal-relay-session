require_inactive_claude_thread() {
    local project_directory="$1"
    local archive_directory="$2"
    local thread_id="$3"

    thread_is_active claude "$thread_id" && {
        echo "The requested Claude session is already active in Terminal Relay." >&2
        return 75
    }
    read_claude_thread_snapshot \
        "$project_directory" "$archive_directory" "$thread_id" || return $?
    case "$claude_thread_activity" in
        inactive) ;;
        external-active)
            echo "The requested Claude session is active outside Terminal Relay." >&2
            return 75
            ;;
        *)
            echo "Claude session activity could not be verified." >&2
            return 70
            ;;
