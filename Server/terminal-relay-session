#!/bin/bash
set -euo pipefail

readonly protocol_marker="__TERMINAL_RELAY_SESSION_V1__"
readonly installed_helper_path="/usr/local/bin/terminal-relay-session"
readonly default_tmux_path="/usr/bin/tmux"
readonly default_tmux_socket="terminal-relay"
readonly default_workspace_root="/workspace"
readonly default_codex_path="/usr/bin/codex"
readonly default_claude_path="/usr/bin/claude"
readonly default_flock_path="/usr/bin/flock"
readonly default_python_path="/usr/bin/python3"
readonly default_getent_path="/usr/bin/getent"
readonly default_boot_id_path="/proc/sys/kernel/random/boot_id"

resolve_helper_path() {
    local path="$0"
    local directory

    case "$path" in
        /*) ;;
        */*)
            directory="$(cd "$(dirname "$path")" && pwd -P)"
            path="$directory/$(basename "$path")"
            ;;
        *)
            path="$(command -v "$path")"
            ;;
    esac
    printf '%s\n' "$path"
}

helper_path="$(resolve_helper_path)"
test_environment_present=0
if /usr/bin/env | /usr/bin/grep -q '^TERMINAL_RELAY_TEST_'; then
    test_environment_present=1
fi

helper_is_installed=0
if [[ "$helper_path" == "$installed_helper_path" ]]; then
    helper_is_installed=1
elif [[ -e "$installed_helper_path" ]] \
    && [[ "$helper_path" -ef "$installed_helper_path" ]]; then
    helper_is_installed=1
fi

if [[ $helper_is_installed -eq 1 ]]; then
    if [[ $test_environment_present -eq 1 ]]; then
        echo "The installed terminal-relay-session helper refuses test overrides." >&2
        exit 78
    fi
    test_mode=0
elif [[ "${TERMINAL_RELAY_TEST_MODE:-}" == "1" ]]; then
    test_mode=1
elif [[ $test_environment_present -eq 1 ]]; then
    echo "Test overrides require TERMINAL_RELAY_TEST_MODE=1 and a non-installed helper path." >&2
    exit 78
else
    test_mode=0
fi

user_id="$(/usr/bin/id -u)"
if [[ $test_mode -eq 1 ]]; then
    tmux_path="${TERMINAL_RELAY_TEST_TMUX_PATH:-$default_tmux_path}"
    tmux_socket="${TERMINAL_RELAY_TEST_TMUX_SOCKET:-$default_tmux_socket}"
    workspace_root="${TERMINAL_RELAY_TEST_WORKSPACE_ROOT:-$default_workspace_root}"
    runtime_directory="${TERMINAL_RELAY_TEST_RUNTIME_ROOT:-/run/user/$user_id/terminal-relay}"
    codex_path="${TERMINAL_RELAY_TEST_CODEX_PATH:-$default_codex_path}"
    claude_path="${TERMINAL_RELAY_TEST_CLAUDE_PATH:-$default_claude_path}"
    flock_path="${TERMINAL_RELAY_TEST_FLOCK_PATH:-$default_flock_path}"
    signal_path="${TERMINAL_RELAY_TEST_SIGNAL_PATH:-}"
    boot_id_path="${TERMINAL_RELAY_TEST_BOOT_ID_PATH:-$default_boot_id_path}"
else
    if [[ ! -x "$default_getent_path" ]]; then
        echo "Required account database command is unavailable: $default_getent_path" >&2
        exit 69
    fi
    runtime_home="$($default_getent_path passwd "$user_id" \
        | /usr/bin/awk -F: -v expected_uid="$user_id" \
            '$3 == expected_uid { count++; home = $6 } END { if (count == 1) print home }')"
    if [[ "$runtime_home" != /* || "$runtime_home" == "/" \
        || "$runtime_home" == *$'\n'* || ! -d "$runtime_home" ]]; then
        echo "Unable to derive a safe home directory for uid $user_id." >&2
        exit 78
    fi
    runtime_home="$(cd "$runtime_home" && pwd -P)"
    tmux_path="$default_tmux_path"
    tmux_socket="$default_tmux_socket"
    workspace_root="$default_workspace_root"
    runtime_directory="$runtime_home/.local/state/terminal-relay"
    codex_path="$default_codex_path"
    claude_path="$default_claude_path"
    flock_path="$default_flock_path"
    signal_path=""
    boot_id_path="$default_boot_id_path"
fi

usage() {
    cat >&2 <<'EOF'
usage:
  terminal-relay-session list-projects
  terminal-relay-session status
  terminal-relay-session restore
  terminal-relay-session start <codex|claude> <repository> [agent arguments...]
  terminal-relay-session attach <codex|claude> <repository> [agent arguments...]
  terminal-relay-session reattach <codex|claude> <repository> <instance>
  terminal-relay-session stop <codex|claude> <repository> <instance>
  terminal-relay-session <codex|claude> [agent arguments...]
EOF
}

fail_usage() {
    echo "$1" >&2
    usage
    exit 64
}

validate_absolute_path() {
    local label="$1"
    local path="$2"

    if [[ "$path" != /* || "$path" == *$'\n'* || "$path" == "/" ]]; then
        echo "Invalid $label path: $path" >&2
        exit 78
    fi
}

validate_absolute_path "tmux" "$tmux_path"
validate_absolute_path "workspace root" "$workspace_root"
validate_absolute_path "runtime root" "$runtime_directory"
validate_absolute_path "Codex executable" "$codex_path"
validate_absolute_path "Claude executable" "$claude_path"
validate_absolute_path "flock executable" "$flock_path"
validate_absolute_path "boot id" "$boot_id_path"

if [[ ! "$tmux_socket" =~ ^[A-Za-z0-9._-]+$ || ${#tmux_socket} -gt 64 ]]; then
    echo "Invalid tmux socket label: $tmux_socket" >&2
    exit 78
fi

while [[ "$workspace_root" == */ ]]; do
    workspace_root="${workspace_root%/}"
done
while [[ "$runtime_directory" == */ ]]; do
    runtime_directory="${runtime_directory%/}"
done

umask 077
if [[ -L "$runtime_directory" ]] \
    || { [[ -e "$runtime_directory" ]] && [[ ! -d "$runtime_directory" ]]; }; then
    echo "Runtime state root is not a safe directory: $runtime_directory" >&2
    exit 78
fi
/usr/bin/install -d -m 700 "$runtime_directory"
/bin/chmod 700 "$runtime_directory"

tmux_command() {
    "$tmux_path" -f /dev/null -L "$tmux_socket" "$@" 6>&- 7>&- 8>&-
}

validate_tool() {
    case "$1" in
        codex|claude) ;;
        *) fail_usage "Unsupported tool: $1" ;;
    esac
}

is_valid_repository_name() {
    local repository="$1"
    [[ -n "$repository" \
        && ${#repository} -le 100 \
        && "$repository" != "." \
        && "$repository" != ".." \
        && "$repository" =~ ^[A-Za-z0-9._-]+$ ]]
}

is_valid_instance() {
    [[ "$1" =~ ^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$ ]]
}

is_valid_process_identity() {
    [[ "$1" =~ ^[A-Za-z0-9._:-]{1,160}$ ]]
}

project_directory_for() {
    local repository="$1"
    local project_directory

    if ! is_valid_repository_name "$repository"; then
        echo "Invalid repository name: $repository" >&2
        return 64
    fi

    project_directory="$workspace_root/$repository"
    if [[ ! -d "$project_directory" || -L "$project_directory" ]]; then
        echo "Repository directory does not exist: $project_directory" >&2
        return 66
    fi
    printf '%s\n' "$project_directory"
}

session_name_for() {
    printf 'terminal-relay-%s-%s\n' "$1" "$2"
}

metadata_file_for() {
    printf '%s/%s.session\n' "$runtime_directory" "$1"
}

metadata_lock_file_for() {
    printf '%s/%s.metadata.lock\n' "$runtime_directory" "$1"
}

control_lock_file_for() {
    printf '%s/%s.control.lock\n' "$runtime_directory" "$1"
}

agent_lock_file_for() {
    printf '%s/%s.lock\n' "$runtime_directory" "$1"
}

intent_file_for() {
    printf '%s/%s.intent\n' "$runtime_directory" "$1"
}

stopping_intent_file_for() {
    printf '%s/%s.intent.stopping\n' "$runtime_directory" "$1"
}

require_flock() {
    if [[ ! -x "$flock_path" ]]; then
        echo "Required flock executable is unavailable: $flock_path" >&2
        exit 69
    fi
}

lock_tool_control() {
    local lock_file
    require_flock
    lock_file="$(control_lock_file_for "$1")"
    exec 8>"$lock_file"
    "$flock_path" 8
}

unlock_tool_control() {
    exec 8>&-
}

lock_tool_metadata() {
    local lock_file
    require_flock
    lock_file="$(metadata_lock_file_for "$1")"
    exec 6>"$lock_file"
    "$flock_path" 6
}

unlock_tool_metadata() {
    exec 6>&-
}

session_exists() {
    local session_name
    session_name="$(session_name_for "$1" "$2")"
    tmux_command has-session -t "$session_name" 2>/dev/null
}

any_tool_session_exists() {
    tmux_command list-sessions -F '#{session_name}' 2>/dev/null \
        | /usr/bin/grep -Eq "^terminal-relay-$1($|-)"
}

load_metadata_unlocked() {
    local tool="$1"
    local metadata_file
    local key
    local value
    local extra
    local repository_seen=0
    local instance_seen=0
    local pid_seen=0
    local start_seen=0

    metadata_repository=""
    metadata_instance=""
    metadata_pid=""
    metadata_start=""
    metadata_file="$(metadata_file_for "$tool")"
    [[ -f "$metadata_file" && ! -L "$metadata_file" ]] || return 1

    while IFS='|' read -r key value extra; do
        [[ -z "${extra:-}" ]] || return 1
        case "$key" in
            repository)
                [[ $repository_seen -eq 0 ]] || return 1
                metadata_repository="$value"
                repository_seen=1
                ;;
            instance)
                [[ $instance_seen -eq 0 ]] || return 1
                metadata_instance="$value"
                instance_seen=1
                ;;
            pid)
                [[ $pid_seen -eq 0 ]] || return 1
                metadata_pid="$value"
                pid_seen=1
                ;;
            start)
                [[ $start_seen -eq 0 ]] || return 1
                metadata_start="$value"
                start_seen=1
                ;;
            *) return 1 ;;
        esac
    done < "$metadata_file"

    [[ $repository_seen -eq 1 \
        && $instance_seen -eq 1 \
        && $pid_seen -eq 1 \
        && $start_seen -eq 1 ]] || return 1
    is_valid_repository_name "$metadata_repository" || return 1
    is_valid_instance "$metadata_instance" || return 1
    [[ "$metadata_pid" =~ ^(0|[1-9][0-9]*)$ ]] || return 1
    if [[ "$metadata_pid" == "0" ]]; then
        [[ "$metadata_start" == "pending" ]] || return 1
    else
        is_valid_process_identity "$metadata_start" || return 1
    fi
}

write_metadata_unlocked() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local pid="$4"
    local start="$5"
    local metadata_file
    local temporary_file

    metadata_file="$(metadata_file_for "$tool")"
    temporary_file="$metadata_file.$$.$RANDOM.tmp"
    printf 'repository|%s\ninstance|%s\npid|%s\nstart|%s\n' \
        "$repository" "$instance" "$pid" "$start" > "$temporary_file"
    /bin/chmod 600 "$temporary_file"
    /bin/mv -f "$temporary_file" "$metadata_file"
}

remove_metadata_unlocked() {
    local metadata_file
    metadata_file="$(metadata_file_for "$1")"
    /bin/rm -f -- "$metadata_file"
}

path_uid_mode() {
    local path="$1"
    local result

    if result="$(/usr/bin/stat -c '%u:%a' "$path" 2>/dev/null)"; then
        printf '%s\n' "$result"
        return 0
    fi
    result="$(/usr/bin/stat -f '%u:%Lp' "$path" 2>/dev/null)" || return 1
    printf '%s\n' "$result"
}

is_valid_boot_id() {
    [[ "$1" =~ ^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$ ]]
}

current_boot_id() {
    local boot_id
    [[ -f "$boot_id_path" && ! -L "$boot_id_path" ]] || return 1
    IFS= read -r boot_id < "$boot_id_path" || return 1
    is_valid_boot_id "$boot_id" || return 1
    printf '%s\n' "$boot_id"
}

validate_launch_arguments() {
    local tool="$1"
    shift
    local argument
    local argument_bytes
    local total_bytes=0

    [[ $# -le 64 ]] || {
        echo "Too many $tool launch arguments to persist safely." >&2
        return 64
    }
    for argument in "$@"; do
        argument_bytes="$(printf '%s' "$argument" | /usr/bin/wc -c | /usr/bin/tr -d '[:space:]')"
        [[ "$argument_bytes" =~ ^[0-9]+$ && $argument_bytes -le 4096 ]] || {
            echo "A $tool launch argument is too large to persist safely." >&2
            return 64
        }
        total_bytes=$((total_bytes + argument_bytes))
        [[ $total_bytes -le 32768 ]] || {
            echo "The $tool launch arguments are too large to persist safely." >&2
            return 64
        }
        case "$tool:$argument" in
            codex:resume|codex:--last|codex:--include-non-interactive)
                echo "Terminal Relay manages Codex resume arguments itself: $argument" >&2
                return 64
                ;;
            claude:-c|claude:--continue|claude:-r|claude:--resume|claude:--resume=* \
                |claude:--session-id|claude:--session-id=*|claude:--fork-session|claude:--from-pr \
                |claude:--from-pr=*)
                echo "Terminal Relay manages Claude session arguments itself: $argument" >&2
                return 64
                ;;
        esac
    done
}

encode_argument_hex() {
    printf '%s' "$1" | /usr/bin/od -An -v -tx1 | /usr/bin/tr -d ' \n'
}

decode_argument_hex() {
    local encoded="$1"
    local escaped

    [[ ${#encoded} -le 8192 && $(( ${#encoded} % 2 )) -eq 0 \
        && "$encoded" =~ ^([a-f0-9]{2})*$ ]] || return 1
    [[ ! "$encoded" =~ ^([a-f0-9]{2})*00 ]] || return 1
    escaped="$(printf '%s' "$encoded" | /usr/bin/sed 's/../\\x&/g')"
    printf -v decoded_argument '%b' "$escaped"
}

load_intent_path_unlocked() {
    local tool="$1"
    local intent_file="$2"
    local key
    local value
    local extra
    local file_identity
    local version_seen=0
    local tool_seen=0
    local repository_seen=0
    local instance_seen=0
    local boot_seen=0
    local argc_seen=0
    local declared_argc=""
    local argument_count=0

    intent_repository=""
    intent_instance=""
    intent_boot_id=""
    intent_arguments=()

    [[ -f "$intent_file" && ! -L "$intent_file" ]] || return 1
    file_identity="$(path_uid_mode "$intent_file")" || return 2
    [[ "$file_identity" == "$user_id:600" ]] || return 2

    while IFS='|' read -r key value extra; do
        [[ -z "${extra:-}" ]] || return 2
        case "$key" in
            version)
                [[ $version_seen -eq 0 && "$value" == "1" ]] || return 2
                version_seen=1
                ;;
            tool)
                [[ $tool_seen -eq 0 && "$value" == "$tool" ]] || return 2
                tool_seen=1
                ;;
            repository)
                [[ $repository_seen -eq 0 ]] || return 2
                intent_repository="$value"
                repository_seen=1
                ;;
            instance)
                [[ $instance_seen -eq 0 ]] || return 2
                intent_instance="$value"
                instance_seen=1
                ;;
            boot)
                [[ $boot_seen -eq 0 ]] || return 2
                intent_boot_id="$value"
                boot_seen=1
                ;;
            argc)
                [[ $argc_seen -eq 0 && "$value" =~ ^(0|[1-9][0-9]*)$ \
                    && $value -le 64 ]] || return 2
                declared_argc="$value"
                argc_seen=1
                ;;
            arg)
                [[ $argc_seen -eq 1 && $argument_count -lt 64 ]] || return 2
                decode_argument_hex "$value" || return 2
                intent_arguments+=("$decoded_argument")
                argument_count=$((argument_count + 1))
                ;;
            *) return 2 ;;
        esac
    done < "$intent_file"

    [[ $version_seen -eq 1 && $tool_seen -eq 1 && $repository_seen -eq 1 \
        && $instance_seen -eq 1 && $boot_seen -eq 1 && $argc_seen -eq 1 \
        && "$argument_count" == "$declared_argc" ]] || return 2
    is_valid_repository_name "$intent_repository" || return 2
    is_valid_instance "$intent_instance" || return 2
    is_valid_boot_id "$intent_boot_id" || return 2
    validate_launch_arguments "$tool" "${intent_arguments[@]}" >/dev/null || return 2
}

load_intent_unlocked() {
    load_intent_path_unlocked "$1" "$(intent_file_for "$1")"
}

write_intent_unlocked() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local boot_id="$4"
    shift 4
    local intent_file
    local temporary_file
    local argument

    validate_launch_arguments "$tool" "$@" || return $?
    is_valid_boot_id "$boot_id" || return 70
    intent_file="$(intent_file_for "$tool")"
    temporary_file="$intent_file.$$.$RANDOM.tmp"
    {
        printf 'version|1\ntool|%s\nrepository|%s\ninstance|%s\nboot|%s\nargc|%s\n' \
            "$tool" "$repository" "$instance" "$boot_id" "$#"
        for argument in "$@"; do
            printf 'arg|%s\n' "$(encode_argument_hex "$argument")"
        done
    } > "$temporary_file"
    /bin/chmod 600 "$temporary_file"
    /bin/mv -f "$temporary_file" "$intent_file"
}

remove_intent_if_matches_unlocked() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local intent_file

    intent_file="$(intent_file_for "$tool")"
    if load_intent_path_unlocked "$tool" "$intent_file" \
        && [[ "$intent_repository" == "$repository" && "$intent_instance" == "$instance" ]]; then
        /bin/rm -f -- "$intent_file"
    fi
}

clear_same_boot_stale_intent_unlocked() {
    local tool="$1"
    local boot_id="$2"
    local intent_file
    local load_status

    intent_file="$(intent_file_for "$tool")"
    [[ -e "$intent_file" || -L "$intent_file" ]] || return 0
    set +e
    load_intent_path_unlocked "$tool" "$intent_file"
    load_status=$?
    set -e
    if [[ $load_status -ne 0 ]]; then
        echo "The saved $tool restart intent is invalid; refusing to replace it." >&2
        return 70
    fi
    if [[ "$intent_boot_id" != "$boot_id" ]]; then
        echo "The saved $tool launch '$intent_instance' for repository '$intent_repository' is awaiting reboot recovery." >&2
        return 75
    fi
    /bin/rm -f -- "$intent_file"
}

prune_dead_same_boot_intent_unlocked() {
    local tool="$1"
    local boot_id="$2"
    local intent_file
    local load_status

    intent_file="$(intent_file_for "$tool")"
    [[ -e "$intent_file" || -L "$intent_file" ]] || return 0
    set +e
    load_intent_path_unlocked "$tool" "$intent_file"
    load_status=$?
    set -e
    [[ $load_status -eq 0 ]] || return 70
    if [[ "$intent_boot_id" == "$boot_id" ]]; then
        /bin/rm -f -- "$intent_file"
    fi
}

runtime_identity="$(path_uid_mode "$runtime_directory")" || {
    echo "Unable to inspect runtime state root: $runtime_directory" >&2
    exit 78
}
if [[ "$runtime_identity" != "$user_id:700" ]]; then
    echo "Runtime state root must be owned by uid $user_id with mode 0700: $runtime_directory" >&2
    exit 78
fi

generate_instance() {
    local random_hex
    local instance
    random_hex="$(/usr/bin/od -An -N16 -tx1 /dev/urandom | /usr/bin/tr -d ' \n')"
    [[ "$random_hex" =~ ^[a-f0-9]{32}$ ]] || return 70
    random_hex="${random_hex:0:12}4${random_hex:13:3}8${random_hex:17:15}"
    instance="${random_hex:0:8}-${random_hex:8:4}-${random_hex:12:4}-${random_hex:16:4}-${random_hex:20:12}"
    is_valid_instance "$instance" || return 70
    printf '%s\n' "$instance"
}

process_start_identity() {
    local pid="$1"
    local stat_line
    local stat_fields
    local started
    local -a stat_parts

    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    if [[ -r "/proc/$pid/stat" ]]; then
        IFS= read -r stat_line < "/proc/$pid/stat" || return 1
        stat_fields="${stat_line##*) }"
        [[ "$stat_fields" != "$stat_line" ]] || return 1
        read -r -a stat_parts <<< "$stat_fields"
        [[ ${#stat_parts[@]} -ge 20 && "${stat_parts[19]}" =~ ^[0-9]+$ ]] || return 1
        printf 'proc_%s\n' "${stat_parts[19]}"
        return 0
    fi

    [[ $test_mode -eq 1 ]] || return 1

    started="$(LC_ALL=C /bin/ps -o lstart= -p "$pid" 2>/dev/null)" || return 1
    started="${started#"${started%%[![:space:]]*}"}"
    [[ -n "$started" ]] || return 1
    started="${started// /_}"
    started="${started//$'\t'/_}"
    is_valid_process_identity "ps_$started" || return 1
    printf 'ps_%s\n' "$started"
}

process_matches() {
    local current_identity
    current_identity="$(process_start_identity "$1")" || return 1
    [[ "$current_identity" == "$2" ]]
}

require_lifetime_signal_support() {
    if [[ $test_mode -eq 1 ]]; then
        if [[ -z "$signal_path" || ! -x "$signal_path" || -L "$signal_path" ]]; then
            echo "The isolated test signal adapter is unavailable: ${signal_path:-unset}" >&2
            return 69
        fi
        return 0
    fi

    if [[ ! -x "$default_python_path" || ! -r /proc/self/stat ]]; then
        echo "Production stop requires $default_python_path with Linux pidfd support." >&2
        return 69
    fi
    if ! "$default_python_path" - <<'PYTHON_PIDFD_PROBE'
import os
import signal

if not callable(getattr(os, "pidfd_open", None)):
    raise SystemExit(1)
if not callable(getattr(signal, "pidfd_send_signal", None)):
    raise SystemExit(1)
descriptor = os.pidfd_open(os.getpid(), 0)
os.close(descriptor)
PYTHON_PIDFD_PROBE
    then
        echo "Production stop requires working Linux pidfd support in $default_python_path." >&2
        return 69
    fi
}

signal_recorded_process() {
    local pid="$1"
    local expected_start="$2"
    local signal_name="$3"

    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 75
    case "$signal_name" in
        TERM|KILL) ;;
        *) return 64 ;;
    esac

    if [[ $test_mode -eq 1 ]]; then
        "$signal_path" "$pid" "$expected_start" "$signal_name"
        return $?
    fi

    "$default_python_path" - "$pid" "$expected_start" "$signal_name" <<'PYTHON_PIDFD_SIGNAL'
import os
import re
import signal
import sys

pid_text, expected_start, signal_name = sys.argv[1:]
if not re.fullmatch(r"[1-9][0-9]*", pid_text):
    raise SystemExit(75)
if not re.fullmatch(r"proc_[0-9]+", expected_start):
    raise SystemExit(75)
signals = {"TERM": signal.SIGTERM, "KILL": signal.SIGKILL}
if signal_name not in signals:
    raise SystemExit(64)

pid = int(pid_text)
try:
    descriptor = os.pidfd_open(pid, 0)
except ProcessLookupError:
    raise SystemExit(75)
except (AttributeError, OSError):
    raise SystemExit(69)

try:
    try:
        with open(f"/proc/{pid}/stat", "rb") as stat_file:
            stat_line = stat_file.read()
    except FileNotFoundError:
        raise SystemExit(75)
    except OSError:
        raise SystemExit(69)

    delimiter = stat_line.rfind(b") ")
    if delimiter < 0:
        raise SystemExit(70)
    stat_fields = stat_line[delimiter + 2:].split()
    if len(stat_fields) < 20 or not stat_fields[19].isdigit():
        raise SystemExit(70)
    if f"proc_{stat_fields[19].decode('ascii')}" != expected_start:
        raise SystemExit(75)

    try:
        signal.pidfd_send_signal(descriptor, signals[signal_name], None, 0)
    except ProcessLookupError:
        raise SystemExit(75)
    except (AttributeError, OSError):
        raise SystemExit(69)
finally:
    os.close(descriptor)
PYTHON_PIDFD_SIGNAL
}

agent_lock_is_free() {
    local lock_file
    local result=1
    lock_file="$(agent_lock_file_for "$1")"
    exec 7>"$lock_file"
    if "$flock_path" --nonblock 7; then
        result=0
    fi
    exec 7>&-
    return "$result"
}

metadata_launch_is_running() {
    local tool="$1"
    if [[ "$metadata_pid" != "0" ]] \
        && process_matches "$metadata_pid" "$metadata_start"; then
        return 0
    fi
    ! agent_lock_is_free "$tool"
}

configure_tmux() {
    if [[ $test_mode -eq 1 && "${TERMINAL_RELAY_TEST_CONFIGURE_FAIL:-}" == "1" ]]; then
        return 1
    fi
    tmux_command set-option -g status off
    tmux_command set-option -g set-titles on
    tmux_command set-option -g set-titles-string '#{pane_title}'
    tmux_command set-option -g detach-on-destroy on
    tmux_command set-window-option -g allow-rename on
}

write_launch_script() {
    local launch_file="$1"
    local tool="$2"
    local repository="$3"
    local instance="$4"
    local launch_mode="$5"
    shift 5

    {
        printf '#!/bin/bash\n'
        printf '/bin/rm -f -- %q\n' "$launch_file"
        if [[ $test_mode -eq 1 ]]; then
            printf 'export TERMINAL_RELAY_TEST_MODE=1\n'
            printf 'export TERMINAL_RELAY_TEST_WORKSPACE_ROOT=%q\n' "$workspace_root"
            printf 'export TERMINAL_RELAY_TEST_RUNTIME_ROOT=%q\n' "$runtime_directory"
            printf 'export TERMINAL_RELAY_TEST_CODEX_PATH=%q\n' "$codex_path"
            printf 'export TERMINAL_RELAY_TEST_CLAUDE_PATH=%q\n' "$claude_path"
            printf 'export TERMINAL_RELAY_TEST_FLOCK_PATH=%q\n' "$flock_path"
            printf 'export TERMINAL_RELAY_TEST_BOOT_ID_PATH=%q\n' "$boot_id_path"
        fi
        [[ -z "${ConEmuANSI+x}" ]] || printf 'export ConEmuANSI=%q\n' "$ConEmuANSI"
        printf 'exec %q __run-agent %q %q %q %q' \
            "$helper_path" "$tool" "$repository" "$instance" "$launch_mode"
        printf ' %q' "$@"
        printf '\n'
    } > "$launch_file"
    /bin/chmod 700 "$launch_file"
}

list_projects() {
    local project_directory
    local repository
    local -a repositories=()

    printf '%s\n' "$protocol_marker"
    if [[ ! -d "$workspace_root" ]]; then
        echo "Workspace root does not exist: $workspace_root" >&2
        return 66
    fi

    shopt -s nullglob dotglob
    for project_directory in "$workspace_root"/*; do
        [[ -d "$project_directory" && ! -L "$project_directory" ]] || continue
        repository="${project_directory##*/}"
        is_valid_repository_name "$repository" || continue
        repositories+=("$repository")
    done
    shopt -u nullglob dotglob

    if [[ ${#repositories[@]} -gt 0 ]]; then
        printf 'project|%s\n' "${repositories[@]}" | LC_ALL=C /usr/bin/sort
    fi
}

status_sessions() {
    local tool
    local repository
    local instance
    local session_name
    local attached_client_count
    local boot_id
    local intent_status

    if [[ ! -x "$tmux_path" ]]; then
        echo "Required tmux executable is unavailable: $tmux_path" >&2
        return 69
    fi
    require_flock
    boot_id="$(current_boot_id)" || {
        echo "Unable to read the worker boot identity from $boot_id_path." >&2
        return 69
    }

    printf '%s\n' "$protocol_marker"
    for tool in codex claude; do
        lock_tool_control "$tool"
        lock_tool_metadata "$tool"
        if ! load_metadata_unlocked "$tool"; then
            if any_tool_session_exists "$tool"; then
                unlock_tool_metadata
                unlock_tool_control
                echo "The active $tool session has no valid launch metadata." >&2
                return 70
            fi
            intent_status=0
            prune_dead_same_boot_intent_unlocked "$tool" "$boot_id" || intent_status=$?
            unlock_tool_metadata
            unlock_tool_control
            if [[ $intent_status -ne 0 ]]; then
                echo "The saved $tool restart intent is invalid." >&2
                return "$intent_status"
            fi
            continue
        fi

        repository="$metadata_repository"
        instance="$metadata_instance"
        if session_exists "$tool" "$instance"; then
            session_name="$(session_name_for "$tool" "$instance")"
            if ! attached_client_count="$(tmux_command display-message -p -t "$session_name" '#{session_attached}' 2>/dev/null)"; then
                if metadata_launch_is_running "$tool"; then
                    attached_client_count=0
                else
                    remove_metadata_unlocked "$tool"
                    intent_status=0
                    prune_dead_same_boot_intent_unlocked "$tool" "$boot_id" || intent_status=$?
                    unlock_tool_metadata
                    unlock_tool_control
                    if [[ $intent_status -ne 0 ]]; then
                        echo "The saved $tool restart intent is invalid." >&2
                        return "$intent_status"
                    fi
                    continue
                fi
            fi
        elif metadata_launch_is_running "$tool"; then
            attached_client_count=0
        else
            remove_metadata_unlocked "$tool"
            intent_status=0
            prune_dead_same_boot_intent_unlocked "$tool" "$boot_id" || intent_status=$?
            unlock_tool_metadata
            unlock_tool_control
            if [[ $intent_status -ne 0 ]]; then
                echo "The saved $tool restart intent is invalid." >&2
                return "$intent_status"
            fi
            continue
        fi
        unlock_tool_metadata
        unlock_tool_control

        if [[ ! "$attached_client_count" =~ ^[0-9]+$ ]]; then
            echo "tmux returned an invalid attached-client count for $tool." >&2
            return 70
        fi
        printf 'session|%s|%s|%s|%s\n' \
            "$tool" "$repository" "$attached_client_count" "$instance"
    done
}

wait_for_recorded_pid() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local attempt

    stop_pid=0
    stop_start="pending"
    for attempt in $(seq 1 40); do
        lock_tool_metadata "$tool"
        if ! load_metadata_unlocked "$tool"; then
            unlock_tool_metadata
            return 75
        fi
        if [[ "$metadata_repository" != "$repository" \
            || "$metadata_instance" != "$instance" ]]; then
            unlock_tool_metadata
            return 75
        fi
        stop_pid="$metadata_pid"
        stop_start="$metadata_start"
        unlock_tool_metadata
        [[ "$stop_pid" != "0" ]] && return 0
        session_exists "$tool" "$instance" || return 0
        sleep 0.05
    done
    return 0
}

wait_for_launch_end() {
    local tool="$1"
    local pid="$2"
    local start="$3"
    local attempts="$4"
    local attempt

    attempt=0
    while [[ $attempt -lt $attempts ]]; do
        attempt=$((attempt + 1))
        if { [[ "$pid" == "0" ]] || ! process_matches "$pid" "$start"; } \
            && agent_lock_is_free "$tool"; then
            return 0
        fi
        sleep 0.1
    done
    return 1
}

terminate_launch() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local session_name
    local signal_status

    if ! wait_for_recorded_pid "$tool" "$repository" "$instance"; then
        return 75
    fi
    require_lifetime_signal_support || return $?

    session_name="$(session_name_for "$tool" "$instance")"
    if session_exists "$tool" "$instance"; then
        if ! tmux_command kill-session -t "$session_name" 2>/dev/null \
            && session_exists "$tool" "$instance"; then
            return 70
        fi
    fi

    if ! wait_for_launch_end "$tool" "$stop_pid" "$stop_start" 20; then
        if [[ "$stop_pid" != "0" ]]; then
            signal_status=0
            signal_recorded_process "$stop_pid" "$stop_start" TERM || signal_status=$?
            case "$signal_status" in
                0|75) ;;
                *) return 70 ;;
            esac
        fi
        if ! wait_for_launch_end "$tool" "$stop_pid" "$stop_start" 20; then
            if [[ "$stop_pid" != "0" ]]; then
                signal_status=0
                signal_recorded_process "$stop_pid" "$stop_start" KILL || signal_status=$?
                case "$signal_status" in
                    0|75) ;;
                    *) return 70 ;;
                esac
            fi
            wait_for_launch_end "$tool" "$stop_pid" "$stop_start" 30 || return 70
        fi
    fi

    if session_exists "$tool" "$instance"; then
        tmux_command kill-session -t "$session_name" 2>/dev/null || true
        session_exists "$tool" "$instance" && return 70
    fi

    lock_tool_metadata "$tool"
    if ! load_metadata_unlocked "$tool" \
        || [[ "$metadata_repository" != "$repository" \
            || "$metadata_instance" != "$instance" ]]; then
        unlock_tool_metadata
        return 75
    fi
    remove_metadata_unlocked "$tool"
    unlock_tool_metadata
}

restore_sessions() {
    local boot_id
    local tool
    local intent_file
    local stopping_file
    local load_status
    local project_directory
    local repository
    local instance
    local launch_file
    local launch_command
    local session_name
    local overall_status=0

    [[ -x "$tmux_path" ]] || {
        echo "Required tmux executable is unavailable: $tmux_path" >&2
        return 69
    }
    require_flock
    require_lifetime_signal_support || return $?
    boot_id="$(current_boot_id)" || {
        echo "Unable to read the worker boot identity from $boot_id_path." >&2
        return 69
    }

    for tool in codex claude; do
        lock_tool_control "$tool"
        lock_tool_metadata "$tool"
        intent_file="$(intent_file_for "$tool")"
        stopping_file="$(stopping_intent_file_for "$tool")"
        if [[ -e "$stopping_file" || -L "$stopping_file" ]]; then
            set +e
            load_intent_path_unlocked "$tool" "$stopping_file"
            load_status=$?
            set -e
            if [[ $load_status -ne 0 ]]; then
                unlock_tool_metadata
                unlock_tool_control
                echo "The saved $tool stop transition is invalid; recovery was skipped." >&2
                overall_status=70
                continue
            fi
            remove_metadata_unlocked "$tool"
            /bin/rm -f -- "$stopping_file"
            unlock_tool_metadata
            unlock_tool_control
            continue
        fi
        if [[ ! -e "$intent_file" && ! -L "$intent_file" ]]; then
            unlock_tool_metadata
            unlock_tool_control
            continue
        fi

        set +e
        load_intent_path_unlocked "$tool" "$intent_file"
        load_status=$?
        set -e
        if [[ $load_status -ne 0 ]]; then
            unlock_tool_metadata
            unlock_tool_control
            echo "The saved $tool restart intent is invalid; recovery was skipped." >&2
            overall_status=70
            continue
        fi
        if [[ "$intent_boot_id" == "$boot_id" ]]; then
            unlock_tool_metadata
            unlock_tool_control
            continue
        fi

        repository="$intent_repository"
        instance="$intent_instance"
        if ! project_directory="$(project_directory_for "$repository")"; then
            unlock_tool_metadata
            unlock_tool_control
            echo "The saved $tool launch cannot be restored because its repository is unavailable." >&2
            overall_status=66
            continue
        fi
        if any_tool_session_exists "$tool" || {
            load_metadata_unlocked "$tool" && metadata_launch_is_running "$tool";
        }; then
            unlock_tool_metadata
            unlock_tool_control
            echo "Refusing to restore $tool while another launch is active." >&2
            overall_status=75
            continue
        fi

        remove_metadata_unlocked "$tool"
        write_metadata_unlocked "$tool" "$repository" "$instance" 0 pending
        if ! write_intent_unlocked \
            "$tool" "$repository" "$instance" "$boot_id" "${intent_arguments[@]}"; then
            remove_metadata_unlocked "$tool"
            unlock_tool_metadata
            unlock_tool_control
            echo "Unable to advance the saved $tool restart intent." >&2
            overall_status=70
            continue
        fi
        unlock_tool_metadata

        session_name="$(session_name_for "$tool" "$instance")"
        launch_file="$runtime_directory/$tool.restore.$$.$RANDOM"
        write_launch_script \
            "$launch_file" "$tool" "$repository" "$instance" resume "${intent_arguments[@]}"
        printf -v launch_command '%q' "$launch_file"
        if ! tmux_command new-session -d -s "$session_name" -c "$project_directory" "$launch_command"; then
            /bin/rm -f -- "$launch_file"
            lock_tool_metadata "$tool"
            if load_metadata_unlocked "$tool" && [[ "$metadata_instance" == "$instance" ]]; then
                remove_metadata_unlocked "$tool"
            fi
            remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
            unlock_tool_metadata
            unlock_tool_control
            echo "Unable to recreate the $tool tmux session during recovery." >&2
            overall_status=70
            continue
        fi
        if ! configure_tmux || ! session_exists "$tool" "$instance"; then
            terminate_launch "$tool" "$repository" "$instance" || true
            lock_tool_metadata "$tool"
            remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
            unlock_tool_metadata
            unlock_tool_control
            echo "The restored $tool launch ended before recovery completed." >&2
            overall_status=70
            continue
        fi
        unlock_tool_control
        printf 'Restored %s session %s for repository %s.\n' "$tool" "$instance" "$repository"
    done

    return "$overall_status"
}

start_session() {
    local tool="$1"
    local repository="$2"
    shift 2
    local project_directory
    local session_name
    local instance
    local launch_file
    local launch_command
    local attached_client_count
    local created_session=0
    local metadata_present=0
    local active_repository=""
    local active_instance=""
    local boot_id
    local intent_status

    validate_tool "$tool"
    validate_launch_arguments "$tool" "$@" || exit $?
    boot_id="$(current_boot_id)" || {
        echo "Unable to read the worker boot identity from $boot_id_path." >&2
        exit 69
    }
    project_directory="$(project_directory_for "$repository")" || exit $?
    [[ -x "$tmux_path" ]] || { echo "Required tmux executable is unavailable: $tmux_path" >&2; exit 69; }
