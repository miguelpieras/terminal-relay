    "$tmux_path" -f /dev/null -L "$tmux_socket" "$@" 3>&- 6>&- 7>&- 8>&-
}

run_codex_rpc() {
    local mode="$1"
    shift

    [[ -x "$default_python_path" ]] || {
        echo "Required Python executable is unavailable: $default_python_path" >&2
        return 69
    }

    "$default_python_path" - "$codex_app_server_socket" "$mode" "$@" <<'PYTHON_CODEX_RPC'
import base64
import hashlib
import json
import os
import re
import signal
import socket
import sqlite3
import struct
import sys
import time
import uuid

socket_path, mode, *arguments = sys.argv[1:]
maximum_frame_bytes = 8 * 1024 * 1024


class WebSocket:
    def __init__(self, path):
        self.socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.socket.settimeout(5)
        self.socket.connect(path)
        self.buffer = b""
        key = base64.b64encode(os.urandom(16)).decode("ascii")
        request = (
            "GET / HTTP/1.1\r\n"
            "Host: localhost\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "\r\n"
        ).encode("ascii")
        self.socket.sendall(request)
        headers = self._read_headers()
        status_line, *header_lines = headers.split(b"\r\n")
        if b" 101 " not in status_line:
            raise RuntimeError("Codex app-server rejected the websocket connection.")
        response_headers = {}
        for line in header_lines:
            name, separator, value = line.partition(b":")
            if separator:
                response_headers[name.strip().lower()] = value.strip()
        expected_accept = base64.b64encode(
            hashlib.sha1(
                key.encode("ascii") + b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
            ).digest()
        )
        if response_headers.get(b"sec-websocket-accept") != expected_accept:
            raise RuntimeError("Codex app-server returned an invalid websocket handshake.")

    def _read_headers(self):
        while b"\r\n\r\n" not in self.buffer:
            chunk = self.socket.recv(4096)
            if not chunk:
                raise EOFError("Codex app-server closed during websocket setup.")
            self.buffer += chunk
            if len(self.buffer) > 64 * 1024:
                raise RuntimeError("Codex app-server returned oversized websocket headers.")
        headers, self.buffer = self.buffer.split(b"\r\n\r\n", 1)
        return headers

    def _read_exact(self, length):
        while len(self.buffer) < length:
            chunk = self.socket.recv(max(4096, length - len(self.buffer)))
            if not chunk:
                raise EOFError("Codex app-server closed the connection.")
            self.buffer += chunk
        result, self.buffer = self.buffer[:length], self.buffer[length:]
        return result

    def send_frame(self, opcode, payload=b""):
        if isinstance(payload, str):
            payload = payload.encode("utf-8")
        length = len(payload)
        header = bytes([0x80 | opcode])
        if length < 126:
            header += bytes([0x80 | length])
        elif length < 65_536:
            header += bytes([0x80 | 126]) + struct.pack("!H", length)
        else:
            header += bytes([0x80 | 127]) + struct.pack("!Q", length)
        mask = os.urandom(4)
        masked = bytes(value ^ mask[index % 4] for index, value in enumerate(payload))
        self.socket.sendall(header + mask + masked)

    def send_json(self, value):
        self.send_frame(1, json.dumps(value, separators=(",", ":")))

    def receive_message(self):
        fragments = []
        message_opcode = None
        while True:
            first, second = self._read_exact(2)
            final = bool(first & 0x80)
            opcode = first & 0x0F
            masked = bool(second & 0x80)
            length = second & 0x7F
            if length == 126:
                length = struct.unpack("!H", self._read_exact(2))[0]
            elif length == 127:
                length = struct.unpack("!Q", self._read_exact(8))[0]
            if length > maximum_frame_bytes:
                raise RuntimeError("Codex app-server returned an oversized websocket frame.")
            mask = self._read_exact(4) if masked else None
            payload = self._read_exact(length)
            if mask is not None:
                payload = bytes(
                    value ^ mask[index % 4] for index, value in enumerate(payload)
                )
            if opcode == 8:
                raise EOFError("Codex app-server closed the connection.")
            if opcode == 9:
                self.send_frame(10, payload)
                continue
            if opcode in (1, 2):
                message_opcode = opcode
                fragments = [payload]
            elif opcode == 0 and message_opcode is not None:
                fragments.append(payload)
            else:
                continue
            if final:
                return message_opcode, b"".join(fragments)

    def receive_json(self, deadline):
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("Timed out waiting for Codex app-server.")
            self.socket.settimeout(min(remaining, 2))
            try:
                opcode, payload = self.receive_message()
            except socket.timeout:
                continue
            if opcode == 1:
                return json.loads(payload)

    def close(self):
        try:
            self.send_frame(8)
        except (OSError, RuntimeError):
            pass
        self.socket.close()


def initialize(client):
    client.send_json(
        {
            "method": "initialize",
            "id": 0,
            "params": {
                "clientInfo": {
                    "name": "terminal_relay",
                    "title": "Terminal Relay",
                    "version": "1.0.0",
                }
            },
        }
    )
    client.send_json({"method": "initialized", "params": {}})


def wait_for_response(client, request_id, timeout, notifications=None):
    deadline = time.monotonic() + timeout
    while True:
        value = client.receive_json(deadline)
        if value.get("id") == request_id:
            return value
        if notifications is not None:
            notifications.append(value)


def result_from(response):
    if not isinstance(response, dict) or "error" in response:
        raise RuntimeError("Codex app-server request failed.")
    result = response.get("result")
    if not isinstance(result, dict):
        raise RuntimeError("Codex app-server returned an invalid result.")
    return result


def thread_prompt(thread_id):
    database = os.path.join(os.path.expanduser("~"), ".codex", "state_5.sqlite")
    connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
    try:
        columns = {
            row[1] for row in connection.execute("pragma table_info(threads)")
        }
        prompt_columns = [
            column
            for column in ("first_user_message", "preview", "title")
            if column in columns
        ]
        if not prompt_columns:
            return "", os.path.expanduser("~")
        selected = prompt_columns + (["cwd"] if "cwd" in columns else [])
        row = connection.execute(
            f"select {', '.join(selected)} from threads where id = ? limit 1",
            (thread_id,),
        ).fetchone()
        if not row:
            return "", os.path.expanduser("~")
        values = dict(zip(selected, row))
        prompt = next(
            (
                values[column].strip()
                for column in prompt_columns
                if isinstance(values.get(column), str) and values[column].strip()
            ),
            "",
        )
        cwd = values.get("cwd")
        if not isinstance(cwd, str) or not os.path.isabs(cwd) or not os.path.isdir(cwd):
            cwd = os.path.expanduser("~")
        return prompt[:2000], cwd
    finally:
        connection.close()


def normalized_generated_title(text):
    if not isinstance(text, str):
        return ""
    try:
        value = json.loads(text)
    except json.JSONDecodeError:
        return ""
    if not isinstance(value, dict):
        return ""
    title = value.get("title")
    if not isinstance(title, str):
        return ""
    title = re.sub(r"\s+", " ", title).strip().strip("\"'")
    title = title.rstrip(".!?")
    if not title or len(title) > 36:
        return ""
    return title


def loaded_thread_ids(client):
    client.send_json(
        {
            "method": "thread/loaded/list",
            "id": 9,
            "params": {},
        }
    )
    result = result_from(wait_for_response(client, 9, 15))
    thread_ids = result.get("data")
    if not isinstance(thread_ids, list):
        return []
    return [thread_id for thread_id in thread_ids if isinstance(thread_id, str)]


def generate_titles(client, thread_ids):
    if "--active" in thread_ids:
        thread_ids = loaded_thread_ids(client)
    counts = {
        "requested": len(thread_ids),
        "skippedNamed": 0,
        "missingPrompt": 0,
        "missingTitle": 0,
        "generated": 0,
        "failed": 0,
    }
    request_id = 10
    for thread_id in thread_ids:
        try:
            canonical_id = str(uuid.UUID(thread_id))
            if canonical_id != thread_id.lower():
                continue

            prompt, cwd = thread_prompt(canonical_id)
            if not prompt:
                counts["missingPrompt"] += 1
                continue
            client.send_json(
                {
                    "method": "thread/read",
                    "id": request_id,
                    "params": {"threadId": canonical_id, "includeTurns": False},
                }
            )
            original = result_from(wait_for_response(client, request_id, 15))
            request_id += 1
            thread = original.get("thread")
            if not isinstance(thread, dict):
                continue
            current_name = thread.get("name")
            if isinstance(current_name, str) and current_name.strip():
                counts["skippedNamed"] += 1
                continue
            instruction = (
                "Create a concise UI title for this coding task. Return only JSON "
                "matching the provided schema. Use at most 36 characters and about "
                "five words. Start with an imperative verb, preserve ticket IDs, "
                "use the user's language, and omit ending punctuation.\n\n"
                f"User prompt:\n{prompt}"
            )
            client.send_json(
                {
                    "method": "thread/start",
                    "id": request_id,
                    "params": {
                        "model": "gpt-5.6-luna",
                        "cwd": cwd,
                        "approvalPolicy": "never",
                        "sandbox": "read-only",
                        "ephemeral": True,
                        "threadSource": "system",
                        "config": {
                            "model_reasoning_effort": "low",
                            "features.enable_fanout": False,
                            "features.hooks": False,
                            "features.multi_agent": False,
                            "features.multi_agent_v2": False,
                            "features.plugins": False,
                            "features.tool_suggest": False,
                            "web_search": "disabled",
                        },
                    },
                }
            )
            started = result_from(wait_for_response(client, request_id, 15))
            request_id += 1
            generated_thread = started.get("thread")
            if not isinstance(generated_thread, dict):
                continue
            generated_thread_id = generated_thread.get("id")
            if not isinstance(generated_thread_id, str):
                continue

            pending = []
            client.send_json(
                {
                    "method": "turn/start",
                    "id": request_id,
                    "params": {
                        "threadId": generated_thread_id,
                        "clientUserMessageId": str(uuid.uuid4()),
                        "input": [{"type": "text", "text": instruction}],
                        "outputSchema": {
                            "type": "object",
                            "properties": {
                                "title": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 36,
                                }
                            },
                            "required": ["title"],
                            "additionalProperties": False,
                        },
                    },
                }
            )
            turn_result = result_from(
                wait_for_response(client, request_id, 15, pending)
            )
            request_id += 1
            turn = turn_result.get("turn")
            turn_id = turn.get("id") if isinstance(turn, dict) else None
            if not isinstance(turn_id, str):
                continue

            message_text = ""
            completed = False
            deadline = time.monotonic() + 45
            while not completed:
                value = pending.pop(0) if pending else client.receive_json(deadline)
                method = value.get("method")
                params = value.get("params")
                if not isinstance(params, dict):
                    continue
                notification_thread_id = params.get("threadId")
                if (
                    isinstance(notification_thread_id, str)
                    and notification_thread_id != generated_thread_id
                ):
                    continue
                if method == "item/completed":
                    item = params.get("item")
                    if (
                        isinstance(item, dict)
                        and item.get("type") == "agentMessage"
                        and isinstance(item.get("text"), str)
                    ):
                        message_text = item["text"]
                elif method == "turn/completed":
                    completed_turn = params.get("turn")
                    if not isinstance(completed_turn, dict):
                        continue
                    if completed_turn.get("id") != turn_id:
                        continue
                    completed = completed_turn.get("status") == "completed"
                    if not completed:
                        break

            title = normalized_generated_title(message_text) if completed else ""
            if not title:
                counts["missingTitle"] += 1
                continue
            client.send_json(
                {
                    "method": "thread/name/set",
                    "id": request_id,
                    "params": {"threadId": canonical_id, "name": title},
                }
            )
            result_from(wait_for_response(client, request_id, 15))
            request_id += 1
            counts["generated"] += 1

            client.send_json(
                {
                    "method": "thread/unsubscribe",
                    "id": request_id,
                    "params": {"threadId": generated_thread_id},
                }
            )
            wait_for_response(client, request_id, 5)
            request_id += 1
        except (
            AttributeError,
            EOFError,
            OSError,
            RuntimeError,
            TimeoutError,
            TypeError,
            ValueError,
            json.JSONDecodeError,
            sqlite3.Error,
        ):
            counts["failed"] += 1
            continue
    print(json.dumps({"titleGeneration": counts}, separators=(",", ":")), flush=True)


def account_is_available(response):
    result = response.get("result")
    return isinstance(result, dict) and (
        isinstance(result.get("account"), dict)
        or result.get("requiresOpenaiAuth") is False
    )


def canonical_thread_id(value):
    if not isinstance(value, str):
        raise RuntimeError("Invalid Codex thread identifier.")
    canonical = str(uuid.UUID(value))
    if canonical != value:
        raise RuntimeError("Invalid Codex thread identifier.")
    return canonical


def normalized_thread(thread, expected_cwd=None, archived_override=None):
    if not isinstance(thread, dict):
        raise RuntimeError("Codex returned an invalid thread.")
    thread_id = canonical_thread_id(thread.get("id"))
    cwd = thread.get("cwd")
    if not isinstance(cwd, str) or not cwd:
        raise RuntimeError("Codex returned an invalid thread directory.")
    if expected_cwd is not None and (
        cwd != expected_cwd
        or os.path.realpath(cwd) != cwd
        or os.path.realpath(expected_cwd) != expected_cwd
    ):
        raise RuntimeError("The Codex thread belongs to another project.")
    name = thread.get("name")
    if name is not None and not isinstance(name, str):
        raise RuntimeError("Codex returned an invalid thread title.")
    if isinstance(name, str):
        name = name.strip().encode("utf-8")[:200].decode("utf-8", errors="ignore")
    updated_at = thread.get("updatedAt")
    if not isinstance(updated_at, int) or updated_at < 0:
        raise RuntimeError("Codex returned an invalid thread activity time.")
    archived = (
        archived_override
        if isinstance(archived_override, bool)
        else thread.get("archived")
    )
    if not isinstance(archived, bool):
        archived = False
    return {
        "provider": "codex",
        "threadID": thread_id,
        "title": name if name else None,
        "updatedAt": updated_at,
        "archived": archived,
        "capabilities": {
            "resume": not archived,
            "rename": not archived,
            "archive": not archived,
            "unarchive": archived,
        },
    }


def empty_indexed_threads(expected_cwd, archived):
    database = os.path.join(os.path.expanduser("~"), ".codex", "state_5.sqlite")
    if not os.path.isfile(database):
        return []
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        try:
            columns = {
                row[1] for row in connection.execute("pragma table_info(threads)")
            }
            required = {
                "id",
                "cwd",
                "title",
                "updated_at",
                "archived",
                "source",
                "preview",
            }
            if not required.issubset(columns):
                return []
            title_expression = (
                "coalesce(nullif(name, ''), nullif(title, ''))"
                if "name" in columns
                else "nullif(title, '')"
            )
            rows = connection.execute(
                f"""
                select id, cwd, {title_expression}, updated_at
                from threads
                where cwd = ?
                  and archived = ?
                  and preview = ''
                  and source in ('cli', 'vscode', 'exec', 'appServer')
                order by updated_at desc, id
                limit 100
                """,
                (expected_cwd, 1 if archived else 0),
            ).fetchall()
        finally:
            connection.close()
    except (OSError, sqlite3.Error):
        return []
    return [
        normalized_thread(
            {
                "id": thread_id,
                "cwd": cwd,
                "name": title,
                "updatedAt": updated_at,
            },
            expected_cwd,
            archived,
        )
        for thread_id, cwd, title, updated_at in rows
    ]


def print_thread_catalog(threads, next_cursor=None):
    print("__TERMINAL_RELAY_THREADS_V1__", flush=True)
    print(
        json.dumps(
            {"threads": threads, "nextCursor": next_cursor},
            separators=(",", ":"),
        ),
        flush=True,
    )


client = None
pending_login_id = None
login_completed = False


def interrupt_login(_signal_number, _frame):
    raise InterruptedError


try:
    client = WebSocket(socket_path)
    if mode == "ready":
        raise SystemExit(0)

    initialize(client)

    if mode == "account":
        client.send_json(
            {"method": "account/rateLimits/read", "id": 1, "params": None}
        )
        client.send_json(
            {
                "method": "account/read",
                "id": 2,
                "params": {"refreshToken": False},
            }
        )
        pending = {1, 2}
        deadline = time.monotonic() + 15
        while pending:
            response = client.receive_json(deadline)
            response_id = response.get("id")
            if response_id in (0, 1, 2):
                print(json.dumps(response, separators=(",", ":")), flush=True)
            if response_id in pending:
                pending.remove(response_id)
    elif mode == "require-account":
        client.send_json(
            {
                "method": "account/read",
                "id": 2,
                "params": {"refreshToken": False},
            }
        )
        response = wait_for_response(client, 2, 15)
        if not account_is_available(response):
            print(
                "Codex is not authenticated for this worker account. "
                "Sign in before opening a terminal.",
                file=sys.stderr,
            )
            raise SystemExit(77)
    elif mode == "reset":
        if not (1 <= len(arguments) <= 2):
            raise RuntimeError("Invalid Codex reset request.")
        params = {"idempotencyKey": arguments[0]}
        if len(arguments) == 2:
            params["creditId"] = arguments[1]
        client.send_json(
            {
                "method": "account/rateLimitResetCredit/consume",
                "id": 2,
                "params": params,
            }
        )
        response = wait_for_response(client, 2, 30)
        print(json.dumps(response, separators=(",", ":")), flush=True)
        if "error" in response:
            raise SystemExit(1)
    elif mode == "login":
        signal.signal(signal.SIGINT, interrupt_login)
        signal.signal(signal.SIGTERM, interrupt_login)
        signal.signal(signal.SIGHUP, interrupt_login)
        client.send_json(
            {
                "method": "account/login/start",
                "id": 1,
                "params": {"type": "chatgptDeviceCode"},
            }
        )
        response = wait_for_response(client, 1, 30)
        result = response.get("result")
        if not isinstance(result, dict):
            print("Codex could not start device authorization.", file=sys.stderr)
            raise SystemExit(77)
        pending_login_id = result.get("loginId")
        verification_url = result.get("verificationUrl")
        user_code = result.get("userCode")
        if not all(
            isinstance(value, str) and value
            for value in (pending_login_id, verification_url, user_code)
        ):
            print("Codex returned an invalid device authorization.", file=sys.stderr)
            raise SystemExit(77)
        print(f"Open {verification_url}", flush=True)
        print(f"Enter this one-time code: {user_code}", flush=True)

        deadline = time.monotonic() + 15 * 60
        while True:
            notification = client.receive_json(deadline)
            if notification.get("method") != "account/login/completed":
                continue
            params = notification.get("params")
            if not isinstance(params, dict) or params.get("loginId") != pending_login_id:
                continue
            login_completed = True
            if params.get("success") is True:
                print("Codex sign-in complete.", flush=True)
                break
            print("Codex sign-in was not completed.", file=sys.stderr)
            raise SystemExit(77)
    elif mode == "generate-titles":
        generate_titles(client, arguments)
    elif mode == "threads":
        if not (2 <= len(arguments) <= 3):
            raise RuntimeError("Invalid Codex thread list request.")
        cwd, archived_text, *cursor_values = arguments
        if archived_text not in ("0", "1"):
            raise RuntimeError("Invalid Codex archive filter.")
        params = {
            "cwd": cwd,
            "archived": archived_text == "1",
            "limit": 100,
            "sourceKinds": ["cli", "vscode", "exec", "appServer"],
        }
        if cursor_values and cursor_values[0]:
            params["cursor"] = cursor_values[0]
        client.send_json({"method": "thread/list", "id": 2, "params": params})
        result = result_from(wait_for_response(client, 2, 15))
        data = result.get("data")
        if not isinstance(data, list):
            raise RuntimeError("Codex returned an invalid thread list.")
        next_cursor = result.get("nextCursor")
        if next_cursor is not None and (
            not isinstance(next_cursor, str)
            or len(next_cursor.encode("utf-8")) > 2_048
            or "\n" in next_cursor
        ):
            raise RuntimeError("Codex returned an invalid thread cursor.")
        threads = [
            normalized_thread(thread, cwd, archived_text == "1")
            for thread in data
        ]
        if not cursor_values or not cursor_values[0]:
            known_ids = {thread["threadID"] for thread in threads}
            threads.extend(
                thread
                for thread in empty_indexed_threads(
                    cwd,
                    archived_text == "1",
                )
                if thread["threadID"] not in known_ids
            )
            threads.sort(key=lambda thread: (-thread["updatedAt"], thread["threadID"]))
        print_thread_catalog(threads, next_cursor)
    elif mode in ("thread-read", "thread-create"):
        if mode == "thread-read":
            if len(arguments) != 2:
                raise RuntimeError("Invalid Codex thread read request.")
            cwd, thread_id = arguments
            client.send_json(
                {
                    "method": "thread/read",
                    "id": 2,
                    "params": {
                        "threadId": canonical_thread_id(thread_id),
                        "includeTurns": False,
                    },
                }
            )
        else:
            if len(arguments) != 1:
                raise RuntimeError("Invalid Codex thread create request.")
            cwd = arguments[0]
            client.send_json(
                {
                    "method": "thread/start",
                    "id": 2,
                    "params": {"cwd": cwd},
                }
            )
        result = result_from(wait_for_response(client, 2, 15))
        print_thread_catalog(
            [
                normalized_thread(
                    result.get("thread"),
                    cwd,
                    False if mode == "thread-create" else None,
                )
            ]
        )
    elif mode in ("thread-rename", "thread-archive", "thread-unarchive"):
        expected_count = 3 if mode == "thread-rename" else 2
        if len(arguments) != expected_count:
            raise RuntimeError("Invalid Codex thread mutation request.")
        cwd, thread_id, *remaining = arguments
        canonical_id = canonical_thread_id(thread_id)
        try:
            client.send_json(
                {
                    "method": "thread/read",
                    "id": 2,
                    "params": {"threadId": canonical_id, "includeTurns": False},
                }
            )
            original = result_from(wait_for_response(client, 2, 15))
            normalized_thread(original.get("thread"), cwd)
        except RuntimeError:
            previously_archived = mode == "thread-unarchive"
            if canonical_id not in {
                thread["threadID"]
                for thread in empty_indexed_threads(cwd, previously_archived)
            }:
                raise
        method = {
            "thread-rename": "thread/name/set",
            "thread-archive": "thread/archive",
            "thread-unarchive": "thread/unarchive",
        }[mode]
        params = {"threadId": canonical_id}
        if mode == "thread-rename":
            params["name"] = remaining[0]
        client.send_json({"method": method, "id": 3, "params": params})
        mutation_response = wait_for_response(client, 3, 15)
        try:
            mutation = result_from(mutation_response)
        except RuntimeError:
            if mode != "thread-unarchive":
                raise
            mutation = {}
        archived_after_mutation = mode == "thread-archive"
        normalized = None
        if mode == "thread-unarchive":
            try:
                normalized = normalized_thread(mutation.get("thread"), cwd, False)
            except RuntimeError:
                pass
        else:
            try:
                client.send_json(
                    {
                        "method": "thread/read",
                        "id": 4,
                        "params": {
                            "threadId": canonical_id,
                            "includeTurns": False,
                        },
                    }
                )
                updated = result_from(wait_for_response(client, 4, 15))
                normalized = normalized_thread(
                    updated.get("thread"),
                    cwd,
                    archived_after_mutation,
                )
            except RuntimeError:
                pass
        if normalized is None:
            normalized = next(
                (
                    thread
                    for thread in empty_indexed_threads(
                        cwd,
                        archived_after_mutation,
                    )
                    if thread["threadID"] == canonical_id
                ),
                None,
            )
        if normalized is None:
            raise RuntimeError("Codex returned an invalid updated thread.")
        print_thread_catalog([normalized])
    else:
        raise RuntimeError("Unsupported Codex service operation.")
except InterruptedError:
    raise SystemExit(130)
except SystemExit:
    raise
except (
    AttributeError,
    EOFError,
    OSError,
    RuntimeError,
    TimeoutError,
    TypeError,
    ValueError,
    json.JSONDecodeError,
):
    print("Codex service is unavailable.", file=sys.stderr)
    raise SystemExit(70)
finally:
    if client is not None:
        if pending_login_id is not None and not login_completed:
            try:
                client.send_json(
                    {
                        "method": "account/login/cancel",
                        "id": 99,
                        "params": {"loginId": pending_login_id},
                    }
                )
            except (OSError, RuntimeError):
                pass
        client.close()
PYTHON_CODEX_RPC
}

codex_app_server_ready() {
    [[ -S "$codex_app_server_socket" ]] \
        && run_codex_rpc ready >/dev/null 2>&1
}

lock_codex_app_server() {
    require_flock
    exec 3>"$runtime_directory/codex-app-server.lock"
    "$flock_path" 3
}

unlock_codex_app_server() {
    exec 3>&-
}

schedule_codex_app_server_restart() {
    lock_codex_app_server || return $?

    if [[ -e "$codex_app_server_restart_marker" \
        || -L "$codex_app_server_restart_marker" ]]; then
        if [[ ! -f "$codex_app_server_restart_marker" \
            || -L "$codex_app_server_restart_marker" ]]; then
            unlock_codex_app_server
            echo "Codex app-server restart marker is not a safe file." >&2
            return 78
        fi
    elif ! /usr/bin/touch "$codex_app_server_restart_marker"; then
        unlock_codex_app_server
        echo "Unable to schedule the shared Codex account service restart." >&2
        return 70
    fi

    if ! /bin/chmod 600 "$codex_app_server_restart_marker"; then
        unlock_codex_app_server
        echo "Unable to secure the Codex app-server restart marker." >&2
        return 70
    fi
    unlock_codex_app_server
}

ensure_codex_app_server_locked() {
    local launch_file
    local launch_command
    local attempt
    local restart_required=0

    [[ -x "$codex_path" ]] || {
        echo "Required Codex executable is unavailable: $codex_path" >&2
        return 69
    }
    [[ -x "$tmux_path" ]] || {
        echo "Required tmux executable is unavailable: $tmux_path" >&2
        return 69
    }

    if [[ -e "$codex_app_server_restart_marker" \
        || -L "$codex_app_server_restart_marker" ]]; then
        if [[ ! -f "$codex_app_server_restart_marker" \
            || -L "$codex_app_server_restart_marker" ]]; then
            echo "Codex app-server restart marker is not a safe file." >&2
            return 78
        fi
        restart_required=1
    fi

    if [[ $restart_required -eq 1 ]] && any_tool_session_exists codex; then
        if codex_app_server_ready; then
            return 0
        fi
        echo "The shared Codex account service cannot be restarted while Codex terminals are active." >&2
        return 70
    fi

    if [[ $restart_required -eq 0 ]] && codex_app_server_ready; then
        return 0
    fi

    if tmux_command has-session -t "$codex_app_server_session" 2>/dev/null; then
        tmux_command kill-session -t "$codex_app_server_session" 2>/dev/null || true
    fi
    if [[ -e "$codex_app_server_socket" || -L "$codex_app_server_socket" ]]; then
        /bin/rm -f -- "$codex_app_server_socket"
    fi

    launch_file="$runtime_directory/codex-app-server.launch.$$.$RANDOM"
    {
        printf '#!/bin/bash\n'
        printf '/bin/rm -f -- %q\n' "$launch_file"
        printf 'export PATH=%q\n' "$default_safe_path"
        printf 'exec %q --config %q app-server --listen %q\n' \
            "$codex_path" \
            'mcp_servers.terminal_relay={command="/usr/local/bin/terminal-relay-mcp",enabled=true}' \
            "unix://$codex_app_server_socket"
    } > "$launch_file"
    /bin/chmod 700 "$launch_file"
    printf -v launch_command '%q' "$launch_file"
    if ! tmux_command new-session -d -s "$codex_app_server_session" \
        -c "${runtime_home:-${HOME:-/}}" "$launch_command"; then
        /bin/rm -f -- "$launch_file"
        echo "Unable to start the shared Codex account service." >&2
        return 70
    fi
    configure_tmux || true

    for attempt in $(seq 1 100); do
        if [[ -S "$codex_app_server_socket" ]]; then
            break
        fi
        if ! tmux_command has-session -t "$codex_app_server_session" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    if ! codex_app_server_ready; then
        tmux_command kill-session -t "$codex_app_server_session" 2>/dev/null || true
        /bin/rm -f -- "$codex_app_server_socket"
        echo "The shared Codex account service did not become ready." >&2
        return 70
    fi

    if [[ $restart_required -eq 1 ]] \
        && ! /bin/rm -f -- "$codex_app_server_restart_marker"; then
        echo "The shared Codex account service restarted, but its restart marker could not be cleared." >&2
        return 70
    fi
}

reserve_codex_account_server() {
    local status=0

    lock_codex_app_server || return $?
    ensure_codex_app_server_locked || {
