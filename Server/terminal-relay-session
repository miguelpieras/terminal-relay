emit_thread_catalog_v2() {
    local provider="$1"
    local repository="$2"
    local catalog="$3"
    local binding
    local chat_ready=0
    local -a python_arguments=("$provider")

    if chat_capability_json "$provider" >/dev/null 2>&1; then
        chat_ready=1
    fi
    python_arguments+=("chat-ready|$chat_ready")

    while IFS= read -r binding; do
        [[ -n "$binding" ]] && python_arguments+=("$binding")
    done < <(provider_active_bindings "$provider" "$repository")

    printf '%s\n' "$catalog" | "$default_python_path" -c '
import json
import sys

provider, readiness, *bindings = sys.argv[1:]
if readiness not in ("chat-ready|0", "chat-ready|1"):
    raise SystemExit(70)
chat_ready = readiness.endswith("|1")
maximum = 1024 * 1024
raw = sys.stdin.buffer.read(maximum + 1)
if len(raw) > maximum:
    raise SystemExit(70)
text = raw.decode("utf-8")
lines = text.splitlines()
if lines and lines[0] == "__TERMINAL_RELAY_THREADS_V1__":
    lines = lines[1:]
if len(lines) != 1:
    raise SystemExit(70)
value = json.loads(lines[0])
if not isinstance(value, dict) or not isinstance(value.get("threads"), list):
    raise SystemExit(70)
active = {}
for binding in bindings:
    fields = binding.split("|")
    if len(fields) != 3 or fields[2] not in ("terminal", "chat"):
        raise SystemExit(70)
    active[fields[0]] = (fields[1], fields[2])
for row in value["threads"]:
    if not isinstance(row, dict) or row.get("provider") != provider:
        raise SystemExit(70)
    thread_id = row.get("threadID")
    archived = row.get("archived")
    if not isinstance(thread_id, str) or not isinstance(archived, bool):
        raise SystemExit(70)
    activity = row.get("activityState", "inactive")
    if activity not in ("inactive", "relay-active", "external-active", "unknown"):
        raise SystemExit(70)
    if thread_id in active:
        activity = "relay-active"
        row["activeInstanceToken"] = active[thread_id][0]
        row["activePresentation"] = active[thread_id][1]
    else:
        row["activeInstanceToken"] = None
        row["activePresentation"] = None
    row["activityState"] = activity
    row["isWorking"] = row.get("isWorking")
    mutable = activity == "inactive"
    row["capabilities"] = {
        "resume": mutable and not archived,
        "rename": mutable and not archived,
        "archive": mutable and not archived,
        "unarchive": mutable and archived,
        "chat": chat_ready and mutable and not archived,
    }
encoded = json.dumps(value, separators=(",", ":"), ensure_ascii=False)
if len(encoded.encode("utf-8")) > maximum:
    raise SystemExit(70)
print("__TERMINAL_RELAY_THREADS_V2__")
print(encoded)
' "${python_arguments[@]}" || {
        echo "The provider session catalog is unavailable." >&2
        return 70
    }
}

threads_v2() {
