#!/usr/bin/bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: terminal-relay-session <codex|claude> [arguments...]" >&2
    exit 64
fi

tool="$1"
shift

case "$tool" in
    codex)
        executable="/usr/bin/codex"
        codex_arguments=("$@")
        for config_file in "/etc/codex/config.toml" "$HOME/.codex/config.toml" ".codex/config.toml"; do
            [[ -f "$config_file" ]] || continue
            while IFS= read -r mcp_server; do
                [[ -n "$mcp_server" && "$mcp_server" =~ ^[A-Za-z0-9_-]+$ ]] || continue
                codex_arguments+=(--config "mcp_servers.$mcp_server.enabled=false")
            done < <(
                /usr/bin/sed -n \
                    's/^[[:space:]]*\[mcp_servers\.\([A-Za-z0-9_-]*\)\][[:space:]]*$/\1/p' \
                    "$config_file"
            )
        done
        set -- "${codex_arguments[@]}"
        ;;
    claude)
        executable="/usr/bin/claude"
        ;;
    *)
        echo "unsupported tool: $tool" >&2
        exit 64
        ;;
esac

runtime_directory="/run/user/$(/usr/bin/id -u)/terminal-relay"
/usr/bin/install -d -m 700 "$runtime_directory"

lock_file="$runtime_directory/$tool.lock"
exec 9>"$lock_file"

if ! /usr/bin/flock --nonblock 9; then
    echo "A $tool session is already running on this server." >&2
    exit 75
fi

exec "$executable" "$@"
