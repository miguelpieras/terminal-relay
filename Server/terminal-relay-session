provider_active_bindings() {
    local requested_provider="$1"
    local requested_repository="$2"
    local metadata_file
    local instance
    local tool
    local chat_directory
    local chat_state
    local chat_fields

    shopt -s nullglob
    for metadata_file in "$runtime_directory"/*.session; do
        instance="${metadata_file##*/}"
        instance="${instance%.session}"
        is_valid_instance "$instance" || continue
        tool="$(/usr/bin/sed -n 's/^tool|//p' "$metadata_file")"
        [[ "$tool" == "$requested_provider" ]] || continue
        lock_tool_metadata "$instance"
        if load_metadata_unlocked "$tool" "$instance" \
            && [[ "$metadata_repository" == "$requested_repository" ]] \
            && is_valid_instance "$metadata_thread_id" \
            && { session_exists "$tool" "$instance" \
                || metadata_launch_is_running "$instance"; }; then
            printf '%s|%s|terminal\n' "$metadata_thread_id" "$instance"
        fi
        unlock_tool_metadata
    done
    for chat_directory in "$runtime_directory"/chat-*; do
        [[ -d "$chat_directory" && ! -L "$chat_directory" ]] || continue
        instance="${chat_directory##*/chat-}"
        is_valid_instance "$instance" || continue
        chat_state="$("$default_python_path" "$chat_path" inspect \
            --runtime-directory "$runtime_directory" \
            --relay-id "$instance" 2>/dev/null)" || continue
        chat_fields="$("$default_python_path" - "$chat_state" \
            "$requested_provider" "$requested_repository" <<'PYTHON_CHAT_BINDING'
import json
import re
import sys

try:
    value = json.loads(sys.argv[1])
except ValueError:
    raise SystemExit(70)
pattern = re.compile(
