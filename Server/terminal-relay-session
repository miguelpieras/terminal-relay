if [[ "$codex_shared_account_enabled" == "1" ]]; then
    codex_socket_bytes="$(printf '%s' "$codex_app_server_socket" | /usr/bin/wc -c | /usr/bin/tr -d '[:space:]')"
    if [[ ! "$codex_socket_bytes" =~ ^[0-9]+$ || $codex_socket_bytes -gt 100 ]]; then
        echo "Codex app-server socket path is too long: $codex_app_server_socket" >&2
        exit 78
