                raw_columns = [
                    column
                    for column in ("title", "preview", "first_user_message")
                    if column in columns
                ]
                where = " or ".join(f"trim({column}) = ?" for column in raw_columns)
                rows = connection.execute(
                    f"select id, {', '.join(selected)} from threads where {where}",
                    tuple(display_title for _ in raw_columns),
                ).fetchall() if raw_columns else []
            for row in rows:
                values = dict(zip(selected, row[1:]))
                raw_prompt = next(
                    (
                        values[column].strip()
                        for column in ("first_user_message", "preview")
                        if isinstance(values.get(column), str)
                        and values[column].strip()
                    ),
                    "",
                )
                database_title = values.get("title")
                if not isinstance(database_title, str):
                    database_title = ""
                database_title = database_title.strip()
                if (
                    not match
                    and display_title
                    not in (
                        raw_prompt,
                        database_title,
                        persisted_names.get(row[0], ""),
                    )
                ):
                    continue
                database_name = values.get("name")
                if not isinstance(database_name, str):
                    database_name = ""
                candidates.append(
                    (
                        row[0],
                        raw_prompt,
                        database_title,
                        persisted_names.get(row[0], "") or database_name.strip(),
                    )
                )
        connection.close()
    except (OSError, sqlite3.Error):
        pass

    if match:
        resolved_thread_id = match.group(0)
    elif len(candidates) == 1:
        resolved_thread_id = candidates[0][0]
    elif len(persisted_match_ids) == 1:
        resolved_thread_id = persisted_match_ids[0]

    saved_titles = [name for _, _, _, name in candidates if name]
    if saved_titles:
        title = saved_titles[0]
    elif candidates:
        _, raw_prompt, database_title, _ = candidates[0]
        title = database_title or raw_prompt or display_title
        needs_generation = bool(raw_prompt)
    elif match:
        title = persisted_names.get(resolved_thread_id, "") or display_title
    else:
        title = display_title
title = "".join(character if character.isprintable() else " " for character in title)
title = re.sub(r"\s+", " ", title).strip()
print(title[:200])
print("1" if needs_generation else "0")
print(resolved_thread_id)
PYTHON_TITLE
        return
    fi
    fallback_title="$(printf '%s\n' "$pane_title" \
        | /usr/bin/tr '\r\n' '  ' \
        | /usr/bin/cut -c1-200)"
    printf '%s\n0\n\n' "$fallback_title"
}

session_display_fields() {
    local tool="$1"
    local instance="$2"
    local repository="${3:-}"
    local provider_thread_id="${4:-}"
    local session_name
    local display
    local pane_title
    local resolved_title_fields
    local resolved_title
    local resolved_generation
    local resolved_thread_id

    session_activity=0
    session_title_hex=""
    session_working=""
    session_thread_id=""
    session_needs_title_generation=0
    session_name="$(session_name_for "$tool" "$instance")"
    display="$(tmux_command display-message -p -t "$session_name" \
        '#{window_activity}|#{pane_title}' 2>/dev/null)" || return 1
    session_activity="${display%%|*}"
    pane_title="${display#*|}"
    [[ "$session_activity" =~ ^[0-9]+$ ]] || session_activity=0
    if [[ "$tool" == "codex" ]]; then
        if [[ "$pane_title" =~ ([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}) ]]; then
            session_thread_id="$(printf '%s' "${BASH_REMATCH[1]}" \
                | /usr/bin/tr '[:upper:]' '[:lower:]')"
        fi
        case "$pane_title" in
            *" | Ready") session_working=0 ;;
            *" | Working"|*" | Thinking"|*" | Waiting"|*" | Starting")
                session_working=1
                ;;
        esac
    elif is_valid_instance "$provider_thread_id"; then
        session_thread_id="$provider_thread_id"
    fi
    resolved_title_fields="$(resolve_session_title \
        "$tool" "$instance" "$pane_title" "$repository" "$provider_thread_id")"
    resolved_title="$(printf '%s\n' "$resolved_title_fields" | /usr/bin/sed -n '1p')"
    resolved_generation="$(printf '%s\n' "$resolved_title_fields" | /usr/bin/sed -n '2p')"
    resolved_thread_id="$(printf '%s\n' "$resolved_title_fields" | /usr/bin/sed -n '3p')"
    if [[ "$resolved_generation" == "1" ]]; then
        session_needs_title_generation=1
    fi
    if [[ -z "$session_thread_id" ]] && is_valid_instance "$resolved_thread_id"; then
        session_thread_id="$resolved_thread_id"
    fi
    session_title_hex="$(encode_argument_hex "$resolved_title")"
}

