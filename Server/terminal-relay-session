attach_instance_session() {
    local tool="$1"
    local repository="$2"
    shift 2
    local metadata_file
    local candidate
    local candidate_tool
    local start_output
    local instance=""

    validate_tool "$tool"
    validate_launch_arguments "$tool" "$@" || exit $?
    project_directory_for "$repository" >/dev/null || exit $?

    shopt -s nullglob
    for metadata_file in "$runtime_directory"/*.session; do
        candidate="${metadata_file##*/}"
        candidate="${candidate%.session}"
        is_valid_instance "$candidate" || continue
        candidate_tool="$(/usr/bin/sed -n 's/^tool|//p' "$metadata_file")"
        [[ "$candidate_tool" == "$tool" ]] || continue
        lock_tool_control "$candidate"
        lock_tool_metadata "$candidate"
        if load_metadata_unlocked "$tool" "$candidate" \
            && [[ "$metadata_repository" == "$repository" ]] \
            && session_exists "$tool" "$candidate"; then
            instance="$candidate"
        fi
        unlock_tool_metadata
        unlock_tool_control
        [[ -z "$instance" ]] || break
    done
    shopt -u nullglob

    if [[ -z "$instance" ]]; then
        start_output="$(start_instance_session "$tool" "$repository" "$@")" || exit $?
        instance="$(printf '%s\n' "$start_output" | /usr/bin/awk -F'|' \
            '$1 == "session" { print $5; exit }')"
        is_valid_instance "$instance" || {
            echo "The worker returned an invalid new $tool terminal instance." >&2
            exit 70
        }
    fi
    reattach_instance_session "$tool" "$repository" "$instance"
}

