list_projects() {
    local project_directory
    local repository
    local -a repositories=()

    printf '%s\n' "$protocol_marker"
    if [[ ! -d "$workspace_root" ]]; then
        echo "Workspace root does not exist: $workspace_root" >&2
        return 66
    fi

    shopt -s nullglob dotglob
    for project_directory in "$workspace_root"/*; do
        [[ -d "$project_directory" && ! -L "$project_directory" ]] || continue
        repository="${project_directory##*/}"
        is_valid_repository_name "$repository" || continue
        repositories+=("$repository")
    done
    shopt -u nullglob dotglob

    if [[ ${#repositories[@]} -gt 0 ]]; then
        printf 'project|%s\n' "${repositories[@]}" | LC_ALL=C /usr/bin/sort
    fi
}

validate_thread_id() {
    is_valid_instance "$1" || fail_usage "Invalid provider thread identifier."
}

validate_thread_name() {
    local name="$1"
    local name_bytes
    name_bytes="$(printf '%s' "$name" | /usr/bin/wc -c | /usr/bin/tr -d '[:space:]')"
    [[ -n "$name" && "$name" != *$'\n'* && "$name_bytes" =~ ^[0-9]+$ \
        && $name_bytes -le 200 ]] || fail_usage "Invalid provider thread name."
}

thread_is_active() {
    local requested_provider="$1"
    local requested_thread_id="$2"
    local metadata_file
    local instance
    local tool

    shopt -s nullglob
    for metadata_file in "$runtime_directory"/*.session; do
        instance="${metadata_file##*/}"
        instance="${instance%.session}"
        is_valid_instance "$instance" || continue
        tool="$(/usr/bin/sed -n 's/^tool|//p' "$metadata_file")"
        [[ "$tool" == "$requested_provider" ]] || continue
        lock_tool_metadata "$instance"
        if load_metadata_unlocked "$tool" "$instance" \
            && [[ "$metadata_thread_id" == "$requested_thread_id" ]] \
            && { session_exists "$tool" "$instance" \
                || metadata_launch_is_running "$instance"; }; then
            unlock_tool_metadata
            shopt -u nullglob
            return 0
        fi
        unlock_tool_metadata
    done
    shopt -u nullglob
    return 1
}

record_thread_binding() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local thread_id="$4"

    is_valid_instance "$thread_id" || return 0
    lock_tool_metadata "$instance"
    if load_metadata_unlocked "$tool" "$instance" \
        && [[ "$metadata_repository" == "$repository" ]] \
        && [[ -z "$metadata_thread_id" ]]; then
        write_metadata_unlocked "$tool" "$repository" "$instance" \
            "$metadata_pid" "$metadata_start" "$thread_id"
        if load_intent_unlocked "$tool" "$instance" \
            && [[ "$intent_repository" == "$repository" \
                && "$intent_instance" == "$instance" ]]; then
            write_thread_intent_unlocked "$tool" "$repository" "$instance" \
                "$intent_boot_id" "$thread_id" "${intent_arguments[@]}"
        fi
    fi
    unlock_tool_metadata
}

codex_threads() {
    local repository="$1"
