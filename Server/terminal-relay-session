    local -a repositories=()

    printf '%s\n' "$protocol_marker"
    if [[ ! -d "$workspace_root" ]]; then
        echo "Workspace root does not exist: $workspace_root" >&2
        return 66
    fi

    shopt -s nullglob dotglob
    for project_directory in "$workspace_root"/*; do
        [[ -d "$project_directory" && ! -L "$project_directory" ]] || continue
        repository="${project_directory##*/}"
        is_valid_repository_name "$repository" || continue
        repositories+=("$repository")
    done
    shopt -u nullglob dotglob

    if [[ ${#repositories[@]} -gt 0 ]]; then
        printf 'project|%s\n' "${repositories[@]}" | LC_ALL=C /usr/bin/sort
    fi
}

system_resources() {
    local cpu_before
    local cpu_after
    local cpu_total_before
    local cpu_idle_before
    local cpu_total_after
    local cpu_idle_after
    local cpu_total
    local cpu_idle
    local cpu_used
    local memory_total
    local memory_available
    local disk_total
    local disk_used

    read_cpu_sample() {
        /usr/bin/awk '
            $1 == "cpu" {
                total = 0
                for (field = 2; field <= 9; field += 1) total += $field
                print total, $5 + $6
                exit
            }
        ' /proc/stat
    }

    cpu_before="$(read_cpu_sample)"
    /bin/sleep 1
    cpu_after="$(read_cpu_sample)"
    read -r cpu_total_before cpu_idle_before <<< "$cpu_before"
    read -r cpu_total_after cpu_idle_after <<< "$cpu_after"
    cpu_total=$((cpu_total_after - cpu_total_before))
    cpu_idle=$((cpu_idle_after - cpu_idle_before))
    cpu_used=$((cpu_total - cpu_idle))

    read -r memory_total memory_available < <(
        /usr/bin/awk '
            $1 == "MemTotal:" { total = $2 }
            $1 == "MemAvailable:" { available = $2 }
            END {
                if (total > 0 && available >= 0 && available <= total) {
                    print total, available
                }
            }
        ' /proc/meminfo
    )
    read -r disk_total disk_used < <(
        /bin/df -Pk / | /usr/bin/awk 'NR == 2 { print $2, $3 }'
    )

    [[ "$cpu_total" -gt 0 \
        && "$cpu_idle" -ge 0 \
        && "$cpu_idle" -le "$cpu_total" \
        && "$memory_total" -gt 0 \
        && "$memory_available" -ge 0 \
        && "$memory_available" -le "$memory_total" \
        && "$disk_total" -gt 0 \
        && "$disk_used" -ge 0 \
        && "$disk_used" -le "$disk_total" ]] || {
        echo "Worker resource usage is unavailable." >&2
        return 70
    }

    printf '%s\n' '__TERMINAL_RELAY_METRICS_V1__'
    printf 'cpu|%s|%s\n' "$cpu_used" "$cpu_total"
    printf 'memory|%s|%s\n' "$memory_total" "$memory_available"
    printf 'disk|%s|%s\n' "$disk_total" "$disk_used"
}

claude_account() {
    cd "${runtime_home:-${HOME:?HOME is required}}" || return 1
    printf '%s\n' '__TERMINAL_RELAY_CLAUDE_AUTH__'
    "$claude_path" auth status --json 2>/dev/null || true
    printf '%s\n' '__TERMINAL_RELAY_CLAUDE_USAGE__'
    if [[ -x /usr/bin/timeout ]]; then
        DISABLE_AUTOUPDATER=1 /usr/bin/timeout 20s "$claude_path" \
            -p '/usage' \
            --output-format text \
            --no-session-persistence \
            --safe-mode \
            --tools ''
    elif [[ $test_mode -eq 1 ]]; then
        DISABLE_AUTOUPDATER=1 "$claude_path" \
            -p '/usage' \
            --output-format text \
            --no-session-persistence \
            --safe-mode \
            --tools ''
    else
        echo "The worker timeout command is unavailable." >&2
        return 69
    fi
}

agent_update_status() {
    local expected_owner=0
    local file_identity
    local -a lines=()
    local record_type
    local timestamp
    local result
    local codex_version
    local claude_version
    local extra
    local line

    printf '%s\n' "$agent_update_protocol_marker"
    [[ -e "$agent_update_status_path" || -L "$agent_update_status_path" ]] || return 0
    [[ -f "$agent_update_status_path" && ! -L "$agent_update_status_path" ]] || {
        echo "The agent update status is not a regular file." >&2
        return 70
    }
    [[ $test_mode -eq 0 ]] || expected_owner="$user_id"
    file_identity="$(path_uid_mode "$agent_update_status_path")" || {
        echo "The agent update status cannot be inspected." >&2
        return 70
    }
    [[ "$file_identity" == "$expected_owner:644" ]] || {
        echo "The agent update status has unsafe ownership or permissions." >&2
        return 70
    }

    while IFS= read -r line || [[ -n "$line" ]]; do
        lines+=("$line")
    done < "$agent_update_status_path"
    [[ ${#lines[@]} -eq 2 && "${lines[0]}" == "$agent_update_protocol_marker" ]] || {
        echo "The agent update status is malformed." >&2
        return 70
    }
    IFS='|' read -r record_type timestamp result codex_version claude_version extra \
        <<< "${lines[1]}"
    [[ "$record_type" == "update" \
        && "$timestamp" =~ ^[1-9][0-9]*$ \
        && "$result" =~ ^(success|failure)$ \
        && "$codex_version" =~ ^(unknown|[A-Za-z0-9][A-Za-z0-9._+-]{0,63})$ \
        && "$claude_version" =~ ^(unknown|[A-Za-z0-9][A-Za-z0-9._+-]{0,63})$ \
        && -z "${extra:-}" ]] || {
        echo "The agent update status is malformed." >&2
        return 70
    }
    printf '%s\n' "${lines[1]}"
}

resolve_session_title() {
    local tool="$1"
    local instance="$2"
    local pane_title="$3"
    local home_directory="${runtime_home:-${HOME:-}}"

    if [[ -x "$default_python_path" ]]; then
        "$default_python_path" - "$tool" "$instance" "$pane_title" "$home_directory" <<'PYTHON_TITLE'
import glob
import json
import os
import re
import sqlite3
import sys

tool, instance, pane_title, home = sys.argv[1:]
title = ""
if tool == "codex":
    display_title = re.sub(
        r"\s+\|\s+(Ready|Working|Thinking|Waiting|Starting)\s*$",
        "",
        pane_title,
    ).strip()
    match = re.search(
        r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
        display_title.lower(),
    )
    if match:
        database = os.path.join(home, ".codex", "state_5.sqlite")
        try:
            connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
            columns = {
                row[1] for row in connection.execute("pragma table_info(threads)")
            }
            title_column = "name" if "name" in columns else "title"
            row = connection.execute(
                f"select {title_column} from threads where id = ? limit 1",
                (match.group(0),),
            ).fetchone()
            connection.close()
            if row and isinstance(row[0], str):
                title = row[0]
        except (OSError, sqlite3.Error):
            pass
    else:
        title = display_title
elif tool == "claude":
    custom_title = ""
    ai_title = ""
    candidates = glob.glob(
        os.path.join(home, ".claude", "projects", "**", f"{instance}.jsonl"),
        recursive=True,
    )
    if candidates:
        try:
            with open(candidates[0], encoding="utf-8") as history:
                for line in history:
                    try:
                        record = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if record.get("type") == "custom-title":
                        custom = record.get("customTitle")
                        if isinstance(custom, str) and custom.strip():
                            custom_title = custom
                    elif record.get("type") == "ai-title":
                        generated = record.get("aiTitle")
                        if isinstance(generated, str) and generated.strip():
                            ai_title = generated
                title = custom_title or ai_title
        except OSError:
            pass

title = "".join(character if character.isprintable() else " " for character in title)
title = re.sub(r"\s+", " ", title).strip()
print(title[:200])
PYTHON_TITLE
        return
    fi
    printf '%s\n' "$pane_title" | /usr/bin/tr '\r\n' '  ' | /usr/bin/cut -c1-200
}

session_display_fields() {
    local tool="$1"
    local instance="$2"
    local session_name
    local display
    local pane_title

    session_activity=0
    session_title_hex=""
    session_working=""
    session_thread_id=""
    session_name="$(session_name_for "$tool" "$instance")"
    display="$(tmux_command display-message -p -t "$session_name" \
        '#{window_activity}|#{pane_title}' 2>/dev/null)" || return 1
    session_activity="${display%%|*}"
    pane_title="${display#*|}"
    [[ "$session_activity" =~ ^[0-9]+$ ]] || session_activity=0
    if [[ "$tool" == "codex" ]]; then
        if [[ "$pane_title" =~ ([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}) ]]; then
            session_thread_id="$(printf '%s' "${BASH_REMATCH[1]}" \
                | /usr/bin/tr '[:upper:]' '[:lower:]')"
        fi
        case "$pane_title" in
            *" | Ready") session_working=0 ;;
            *" | Working"|*" | Thinking"|*" | Waiting"|*" | Starting")
                session_working=1
                ;;
        esac
    else
        session_thread_id="$instance"
    fi
    session_title_hex="$(encode_argument_hex "$(resolve_session_title "$tool" "$instance" "$pane_title")")"
}

status_sessions() {
    local metadata_file
    local instance
    local tool
    local repository
    local session_name
    local attached_client_count
    local boot_id
    local intent_status
    local -a records=()

    [[ -x "$tmux_path" ]] || {
        echo "Required tmux executable is unavailable: $tmux_path" >&2
        return 69
    }
    require_flock
    boot_id="$(current_boot_id)" || {
        echo "Unable to read the worker boot identity from $boot_id_path." >&2
        return 69
    }

    shopt -s nullglob
    for metadata_file in "$runtime_directory"/*.session; do
        instance="${metadata_file##*/}"
        instance="${instance%.session}"
        is_valid_instance "$instance" || continue
        tool="$(/usr/bin/sed -n 's/^tool|//p' "$metadata_file")"
        validate_tool "$tool"

        lock_tool_control "$instance"
        lock_tool_metadata "$instance"
        if ! load_metadata_unlocked "$tool" "$instance"; then
            unlock_tool_metadata
            unlock_tool_control
            echo "The saved terminal metadata for '$instance' is invalid." >&2
            return 70
        fi
        repository="$metadata_repository"
        session_name="$(session_name_for "$tool" "$instance")"
        if session_exists "$tool" "$instance"; then
            if ! attached_client_count="$(tmux_command display-message -p -t "$session_name" \
                '#{session_attached}' 2>/dev/null)"; then
                attached_client_count=0
            fi
        elif metadata_launch_is_running "$instance"; then
            attached_client_count=0
        else
            remove_metadata_unlocked "$instance"
            intent_status=0
            prune_dead_same_boot_intent_unlocked "$tool" "$instance" "$boot_id" \
                || intent_status=$?
            unlock_tool_metadata
            unlock_tool_control
            if [[ $intent_status -ne 0 ]]; then
                echo "The saved $tool restart intent for '$instance' is invalid." >&2
                return "$intent_status"
            fi
            continue
        fi
        unlock_tool_metadata
        unlock_tool_control

        [[ "$attached_client_count" =~ ^[0-9]+$ ]] || {
            echo "tmux returned an invalid attached-client count for $tool." >&2
            return 70
        }
        if ! session_display_fields "$tool" "$instance"; then
            session_activity=0
            session_title_hex=""
            session_working=""
            session_thread_id=""
        fi
        records+=("session|$tool|$repository|$attached_client_count|$instance|$session_activity|$session_title_hex|$session_working|$session_thread_id")
    done
    shopt -u nullglob

    printf '%s\n' "$protocol_marker"
    if [[ ${#records[@]} -gt 0 ]]; then
        printf '%s\n' "${records[@]}" | LC_ALL=C /usr/bin/sort
    fi
}

wait_for_recorded_pid() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local attempt

    stop_pid=0
    stop_start="pending"
    for attempt in $(seq 1 40); do
        lock_tool_metadata "$instance"
        if ! load_metadata_unlocked "$tool" "$instance"; then
            unlock_tool_metadata
            return 75
        fi
        if [[ "$metadata_repository" != "$repository" \
            || "$metadata_instance" != "$instance" ]]; then
            unlock_tool_metadata
            return 75
        fi
        stop_pid="$metadata_pid"
        stop_start="$metadata_start"
        unlock_tool_metadata
        [[ "$stop_pid" != "0" ]] && return 0
        session_exists "$tool" "$instance" || return 0
        sleep 0.05
    done
    return 0
}

wait_for_launch_end() {
    local instance="$1"
    local pid="$2"
    local start="$3"
    local attempts="$4"
    local attempt

    attempt=0
    while [[ $attempt -lt $attempts ]]; do
        attempt=$((attempt + 1))
        if { [[ "$pid" == "0" ]] || ! process_matches "$pid" "$start"; } \
            && agent_lock_is_free "$instance"; then
            return 0
        fi
        sleep 0.1
    done
    return 1
}

terminate_launch() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local session_name
    local signal_status

    if ! wait_for_recorded_pid "$tool" "$repository" "$instance"; then
        return 75
    fi
    require_lifetime_signal_support || return $?

    session_name="$(session_name_for "$tool" "$instance")"
    if session_exists "$tool" "$instance"; then
        if ! tmux_command kill-session -t "$session_name" 2>/dev/null \
            && session_exists "$tool" "$instance"; then
            return 70
        fi
    fi

    if ! wait_for_launch_end "$instance" "$stop_pid" "$stop_start" 20; then
        if [[ "$stop_pid" != "0" ]]; then
            signal_status=0
            signal_recorded_process "$stop_pid" "$stop_start" TERM || signal_status=$?
            case "$signal_status" in
                0|75) ;;
                *) return 70 ;;
            esac
        fi
        if ! wait_for_launch_end "$instance" "$stop_pid" "$stop_start" 20; then
            if [[ "$stop_pid" != "0" ]]; then
                signal_status=0
                signal_recorded_process "$stop_pid" "$stop_start" KILL || signal_status=$?
                case "$signal_status" in
                    0|75) ;;
                    *) return 70 ;;
                esac
            fi
            wait_for_launch_end "$instance" "$stop_pid" "$stop_start" 30 || return 70
        fi
    fi

    if session_exists "$tool" "$instance"; then
        tmux_command kill-session -t "$session_name" 2>/dev/null || true
        session_exists "$tool" "$instance" && return 70
    fi

    lock_tool_metadata "$instance"
    if ! load_metadata_unlocked "$tool" "$instance" \
        || [[ "$metadata_repository" != "$repository" \
            || "$metadata_instance" != "$instance" ]]; then
        unlock_tool_metadata
        return 75
    fi
    remove_metadata_unlocked "$instance"
    unlock_tool_metadata
}

restore_sessions() {
    local boot_id
    local tool
    local intent_file
    local stopping_file
    local instance
    local load_status
    local project_directory
    local repository
    local launch_file
    local launch_command
    local session_name
    local overall_status=0
    local codex_app_server_reserved=0

    [[ -x "$tmux_path" ]] || {
        echo "Required tmux executable is unavailable: $tmux_path" >&2
        return 69
    }
    require_flock
    require_lifetime_signal_support || return $?
    boot_id="$(current_boot_id)" || {
        echo "Unable to read the worker boot identity from $boot_id_path." >&2
        return 69
    }

    shopt -s nullglob
    for stopping_file in "$runtime_directory"/*.intent.stopping; do
        instance="${stopping_file##*/}"
        instance="${instance%.intent.stopping}"
        is_valid_instance "$instance" || continue
        tool="$(/usr/bin/sed -n 's/^tool|//p' "$stopping_file")"
        validate_tool "$tool"
        lock_tool_control "$instance"
        lock_tool_metadata "$instance"
        if ! load_intent_path_unlocked "$tool" "$stopping_file"; then
            echo "The saved $tool stop transition for '$instance' is invalid." >&2
            overall_status=70
        else
            remove_metadata_unlocked "$instance"
            /bin/rm -f -- "$stopping_file"
        fi
        unlock_tool_metadata
        unlock_tool_control
    done

    for intent_file in "$runtime_directory"/*.intent; do
        codex_app_server_reserved=0
        instance="${intent_file##*/}"
        instance="${instance%.intent}"
        is_valid_instance "$instance" || continue
        tool="$(/usr/bin/sed -n 's/^tool|//p' "$intent_file")"
        validate_tool "$tool"
        lock_tool_control "$instance"
        lock_tool_metadata "$instance"

        set +e
        load_intent_path_unlocked "$tool" "$intent_file"
        load_status=$?
        set -e
        if [[ $load_status -ne 0 || "$intent_instance" != "$instance" ]]; then
            unlock_tool_metadata
            unlock_tool_control
            echo "The saved $tool restart intent for '$instance' is invalid; recovery was skipped." >&2
            overall_status=70
            continue
        fi
        if [[ "$intent_boot_id" == "$boot_id" ]]; then
            unlock_tool_metadata
            unlock_tool_control
            continue
        fi

        repository="$intent_repository"
        if ! project_directory="$(project_directory_for "$repository")"; then
            unlock_tool_metadata
            unlock_tool_control
            echo "The saved $tool launch cannot be restored because its repository is unavailable." >&2
            overall_status=66
            continue
        fi
        if [[ "$tool" == "claude" ]]; then
            set +e
            prepare_claude_onboarding
            load_status=$?
            set -e
            if [[ $load_status -ne 0 ]]; then
                unlock_tool_metadata
                unlock_tool_control
                overall_status="$load_status"
                continue
            fi
        elif [[ "$codex_shared_account_enabled" == "1" ]]; then
            load_status=0
            reserve_codex_account_server || load_status=$?
            if [[ $load_status -ne 0 ]]; then
                unlock_tool_metadata
                unlock_tool_control
                overall_status="$load_status"
                continue
            fi
            codex_app_server_reserved=1
            pause_after_codex_reservation_for_test || load_status=$?
            if [[ $load_status -ne 0 ]]; then
                unlock_codex_app_server
                unlock_tool_metadata
                unlock_tool_control
                overall_status="$load_status"
                continue
            fi
        fi
        if session_exists "$tool" "$instance" || {
            load_metadata_unlocked "$tool" "$instance" \
                && metadata_launch_is_running "$instance";
        }; then
            if [[ $codex_app_server_reserved -eq 1 ]]; then
                unlock_codex_app_server
            fi
            unlock_tool_metadata
            unlock_tool_control
            continue
        fi

        remove_metadata_unlocked "$instance"
        write_metadata_unlocked "$tool" "$repository" "$instance" 0 pending
        if ! write_intent_unlocked \
            "$tool" "$repository" "$instance" "$boot_id" "${intent_arguments[@]}"; then
            remove_metadata_unlocked "$instance"
            unlock_tool_metadata
            if [[ $codex_app_server_reserved -eq 1 ]]; then
                unlock_codex_app_server
            fi
            unlock_tool_control
            echo "Unable to advance the saved $tool restart intent." >&2
            overall_status=70
            continue
        fi
        unlock_tool_metadata

        session_name="$(session_name_for "$tool" "$instance")"
        launch_file="$runtime_directory/$instance.restore.$$.$RANDOM"
        write_launch_script \
            "$launch_file" "$tool" "$repository" "$instance" resume "${intent_arguments[@]}"
        printf -v launch_command '%q' "$launch_file"
        if ! tmux_command new-session -d -s "$session_name" -c "$project_directory" "$launch_command"; then
            /bin/rm -f -- "$launch_file"
            lock_tool_metadata "$instance"
            remove_metadata_unlocked "$instance"
            remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
            unlock_tool_metadata
            if [[ $codex_app_server_reserved -eq 1 ]]; then
                unlock_codex_app_server
            fi
            unlock_tool_control
            echo "Unable to recreate the $tool tmux session during recovery." >&2
            overall_status=70
            continue
        fi
        if [[ $codex_app_server_reserved -eq 1 ]]; then
            unlock_codex_app_server
        fi
        if ! configure_tmux || ! session_exists "$tool" "$instance"; then
            terminate_launch "$tool" "$repository" "$instance" || true
            lock_tool_metadata "$instance"
            remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
            unlock_tool_metadata
            unlock_tool_control
            echo "The restored $tool launch ended before recovery completed." >&2
            overall_status=70
            continue
        fi
        unlock_tool_control
        printf 'Restored %s session %s for repository %s.\n' "$tool" "$instance" "$repository"
    done
    shopt -u nullglob

    return "$overall_status"
}

start_session() {
    local tool="$1"
    local repository="$2"
    shift 2
    local project_directory
    local session_name
    local instance
    local launch_file
    local launch_command
    local attached_client_count
    local created_session=0
    local metadata_present=0
    local active_repository=""
    local active_instance=""
    local boot_id
    local intent_status

    validate_tool "$tool"
    validate_launch_arguments "$tool" "$@" || exit $?
    boot_id="$(current_boot_id)" || {
        echo "Unable to read the worker boot identity from $boot_id_path." >&2
        exit 69
    }
    project_directory="$(project_directory_for "$repository")" || exit $?
    [[ -x "$tmux_path" ]] || { echo "Required tmux executable is unavailable: $tmux_path" >&2; exit 69; }
    require_flock
    require_lifetime_signal_support || exit $?

    lock_tool_control "$tool"
    lock_tool_metadata "$tool"
    if load_metadata_unlocked "$tool"; then
        metadata_present=1
    fi

    if [[ $metadata_present -eq 1 ]] && session_exists "$tool" "$metadata_instance"; then
        if [[ "$metadata_repository" != "$repository" ]]; then
            active_repository="$metadata_repository"
            unlock_tool_metadata
            unlock_tool_control
            echo "A $tool session is already running for repository '$active_repository'; requested '$repository'." >&2
            exit 75
        fi
        instance="$metadata_instance"
        session_name="$(session_name_for "$tool" "$instance")"
        unlock_tool_metadata
    else
        if any_tool_session_exists "$tool"; then
            active_repository="${metadata_repository:-unknown}"
            unlock_tool_metadata
            unlock_tool_control
            echo "A $tool tmux session is already running with inconsistent launch metadata for repository '$active_repository'." >&2
            exit 75
        fi
        if [[ $metadata_present -eq 1 ]] && metadata_launch_is_running "$tool"; then
            active_repository="$metadata_repository"
            active_instance="$metadata_instance"
            unlock_tool_metadata
            unlock_tool_control
            echo "A $tool launch '$active_instance' for repository '$active_repository' is still running without an attachable tmux session." >&2
            exit 75
        fi

        remove_metadata_unlocked "$tool"
        intent_status=0
        clear_same_boot_stale_intent_unlocked "$tool" "$boot_id" || intent_status=$?
        if [[ $intent_status -ne 0 ]]; then
            unlock_tool_metadata
            unlock_tool_control
            exit "$intent_status"
        fi
        instance="$(generate_instance)" || {
            unlock_tool_metadata
            unlock_tool_control
            echo "Unable to generate a launch instance token." >&2
            exit 70
        }
        write_metadata_unlocked "$tool" "$repository" "$instance" 0 pending
        if ! write_intent_unlocked "$tool" "$repository" "$instance" "$boot_id" "$@"; then
            remove_metadata_unlocked "$tool"
            unlock_tool_metadata
            unlock_tool_control
            echo "Unable to persist the $tool restart intent." >&2
            exit 70
        fi
        session_name="$(session_name_for "$tool" "$instance")"
        unlock_tool_metadata

        launch_file="$runtime_directory/$tool.launch.$$.$RANDOM"
        write_launch_script "$launch_file" "$tool" "$repository" "$instance" initial "$@"
        printf -v launch_command '%q' "$launch_file"
        if ! tmux_command new-session -d -s "$session_name" -c "$project_directory" "$launch_command"; then
            /bin/rm -f -- "$launch_file"
            lock_tool_metadata "$tool"
            if load_metadata_unlocked "$tool" && [[ "$metadata_instance" == "$instance" ]]; then
                remove_metadata_unlocked "$tool"
            fi
            remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
            unlock_tool_metadata
            unlock_tool_control
            echo "Unable to start the $tool tmux session." >&2
            exit 70
        fi
        created_session=1
    fi

    if ! configure_tmux; then
        if [[ $created_session -eq 1 ]]; then
            terminate_launch "$tool" "$repository" "$instance" || true
            lock_tool_metadata "$tool"
            remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
            unlock_tool_metadata
        fi
        unlock_tool_control
        echo "Unable to configure tmux for the $tool launch." >&2
        exit 70
    fi
    if ! attached_client_count="$(tmux_command display-message -p -t "$session_name" '#{session_attached}' 2>/dev/null)" \
        || [[ ! "$attached_client_count" =~ ^[0-9]+$ ]]; then
        unlock_tool_control
        echo "The $tool tmux session ended before start completed." >&2
        exit 75
    fi

    unlock_tool_control
    printf '%s\n' "$protocol_marker"
    printf 'session|%s|%s|%s|%s\n' \
        "$tool" "$repository" "$attached_client_count" "$instance"
}

attach_session() {
    local tool="$1"
    local repository="$2"
    shift 2
    local project_directory
    local session_name
    local instance
    local launch_file
    local launch_command
    local created_session=0
    local metadata_present=0
    local active_repository=""
    local active_instance=""
    local boot_id
    local intent_status

    validate_tool "$tool"
    validate_launch_arguments "$tool" "$@" || exit $?
    boot_id="$(current_boot_id)" || {
        echo "Unable to read the worker boot identity from $boot_id_path." >&2
        exit 69
    }
    project_directory="$(project_directory_for "$repository")" || exit $?
    [[ -x "$tmux_path" ]] || { echo "Required tmux executable is unavailable: $tmux_path" >&2; exit 69; }
    require_flock
    require_lifetime_signal_support || exit $?

    lock_tool_control "$tool"
    lock_tool_metadata "$tool"
    if load_metadata_unlocked "$tool"; then
        metadata_present=1
    fi

    if [[ $metadata_present -eq 1 ]] && session_exists "$tool" "$metadata_instance"; then
        if [[ "$metadata_repository" != "$repository" ]]; then
            active_repository="$metadata_repository"
            unlock_tool_metadata
            unlock_tool_control
            echo "A $tool session is already running for repository '$active_repository'; requested '$repository'." >&2
            exit 75
        fi
        instance="$metadata_instance"
        session_name="$(session_name_for "$tool" "$instance")"
        unlock_tool_metadata
    else
        if any_tool_session_exists "$tool"; then
            if [[ $metadata_present -eq 1 ]]; then
                active_repository="$metadata_repository"
            else
                active_repository="unknown"
            fi
            unlock_tool_metadata
            unlock_tool_control
            echo "A $tool tmux session is already running with inconsistent launch metadata for repository '$active_repository'." >&2
            exit 75
        fi
        if [[ $metadata_present -eq 1 ]] && metadata_launch_is_running "$tool"; then
            active_repository="$metadata_repository"
            active_instance="$metadata_instance"
            unlock_tool_metadata
            unlock_tool_control
            echo "A $tool launch '$active_instance' for repository '$active_repository' is still running without an attachable tmux session." >&2
            exit 75
        fi
        remove_metadata_unlocked "$tool"
        intent_status=0
        clear_same_boot_stale_intent_unlocked "$tool" "$boot_id" || intent_status=$?
        if [[ $intent_status -ne 0 ]]; then
            unlock_tool_metadata
            unlock_tool_control
            exit "$intent_status"
        fi
        instance="$(generate_instance)" || {
            unlock_tool_metadata
            unlock_tool_control
            echo "Unable to generate a launch instance token." >&2
            exit 70
        }
        write_metadata_unlocked "$tool" "$repository" "$instance" 0 pending
        if ! write_intent_unlocked "$tool" "$repository" "$instance" "$boot_id" "$@"; then
            remove_metadata_unlocked "$tool"
            unlock_tool_metadata
            unlock_tool_control
            echo "Unable to persist the $tool restart intent." >&2
            exit 70
        fi
        session_name="$(session_name_for "$tool" "$instance")"
        unlock_tool_metadata

        launch_file="$runtime_directory/$tool.launch.$$.$RANDOM"
        write_launch_script "$launch_file" "$tool" "$repository" "$instance" initial "$@"
        printf -v launch_command '%q' "$launch_file"
        if ! tmux_command new-session -d -s "$session_name" -c "$project_directory" "$launch_command"; then
            /bin/rm -f -- "$launch_file"
            lock_tool_metadata "$tool"
            if load_metadata_unlocked "$tool" && [[ "$metadata_instance" == "$instance" ]]; then
                remove_metadata_unlocked "$tool"
            fi
            remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
            unlock_tool_metadata
            unlock_tool_control
            echo "Unable to start the $tool tmux session." >&2
            exit 70
        fi
        created_session=1
    fi

    if ! configure_tmux; then
        if [[ $created_session -eq 1 ]]; then
            if ! terminate_launch "$tool" "$repository" "$instance"; then
                echo "The newly created $tool launch could not be cleaned up after tmux configuration failed." >&2
            fi
            lock_tool_metadata "$tool"
            remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
            unlock_tool_metadata
        fi
        unlock_tool_control
        echo "Unable to configure tmux for the $tool attachment." >&2
        exit 70
    fi

    if ! session_exists "$tool" "$instance"; then
        unlock_tool_control
        echo "The $tool tmux session ended before it could be attached." >&2
        exit 75
    fi
    unlock_tool_control
    exec "$tmux_path" -f /dev/null -L "$tmux_socket" attach-session -t "$session_name"
}

reattach_session() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local session_name
    local pause_file
    local active_repository=""
    local active_instance=""

    validate_tool "$tool"
    is_valid_repository_name "$repository" || fail_usage "Invalid reattach repository: $repository"
    is_valid_instance "$instance" || fail_usage "Invalid reattach instance: $instance"
    [[ -x "$tmux_path" ]] || { echo "Required tmux executable is unavailable: $tmux_path" >&2; exit 69; }
    require_flock

    lock_tool_control "$tool"
    lock_tool_metadata "$tool"
    if load_metadata_unlocked "$tool"; then
        active_repository="$metadata_repository"
        active_instance="$metadata_instance"
    fi
    unlock_tool_metadata

    session_name="$(session_name_for "$tool" "$instance")"
    if [[ -z "$active_instance" ]]; then
        unlock_tool_control
        echo "The requested $tool launch has ended and cannot be reattached." >&2
        exit 75
    fi
    if [[ "$active_repository" != "$repository" || "$active_instance" != "$instance" ]]; then
        unlock_tool_control
        echo "Refusing stale reattach for $tool '$repository' instance '$instance'; active launch is '$active_repository' instance '$active_instance'." >&2
        exit 75
    fi
    if ! session_exists "$tool" "$instance"; then
        unlock_tool_control
        echo "The requested $tool launch has ended and cannot be reattached." >&2
        exit 75
    fi

    if ! configure_tmux; then
        unlock_tool_control
        echo "Unable to configure tmux for the $tool reattachment." >&2
        exit 70
    fi
    if ! session_exists "$tool" "$instance"; then
        unlock_tool_control
        echo "The requested $tool launch ended before it could be reattached." >&2
        exit 75
    fi

    unlock_tool_control
    if [[ $test_mode -eq 1 && -n "${TERMINAL_RELAY_TEST_PAUSE_BEFORE_ATTACH:-}" ]]; then
        pause_file="$TERMINAL_RELAY_TEST_PAUSE_BEFORE_ATTACH"
        [[ "$pause_file" == /* && "$pause_file" != *$'\n'* ]] || exit 78
        printf 'ready\n' > "$pause_file.ready"
        while [[ -e "$pause_file" ]]; do sleep 0.05; done
    fi
    exec "$tmux_path" -f /dev/null -L "$tmux_socket" attach-session -t "$session_name"
}

stage_stop_intent_unlocked() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local intent_file
    local stopping_file

    stop_intent_staged=0
    intent_file="$(intent_file_for "$instance")"
    stopping_file="$(stopping_intent_file_for "$instance")"
    if [[ -e "$stopping_file" || -L "$stopping_file" ]]; then
        echo "A previous $tool stop transition is incomplete." >&2
        return 70
    fi
    [[ -e "$intent_file" || -L "$intent_file" ]] || return 0
    if ! load_intent_path_unlocked "$tool" "$intent_file"; then
        echo "The saved $tool restart intent is invalid." >&2
        return 70
    fi
    if [[ "$intent_repository" != "$repository" || "$intent_instance" != "$instance" ]]; then
        echo "The saved $tool restart intent does not match the active launch." >&2
        return 75
    fi
    /bin/mv -f "$intent_file" "$stopping_file"
    stop_intent_staged=1
}

restore_staged_stop_intent_unlocked() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local intent_file
    local stopping_file

    [[ ${stop_intent_staged:-0} -eq 1 ]] || return 0
    intent_file="$(intent_file_for "$instance")"
    stopping_file="$(stopping_intent_file_for "$instance")"
    [[ ! -e "$intent_file" && ! -L "$intent_file" ]] || return 70
    if ! load_intent_path_unlocked "$tool" "$stopping_file" \
        || [[ "$intent_repository" != "$repository" \
            || "$intent_instance" != "$instance" ]]; then
        return 70
    fi
    /bin/mv -f "$stopping_file" "$intent_file"
}

remove_staged_stop_intent_unlocked() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local stopping_file

    [[ ${stop_intent_staged:-0} -eq 1 ]] || return 0
    stopping_file="$(stopping_intent_file_for "$instance")"
    if load_intent_path_unlocked "$tool" "$stopping_file" \
        && [[ "$intent_repository" == "$repository" \
            && "$intent_instance" == "$instance" ]]; then
        /bin/rm -f -- "$stopping_file"
        return 0
    fi
    return 70
}

stop_session() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local active_repository=""
    local active_instance=""
    local terminate_status
    local stage_status=0
    local stop_intent_staged=0

    validate_tool "$tool"
    is_valid_repository_name "$repository" || fail_usage "Invalid stop repository: $repository"
    is_valid_instance "$instance" || fail_usage "Invalid stop instance: $instance"
    [[ -x "$tmux_path" ]] || { echo "Required tmux executable is unavailable: $tmux_path" >&2; exit 69; }
    require_flock
    require_lifetime_signal_support || exit $?

    lock_tool_control "$tool"
    lock_tool_metadata "$tool"
    if load_metadata_unlocked "$tool"; then
        active_repository="$metadata_repository"
        active_instance="$metadata_instance"
    fi
    unlock_tool_metadata

    if [[ -z "$active_instance" ]]; then
        unlock_tool_control
        echo "No matching $tool launch is active; the stop request is stale." >&2
        exit 75
    fi
    if [[ "$active_repository" != "$repository" || "$active_instance" != "$instance" ]]; then
        unlock_tool_control
        echo "Refusing stale stop for $tool '$repository' instance '$instance'; active launch is '$active_repository' instance '$active_instance'." >&2
        exit 75
    fi

    lock_tool_metadata "$tool"
    if ! load_metadata_unlocked "$tool" \
        || [[ "$metadata_repository" != "$repository" \
            || "$metadata_instance" != "$instance" ]]; then
        unlock_tool_metadata
        unlock_tool_control
        echo "The $tool launch changed while preparing to stop it." >&2
        exit 75
    fi
    stage_stop_intent_unlocked "$tool" "$repository" "$instance" || stage_status=$?
    unlock_tool_metadata
    if [[ $stage_status -ne 0 ]]; then
        unlock_tool_control
        exit "$stage_status"
    fi

    set +e
    terminate_launch "$tool" "$repository" "$instance"
    terminate_status=$?
    set -e
    lock_tool_metadata "$tool"
    if [[ $terminate_status -eq 0 ]]; then
        if ! remove_staged_stop_intent_unlocked "$tool" "$repository" "$instance"; then
            unlock_tool_metadata
            unlock_tool_control
            echo "The $tool launch stopped, but its restart intent could not be finalized." >&2
            exit 70
        fi
    elif ! restore_staged_stop_intent_unlocked "$tool" "$repository" "$instance"; then
        unlock_tool_metadata
        unlock_tool_control
        echo "The $tool stop failed and its restart intent could not be restored." >&2
        exit 70
    fi
    unlock_tool_metadata
    unlock_tool_control
    case "$terminate_status" in
        0) ;;
        75)
            echo "The $tool launch changed while stopping; the request is stale." >&2
            exit 75
            ;;
        *)
            echo "The $tool launch did not terminate or release its agent lock." >&2
            exit 70
            ;;
    esac
}

