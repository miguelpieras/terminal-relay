        return 70
    }

    while IFS= read -r line || [[ -n "$line" ]]; do
        lines+=("$line")
    done < "$agent_update_status_path"
    [[ ${#lines[@]} -eq 2 && "${lines[0]}" == "$agent_update_protocol_marker" ]] || {
        echo "The agent update status is malformed." >&2
        return 70
    }
    IFS='|' read -r record_type timestamp result codex_version claude_version extra \
        <<< "${lines[1]}"
    [[ "$record_type" == "update" \
        && "$timestamp" =~ ^[1-9][0-9]*$ \
        && "$result" =~ ^(success|failure)$ \
        && "$codex_version" =~ ^(unknown|[A-Za-z0-9][A-Za-z0-9._+-]{0,63})$ \
        && "$claude_version" =~ ^(unknown|[A-Za-z0-9][A-Za-z0-9._+-]{0,63})$ \
        && -z "${extra:-}" ]] || {
        echo "The agent update status is malformed." >&2
        return 70
    }
    printf '%s\n' "${lines[1]}"
}

validate_root_protocol_file() {
    local label="$1"
    local path="$2"
    local expected_mode="$3"
    local expected_owner=0
    local identity

    [[ -f "$path" && ! -L "$path" ]] || {
        echo "The $label is not a regular file." >&2
        return 70
    }
    [[ $test_mode -eq 0 ]] || expected_owner="$user_id"
    identity="$(path_uid_mode "$path")" || {
        echo "The $label cannot be inspected." >&2
        return 70
    }
    [[ "$identity" == "$expected_owner:$expected_mode" ]] || {
        echo "The $label has unsafe ownership or permissions." >&2
        return 70
    }
}

