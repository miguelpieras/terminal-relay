    local stage_status=0
    local stop_intent_staged=0

    validate_tool "$tool"
    is_valid_repository_name "$repository" || fail_usage "Invalid stop repository: $repository"
    is_valid_instance "$instance" || fail_usage "Invalid stop instance: $instance"
    [[ -x "$tmux_path" ]] || {
        echo "Required tmux executable is unavailable: $tmux_path" >&2
        exit 69
    }
    require_flock
    require_lifetime_signal_support || exit $?

    lock_tool_control "$instance"
    lock_tool_metadata "$instance"
    if ! load_metadata_unlocked "$tool" "$instance" \
        || [[ "$metadata_repository" != "$repository" ]]; then
        unlock_tool_metadata
        unlock_tool_control
        echo "No matching $tool launch is active; the stop request is stale." >&2
        exit 75
    fi
    stage_stop_intent_unlocked "$tool" "$repository" "$instance" || stage_status=$?
    unlock_tool_metadata
    if [[ $stage_status -ne 0 ]]; then
        unlock_tool_control
        exit "$stage_status"
    fi

    set +e
    terminate_launch "$tool" "$repository" "$instance"
    terminate_status=$?
    set -e
    lock_tool_metadata "$instance"
    if [[ $terminate_status -eq 0 ]]; then
        if ! remove_staged_stop_intent_unlocked "$tool" "$repository" "$instance"; then
            unlock_tool_metadata
            unlock_tool_control
            echo "The $tool launch stopped, but its restart intent could not be finalized." >&2
            exit 70
        fi
    elif ! restore_staged_stop_intent_unlocked "$tool" "$repository" "$instance"; then
        unlock_tool_metadata
        unlock_tool_control
        echo "The $tool stop failed and its restart intent could not be restored." >&2
        exit 70
    fi
    unlock_tool_metadata
    unlock_tool_control
    case "$terminate_status" in
        0) ;;
        75)
            echo "The $tool launch changed while stopping; the request is stale." >&2
            exit 75
            ;;
        *)
            echo "The $tool launch did not terminate or release its agent lock." >&2
            exit 70
            ;;
    esac
}

finalize_instance_launch_state() {
    local tool="$1"
    local repository="$2"
    local instance="$3"

    lock_tool_control "$instance"
    lock_tool_metadata "$instance"
    if load_metadata_unlocked "$tool" "$instance" \
        && [[ "$metadata_repository" == "$repository" ]]; then
        remove_metadata_unlocked "$instance"
    fi
    remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
    unlock_tool_metadata
    unlock_tool_control
}

run_agent_instance() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local launch_mode="$4"
    shift 4
    local project_directory
    local executable
    local config_file
    local mcp_server
    local lock_file
    local gate_file
    local agent_pid
    local agent_status
    local start_identity
    local launch_thread_id=""
    local preserve_intent=0
    local -a agent_arguments=("$@")
    local -a agent_command

    validate_tool "$tool"
    is_valid_instance "$instance" || fail_usage "Invalid internal launch instance."
    case "$launch_mode" in
        initial|resume) ;;
        *) fail_usage "Invalid internal launch mode." ;;
    esac
    validate_launch_arguments "$tool" "${agent_arguments[@]}" || exit $?
    project_directory="$(project_directory_for "$repository")" || exit $?
    cd "$project_directory"

    lock_tool_metadata "$instance"
    if ! load_intent_unlocked "$tool" "$instance" \
        || [[ "$intent_repository" != "$repository" \
            || "$intent_instance" != "$instance" ]]; then
        unlock_tool_metadata
        echo "The $tool restart intent changed before the agent started." >&2
        exit 75
    fi
    launch_thread_id="$intent_thread_id"
    unlock_tool_metadata

    case "$tool" in
        codex)
            executable="$codex_path"
            if [[ "$codex_shared_account_enabled" != "1" ]]; then
                for config_file in "/etc/codex/config.toml" "$HOME/.codex/config.toml" ".codex/config.toml"; do
                    [[ -f "$config_file" ]] || continue
                    while IFS= read -r mcp_server; do
                        [[ -n "$mcp_server" && "$mcp_server" =~ ^[A-Za-z0-9_-]+$ ]] || continue
                        agent_arguments+=(--config "mcp_servers.$mcp_server={enabled=false}")
                    done < <(
                        /usr/bin/sed -n \
                            's/^[[:space:]]*\[mcp_servers\.\([A-Za-z0-9_-]*\)\][[:space:]]*$/\1/p' \
                            "$config_file"
                    )
                done
            fi
            if [[ "$codex_shared_account_enabled" == "1" ]]; then
                if [[ "$launch_mode" == "resume" ]]; then
                    agent_command=(
                        "$executable"
                        --remote "unix://$codex_app_server_socket"
                        resume "${launch_thread_id:---last}"
                        "${agent_arguments[@]}"
                    )
                else
                    agent_command=(
                        "$executable"
                        --remote "unix://$codex_app_server_socket"
                        "${agent_arguments[@]}"
                    )
                fi
            elif [[ "$launch_mode" == "resume" ]]; then
                agent_command=("$executable" resume "${launch_thread_id:---last}" "${agent_arguments[@]}")
            else
                agent_command=("$executable" "${agent_arguments[@]}")
            fi
            ;;
        claude)
            executable="$claude_path"
            if [[ "$launch_mode" == "resume" ]]; then
                is_valid_instance "$launch_thread_id" || {
                    echo "The saved Claude provider session identifier is invalid." >&2
                    exit 70
                }
                agent_command=(
                    "$executable"
                    --resume "$launch_thread_id"
                    "${agent_arguments[@]}"
                )
            else
                is_valid_instance "$launch_thread_id" || {
                    echo "The new Claude provider session identifier is invalid." >&2
                    exit 70
                }
                agent_command=(
                    "$executable"
                    --session-id "$launch_thread_id"
                    "${agent_arguments[@]}"
                )
            fi
            ;;
    esac

    [[ -x "$executable" ]] || {
        echo "Required $tool executable is unavailable: $executable" >&2
        exit 69
    }
    require_flock
    lock_file="$(agent_lock_file_for "$instance")"
    exec 9>"$lock_file"
    if ! "$flock_path" --nonblock 9; then
        echo "This $tool agent process is already running on this server." >&2
        exit 75
    fi

    lock_tool_metadata "$instance"
    if ! load_metadata_unlocked "$tool" "$instance" \
        || [[ "$metadata_repository" != "$repository" ]] \
        || ! load_intent_unlocked "$tool" "$instance" \
        || [[ "$intent_repository" != "$repository" \
            || "$intent_instance" != "$instance" ]]; then
        unlock_tool_metadata
        echo "The $tool terminal state changed before the agent started." >&2
        exit 75
    fi
    unlock_tool_metadata

    gate_file="$runtime_directory/$instance.gate.$$.$RANDOM"
    (
        while [[ ! -e "$gate_file" ]]; do sleep 0.01; done
        /bin/rm -f -- "$gate_file"
        exec "${agent_command[@]}" </dev/tty
    ) &
    agent_pid=$!
    start_identity="$(process_start_identity "$agent_pid")" || {
        /bin/kill -KILL "$agent_pid" 2>/dev/null || true
        wait "$agent_pid" 2>/dev/null || true
        echo "Unable to record the $tool process start identity." >&2
        exit 70
    }

    lock_tool_metadata "$instance"
    if ! load_metadata_unlocked "$tool" "$instance" \
        || [[ "$metadata_repository" != "$repository" ]]; then
        unlock_tool_metadata
        /bin/kill -KILL "$agent_pid" 2>/dev/null || true
        wait "$agent_pid" 2>/dev/null || true
        echo "The $tool terminal state changed before the agent process was released." >&2
        exit 75
    fi
    write_metadata_unlocked "$tool" "$repository" "$instance" \
        "$agent_pid" "$start_identity" "$launch_thread_id"
    unlock_tool_metadata

    trap 'preserve_intent=1; /bin/rm -f -- "$gate_file"; /bin/kill -TERM "$agent_pid" 2>/dev/null || true' \
        HUP INT TERM
    : > "$gate_file"
    set +e
    wait "$agent_pid"
    agent_status=$?
    set -e
    trap - HUP INT TERM
    /bin/rm -f -- "$gate_file"
    exec 9>&-

    if [[ $preserve_intent -eq 0 ]]; then
        finalize_instance_launch_state "$tool" "$repository" "$instance"
    fi
    exit "$agent_status"
}

infer_repository_from_working_directory() {
    local workspace_physical
    local working_directory
    local relative_path
    local repository

    [[ -d "$workspace_root" ]] || { echo "Workspace root does not exist: $workspace_root" >&2; return 66; }
    workspace_physical="$(cd "$workspace_root" && pwd -P)"
    working_directory="$(pwd -P)"
    case "$working_directory" in
        "$workspace_physical"/*) ;;
        *) echo "Run the legacy command from within $workspace_root/<repository>." >&2; return 64 ;;
    esac
    relative_path="${working_directory#"$workspace_physical"/}"
    repository="${relative_path%%/*}"
    project_directory_for "$repository" >/dev/null || return $?
    printf '%s\n' "$repository"
}

finalize_launch_state() {
    local tool="$1"
    local repository="$2"
    local instance="$3"

    lock_tool_control "$tool"
    lock_tool_metadata "$tool"
    if load_metadata_unlocked "$tool" \
        && [[ "$metadata_repository" == "$repository" \
            && "$metadata_instance" == "$instance" ]]; then
        remove_metadata_unlocked "$tool"
    fi
    remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
    unlock_tool_metadata
    unlock_tool_control
}

