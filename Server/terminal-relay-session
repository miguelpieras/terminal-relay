reattach_session() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local session_name
    local pause_file
    local active_repository=""
    local active_instance=""

    validate_tool "$tool"
    is_valid_repository_name "$repository" || fail_usage "Invalid reattach repository: $repository"
    is_valid_instance "$instance" || fail_usage "Invalid reattach instance: $instance"
    [[ -x "$tmux_path" ]] || { echo "Required tmux executable is unavailable: $tmux_path" >&2; exit 69; }
    require_flock

    lock_tool_control "$tool"
    lock_tool_metadata "$tool"
    if load_metadata_unlocked "$tool"; then
        active_repository="$metadata_repository"
        active_instance="$metadata_instance"
    fi
    unlock_tool_metadata

    session_name="$(session_name_for "$tool" "$instance")"
    if [[ -z "$active_instance" ]]; then
        unlock_tool_control
        echo "The requested $tool launch has ended and cannot be reattached." >&2
        exit 75
    fi
    if [[ "$active_repository" != "$repository" || "$active_instance" != "$instance" ]]; then
        unlock_tool_control
        echo "Refusing stale reattach for $tool '$repository' instance '$instance'; active launch is '$active_repository' instance '$active_instance'." >&2
        exit 75
    fi
    if ! session_exists "$tool" "$instance"; then
        unlock_tool_control
        echo "The requested $tool launch has ended and cannot be reattached." >&2
        exit 75
    fi

    if ! configure_tmux; then
        unlock_tool_control
        echo "Unable to configure tmux for the $tool reattachment." >&2
        exit 70
    fi
    if ! session_exists "$tool" "$instance"; then
        unlock_tool_control
        echo "The requested $tool launch ended before it could be reattached." >&2
        exit 75
    fi

    unlock_tool_control
    if [[ $test_mode -eq 1 && -n "${TERMINAL_RELAY_TEST_PAUSE_BEFORE_ATTACH:-}" ]]; then
        pause_file="$TERMINAL_RELAY_TEST_PAUSE_BEFORE_ATTACH"
        [[ "$pause_file" == /* && "$pause_file" != *$'\n'* ]] || exit 78
        printf 'ready\n' > "$pause_file.ready"
        while [[ -e "$pause_file" ]]; do sleep 0.05; done
    fi
    exec "$tmux_path" -f /dev/null -L "$tmux_socket" attach-session -t "$session_name"
}

stage_stop_intent_unlocked() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local intent_file
    local stopping_file

    stop_intent_staged=0
    intent_file="$(intent_file_for "$tool")"
    stopping_file="$(stopping_intent_file_for "$tool")"
    if [[ -e "$stopping_file" || -L "$stopping_file" ]]; then
        echo "A previous $tool stop transition is incomplete." >&2
        return 70
    fi
    [[ -e "$intent_file" || -L "$intent_file" ]] || return 0
    if ! load_intent_path_unlocked "$tool" "$intent_file"; then
        echo "The saved $tool restart intent is invalid." >&2
        return 70
    fi
    if [[ "$intent_repository" != "$repository" || "$intent_instance" != "$instance" ]]; then
        echo "The saved $tool restart intent does not match the active launch." >&2
        return 75
    fi
    /bin/mv -f "$intent_file" "$stopping_file"
    stop_intent_staged=1
}

restore_staged_stop_intent_unlocked() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local intent_file
    local stopping_file

    [[ ${stop_intent_staged:-0} -eq 1 ]] || return 0
    intent_file="$(intent_file_for "$tool")"
    stopping_file="$(stopping_intent_file_for "$tool")"
    [[ ! -e "$intent_file" && ! -L "$intent_file" ]] || return 70
    if ! load_intent_path_unlocked "$tool" "$stopping_file" \
        || [[ "$intent_repository" != "$repository" \
            || "$intent_instance" != "$instance" ]]; then
        return 70
    fi
    /bin/mv -f "$stopping_file" "$intent_file"
}

remove_staged_stop_intent_unlocked() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local stopping_file

    [[ ${stop_intent_staged:-0} -eq 1 ]] || return 0
    stopping_file="$(stopping_intent_file_for "$tool")"
    if load_intent_path_unlocked "$tool" "$stopping_file" \
        && [[ "$intent_repository" == "$repository" \
            && "$intent_instance" == "$instance" ]]; then
        /bin/rm -f -- "$stopping_file"
        return 0
    fi
    return 70
}

stop_session() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local active_repository=""
    local active_instance=""
    local terminate_status
    local stage_status=0
    local stop_intent_staged=0

    validate_tool "$tool"
    is_valid_repository_name "$repository" || fail_usage "Invalid stop repository: $repository"
    is_valid_instance "$instance" || fail_usage "Invalid stop instance: $instance"
    [[ -x "$tmux_path" ]] || { echo "Required tmux executable is unavailable: $tmux_path" >&2; exit 69; }
    require_flock
    require_lifetime_signal_support || exit $?

    lock_tool_control "$tool"
    lock_tool_metadata "$tool"
    if load_metadata_unlocked "$tool"; then
        active_repository="$metadata_repository"
        active_instance="$metadata_instance"
    fi
    unlock_tool_metadata

    if [[ -z "$active_instance" ]]; then
        unlock_tool_control
        echo "No matching $tool launch is active; the stop request is stale." >&2
        exit 75
    fi
    if [[ "$active_repository" != "$repository" || "$active_instance" != "$instance" ]]; then
        unlock_tool_control
        echo "Refusing stale stop for $tool '$repository' instance '$instance'; active launch is '$active_repository' instance '$active_instance'." >&2
        exit 75
    fi

    lock_tool_metadata "$tool"
    if ! load_metadata_unlocked "$tool" \
        || [[ "$metadata_repository" != "$repository" \
            || "$metadata_instance" != "$instance" ]]; then
        unlock_tool_metadata
        unlock_tool_control
        echo "The $tool launch changed while preparing to stop it." >&2
        exit 75
    fi
    stage_stop_intent_unlocked "$tool" "$repository" "$instance" || stage_status=$?
    unlock_tool_metadata
    if [[ $stage_status -ne 0 ]]; then
        unlock_tool_control
        exit "$stage_status"
    fi

    set +e
    terminate_launch "$tool" "$repository" "$instance"
    terminate_status=$?
    set -e
    lock_tool_metadata "$tool"
    if [[ $terminate_status -eq 0 ]]; then
        if ! remove_staged_stop_intent_unlocked "$tool" "$repository" "$instance"; then
            unlock_tool_metadata
            unlock_tool_control
            echo "The $tool launch stopped, but its restart intent could not be finalized." >&2
            exit 70
        fi
    elif ! restore_staged_stop_intent_unlocked "$tool" "$repository" "$instance"; then
        unlock_tool_metadata
        unlock_tool_control
        echo "The $tool stop failed and its restart intent could not be restored." >&2
        exit 70
    fi
    unlock_tool_metadata
    unlock_tool_control
    case "$terminate_status" in
        0) ;;
        75)
            echo "The $tool launch changed while stopping; the request is stale." >&2
            exit 75
            ;;
        *)
            echo "The $tool launch did not terminate or release its agent lock." >&2
            exit 70
            ;;
    esac
}

infer_repository_from_working_directory() {
    local workspace_physical
    local working_directory
    local relative_path
    local repository

    [[ -d "$workspace_root" ]] || { echo "Workspace root does not exist: $workspace_root" >&2; return 66; }
    workspace_physical="$(cd "$workspace_root" && pwd -P)"
    working_directory="$(pwd -P)"
    case "$working_directory" in
        "$workspace_physical"/*) ;;
        *) echo "Run the legacy command from within $workspace_root/<repository>." >&2; return 64 ;;
    esac
    relative_path="${working_directory#"$workspace_physical"/}"
    repository="${relative_path%%/*}"
    project_directory_for "$repository" >/dev/null || return $?
    printf '%s\n' "$repository"
}

finalize_launch_state() {
    local tool="$1"
    local repository="$2"
    local instance="$3"

    lock_tool_control "$tool"
    lock_tool_metadata "$tool"
    if load_metadata_unlocked "$tool" \
        && [[ "$metadata_repository" == "$repository" \
            && "$metadata_instance" == "$instance" ]]; then
        remove_metadata_unlocked "$tool"
    fi
    remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
    unlock_tool_metadata
    unlock_tool_control
}

run_agent() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local launch_mode="$4"
    shift 4
    local project_directory
    local executable
    local config_file
    local mcp_server
    local lock_file
    local gate_file
    local agent_pid
    local agent_status
    local start_identity
    local preserve_intent=0
    local -a agent_arguments=("$@")
    local -a agent_command

    validate_tool "$tool"
    is_valid_instance "$instance" || fail_usage "Invalid internal launch instance."
    case "$launch_mode" in
        initial|resume) ;;
        *) fail_usage "Invalid internal launch mode." ;;
    esac
    validate_launch_arguments "$tool" "${agent_arguments[@]}" || exit $?
    project_directory="$(project_directory_for "$repository")" || exit $?
    cd "$project_directory"

    case "$tool" in
        codex)
            executable="$codex_path"
            for config_file in "/etc/codex/config.toml" "$HOME/.codex/config.toml" ".codex/config.toml"; do
                [[ -f "$config_file" ]] || continue
                while IFS= read -r mcp_server; do
                    [[ -n "$mcp_server" && "$mcp_server" =~ ^[A-Za-z0-9_-]+$ ]] || continue
                    agent_arguments+=(--config "mcp_servers.$mcp_server.enabled=false")
                done < <(
                    /usr/bin/sed -n \
                        's/^[[:space:]]*\[mcp_servers\.\([A-Za-z0-9_-]*\)\][[:space:]]*$/\1/p' \
                        "$config_file"
                )
            done
            if [[ "$launch_mode" == "resume" ]]; then
                agent_command=("$executable" resume --last "${agent_arguments[@]}")
            else
                agent_command=("$executable" "${agent_arguments[@]}")
            fi
            ;;
        claude)
            executable="$claude_path"
            if [[ "$launch_mode" == "resume" ]]; then
                agent_command=("$executable" --resume "$instance" "${agent_arguments[@]}")
            else
                agent_command=("$executable" --session-id "$instance" "${agent_arguments[@]}")
            fi
            ;;
    esac

    [[ -x "$executable" ]] || { echo "Required $tool executable is unavailable: $executable" >&2; exit 69; }
    require_flock
    lock_file="$(agent_lock_file_for "$tool")"
    exec 9>"$lock_file"
    if ! "$flock_path" --nonblock 9; then
        echo "A $tool agent process is already running on this server." >&2
        exit 75
    fi

    lock_tool_metadata "$tool"
    if ! load_metadata_unlocked "$tool" \
        || [[ "$metadata_repository" != "$repository" \
            || "$metadata_instance" != "$instance" ]]; then
        unlock_tool_metadata
        echo "The $tool launch metadata changed before the agent started." >&2
        exit 75
    fi
    if ! load_intent_unlocked "$tool" \
        || [[ "$intent_repository" != "$repository" \
            || "$intent_instance" != "$instance" ]]; then
        unlock_tool_metadata
        echo "The $tool restart intent changed before the agent started." >&2
        exit 75
    fi
    unlock_tool_metadata

    gate_file="$runtime_directory/$tool.gate.$$.$RANDOM"
    (
        while [[ ! -e "$gate_file" ]]; do sleep 0.01; done
        /bin/rm -f -- "$gate_file"
        exec "${agent_command[@]}"
    ) &
    agent_pid=$!
    start_identity="$(process_start_identity "$agent_pid")" || {
        /bin/kill -KILL "$agent_pid" 2>/dev/null || true
        wait "$agent_pid" 2>/dev/null || true
        echo "Unable to record the $tool process start identity." >&2
        exit 70
    }

    lock_tool_metadata "$tool"
    if ! load_metadata_unlocked "$tool" \
        || [[ "$metadata_repository" != "$repository" \
            || "$metadata_instance" != "$instance" ]]; then
        unlock_tool_metadata
        /bin/kill -KILL "$agent_pid" 2>/dev/null || true
        wait "$agent_pid" 2>/dev/null || true
        echo "The $tool launch metadata changed before the agent process was released." >&2
        exit 75
    fi
    write_metadata_unlocked "$tool" "$repository" "$instance" "$agent_pid" "$start_identity"
    unlock_tool_metadata

    trap 'preserve_intent=1; /bin/rm -f -- "$gate_file"; /bin/kill -TERM "$agent_pid" 2>/dev/null || true' \
        HUP INT TERM
    : > "$gate_file"
    set +e
    wait "$agent_pid"
    agent_status=$?
    set -e
    trap - HUP INT TERM
    /bin/rm -f -- "$gate_file"
    exec 9>&-

    if [[ $preserve_intent -eq 0 ]]; then
        finalize_launch_state "$tool" "$repository" "$instance"
    fi
    exit "$agent_status"
}

[[ $# -ge 1 ]] || { usage; exit 64; }
command_name="$1"
shift

case "$command_name" in
    list-projects)
        [[ $# -eq 0 ]] || fail_usage "list-projects does not accept arguments."
        list_projects
        ;;
    status)
        [[ $# -eq 0 ]] || fail_usage "status does not accept arguments."
        status_sessions
        ;;
    restore)
        [[ $# -eq 0 ]] || fail_usage "restore does not accept arguments."
        restore_sessions
        ;;
    start)
        [[ $# -ge 2 ]] || fail_usage "start requires a tool and repository."
        start_session "$@"
        ;;
    attach)
        [[ $# -ge 2 ]] || fail_usage "attach requires a tool and repository."
        attach_session "$@"
        ;;
    reattach)
        [[ $# -eq 3 ]] || fail_usage "reattach requires a tool, repository, and instance."
        reattach_session "$1" "$2" "$3"
        ;;
    stop)
        [[ $# -eq 3 ]] || fail_usage "stop requires a tool, repository, and instance."
        stop_session "$1" "$2" "$3"
        ;;
    codex|claude)
        legacy_tool="$command_name"
        legacy_repository="$(infer_repository_from_working_directory)" || exit $?
        attach_session "$legacy_tool" "$legacy_repository" "$@"
        ;;
    __run-agent)
        [[ $# -ge 4 ]] || fail_usage "Invalid internal launch request."
        run_agent "$@"
        ;;
    *) fail_usage "Unknown command: $command_name" ;;
esac
