run_agent_instance() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local launch_mode="$4"
    shift 4
    local project_directory
    local executable
    local config_file
    local mcp_server
    local lock_file
    local gate_file
    local agent_pid
    local agent_status
    local start_identity
    local preserve_intent=0
    local -a agent_arguments=("$@")
    local -a agent_command

    validate_tool "$tool"
    is_valid_instance "$instance" || fail_usage "Invalid internal launch instance."
    case "$launch_mode" in
        initial|resume) ;;
        *) fail_usage "Invalid internal launch mode." ;;
    esac
    validate_launch_arguments "$tool" "${agent_arguments[@]}" || exit $?
    project_directory="$(project_directory_for "$repository")" || exit $?
    cd "$project_directory"

    case "$tool" in
        codex)
            executable="$codex_path"
            if [[ "$codex_shared_account_enabled" != "1" ]]; then
                for config_file in "/etc/codex/config.toml" "$HOME/.codex/config.toml" ".codex/config.toml"; do
                    [[ -f "$config_file" ]] || continue
                    while IFS= read -r mcp_server; do
                        [[ -n "$mcp_server" && "$mcp_server" =~ ^[A-Za-z0-9_-]+$ ]] || continue
                        agent_arguments+=(--config "mcp_servers.$mcp_server={enabled=false}")
                    done < <(
                        /usr/bin/sed -n \
                            's/^[[:space:]]*\[mcp_servers\.\([A-Za-z0-9_-]*\)\][[:space:]]*$/\1/p' \
                            "$config_file"
                    )
                done
            fi
            if [[ "$codex_shared_account_enabled" == "1" ]]; then
                if [[ "$launch_mode" == "resume" ]]; then
                    agent_command=(
                        "$executable"
                        --remote "unix://$codex_app_server_socket"
                        resume --last
                        "${agent_arguments[@]}"
                    )
                else
                    agent_command=(
                        "$executable"
                        --remote "unix://$codex_app_server_socket"
                        "${agent_arguments[@]}"
                    )
                fi
            elif [[ "$launch_mode" == "resume" ]]; then
                agent_command=("$executable" resume --last "${agent_arguments[@]}")
            else
                agent_command=("$executable" "${agent_arguments[@]}")
            fi
            ;;
        claude)
            executable="$claude_path"
            if [[ "$launch_mode" == "resume" ]]; then
                agent_command=("$executable" --resume "$instance" "${agent_arguments[@]}")
            else
                agent_command=("$executable" --session-id "$instance" "${agent_arguments[@]}")
            fi
            ;;
    esac

    [[ -x "$executable" ]] || {
        echo "Required $tool executable is unavailable: $executable" >&2
        exit 69
    }
    require_flock
    lock_file="$(agent_lock_file_for "$instance")"
    exec 9>"$lock_file"
    if ! "$flock_path" --nonblock 9; then
        echo "This $tool agent process is already running on this server." >&2
        exit 75
    fi

    lock_tool_metadata "$instance"
    if ! load_metadata_unlocked "$tool" "$instance" \
        || [[ "$metadata_repository" != "$repository" ]] \
        || ! load_intent_unlocked "$tool" "$instance" \
        || [[ "$intent_repository" != "$repository" \
            || "$intent_instance" != "$instance" ]]; then
        unlock_tool_metadata
        echo "The $tool terminal state changed before the agent started." >&2
        exit 75
    fi
    unlock_tool_metadata

    gate_file="$runtime_directory/$instance.gate.$$.$RANDOM"
    (
        while [[ ! -e "$gate_file" ]]; do sleep 0.01; done
        /bin/rm -f -- "$gate_file"
        exec "${agent_command[@]}" </dev/tty
    ) &
    agent_pid=$!
    start_identity="$(process_start_identity "$agent_pid")" || {
        /bin/kill -KILL "$agent_pid" 2>/dev/null || true
        wait "$agent_pid" 2>/dev/null || true
        echo "Unable to record the $tool process start identity." >&2
        exit 70
    }

    lock_tool_metadata "$instance"
    if ! load_metadata_unlocked "$tool" "$instance" \
        || [[ "$metadata_repository" != "$repository" ]]; then
        unlock_tool_metadata
        /bin/kill -KILL "$agent_pid" 2>/dev/null || true
        wait "$agent_pid" 2>/dev/null || true
        echo "The $tool terminal state changed before the agent process was released." >&2
        exit 75
    fi
    write_metadata_unlocked "$tool" "$repository" "$instance" "$agent_pid" "$start_identity"
    unlock_tool_metadata

    trap 'preserve_intent=1; /bin/rm -f -- "$gate_file"; /bin/kill -TERM "$agent_pid" 2>/dev/null || true' \
        HUP INT TERM
    : > "$gate_file"
    set +e
    wait "$agent_pid"
    agent_status=$?
    set -e
    trap - HUP INT TERM
    /bin/rm -f -- "$gate_file"
    exec 9>&-

    if [[ $preserve_intent -eq 0 ]]; then
        finalize_instance_launch_state "$tool" "$repository" "$instance"
    fi
    exit "$agent_status"
}

infer_repository_from_working_directory() {
    local workspace_physical
    local working_directory
    local relative_path
    local repository

    [[ -d "$workspace_root" ]] || { echo "Workspace root does not exist: $workspace_root" >&2; return 66; }
    workspace_physical="$(cd "$workspace_root" && pwd -P)"
    working_directory="$(pwd -P)"
    case "$working_directory" in
        "$workspace_physical"/*) ;;
        *) echo "Run the legacy command from within $workspace_root/<repository>." >&2; return 64 ;;
    esac
    relative_path="${working_directory#"$workspace_physical"/}"
    repository="${relative_path%%/*}"
    project_directory_for "$repository" >/dev/null || return $?
    printf '%s\n' "$repository"
}

finalize_launch_state() {
    local tool="$1"
    local repository="$2"
    local instance="$3"

    lock_tool_control "$tool"
    lock_tool_metadata "$tool"
    if load_metadata_unlocked "$tool" \
        && [[ "$metadata_repository" == "$repository" \
            && "$metadata_instance" == "$instance" ]]; then
        remove_metadata_unlocked "$tool"
    fi
    remove_intent_if_matches_unlocked "$tool" "$repository" "$instance"
    unlock_tool_metadata
    unlock_tool_control
}

run_agent() {
    local tool="$1"
    local repository="$2"
    local instance="$3"
    local launch_mode="$4"
    shift 4
    local project_directory
    local executable
    local config_file
    local mcp_server
    local lock_file
    local gate_file
    local agent_pid
    local agent_status
    local start_identity
    local preserve_intent=0
    local -a agent_arguments=("$@")
    local -a agent_command

    validate_tool "$tool"
    is_valid_instance "$instance" || fail_usage "Invalid internal launch instance."
    case "$launch_mode" in
        initial|resume) ;;
        *) fail_usage "Invalid internal launch mode." ;;
    esac
    validate_launch_arguments "$tool" "${agent_arguments[@]}" || exit $?
    project_directory="$(project_directory_for "$repository")" || exit $?
    cd "$project_directory"

    case "$tool" in
        codex)
            executable="$codex_path"
            if [[ "$codex_shared_account_enabled" != "1" ]]; then
                for config_file in "/etc/codex/config.toml" "$HOME/.codex/config.toml" ".codex/config.toml"; do
                    [[ -f "$config_file" ]] || continue
                    while IFS= read -r mcp_server; do
                        [[ -n "$mcp_server" && "$mcp_server" =~ ^[A-Za-z0-9_-]+$ ]] || continue
                        agent_arguments+=(--config "mcp_servers.$mcp_server={enabled=false}")
                    done < <(
                        /usr/bin/sed -n \
                            's/^[[:space:]]*\[mcp_servers\.\([A-Za-z0-9_-]*\)\][[:space:]]*$/\1/p' \
                            "$config_file"
                    )
                done
            fi
            if [[ "$launch_mode" == "resume" ]]; then
                agent_command=("$executable" resume --last "${agent_arguments[@]}")
            else
                agent_command=("$executable" "${agent_arguments[@]}")
            fi
            ;;
        claude)
            executable="$claude_path"
            if [[ "$launch_mode" == "resume" ]]; then
                agent_command=("$executable" --resume "$instance" "${agent_arguments[@]}")
            else
                agent_command=("$executable" --session-id "$instance" "${agent_arguments[@]}")
            fi
            ;;
    esac

    [[ -x "$executable" ]] || { echo "Required $tool executable is unavailable: $executable" >&2; exit 69; }
    require_flock
    lock_file="$(agent_lock_file_for "$tool")"
    exec 9>"$lock_file"
    if ! "$flock_path" --nonblock 9; then
        echo "A $tool agent process is already running on this server." >&2
        exit 75
    fi

    lock_tool_metadata "$tool"
    if ! load_metadata_unlocked "$tool" \
        || [[ "$metadata_repository" != "$repository" \
            || "$metadata_instance" != "$instance" ]]; then
        unlock_tool_metadata
        echo "The $tool launch metadata changed before the agent started." >&2
        exit 75
    fi
    if ! load_intent_unlocked "$tool" \
        || [[ "$intent_repository" != "$repository" \
            || "$intent_instance" != "$instance" ]]; then
        unlock_tool_metadata
        echo "The $tool restart intent changed before the agent started." >&2
        exit 75
    fi
    unlock_tool_metadata

    gate_file="$runtime_directory/$tool.gate.$$.$RANDOM"
    (
        while [[ ! -e "$gate_file" ]]; do sleep 0.01; done
        /bin/rm -f -- "$gate_file"
        exec "${agent_command[@]}" </dev/tty
    ) &
    agent_pid=$!
    start_identity="$(process_start_identity "$agent_pid")" || {
        /bin/kill -KILL "$agent_pid" 2>/dev/null || true
        wait "$agent_pid" 2>/dev/null || true
        echo "Unable to record the $tool process start identity." >&2
        exit 70
    }

    lock_tool_metadata "$tool"
    if ! load_metadata_unlocked "$tool" \
        || [[ "$metadata_repository" != "$repository" \
            || "$metadata_instance" != "$instance" ]]; then
        unlock_tool_metadata
        /bin/kill -KILL "$agent_pid" 2>/dev/null || true
        wait "$agent_pid" 2>/dev/null || true
        echo "The $tool launch metadata changed before the agent process was released." >&2
        exit 75
    fi
    write_metadata_unlocked "$tool" "$repository" "$instance" "$agent_pid" "$start_identity"
    unlock_tool_metadata

    trap 'preserve_intent=1; /bin/rm -f -- "$gate_file"; /bin/kill -TERM "$agent_pid" 2>/dev/null || true' \
        HUP INT TERM
    : > "$gate_file"
    set +e
    wait "$agent_pid"
    agent_status=$?
    set -e
    trap - HUP INT TERM
    /bin/rm -f -- "$gate_file"
    exec 9>&-

    if [[ $preserve_intent -eq 0 ]]; then
        finalize_launch_state "$tool" "$repository" "$instance"
    fi
    exit "$agent_status"
}

migrate_legacy_state() {
    local migration_lock="$runtime_directory/migration.lock"
    local tool
    local legacy_metadata
    local legacy_intent
    local legacy_stopping
    local key
    local value
    local extra
    local repository
    local instance
    local pid
    local start

    require_flock
    exec 5>"$migration_lock"
    "$flock_path" 5
    for tool in codex claude; do
        legacy_metadata="$runtime_directory/$tool.session"
        [[ -e "$legacy_metadata" || -L "$legacy_metadata" ]] || continue
        [[ -f "$legacy_metadata" && ! -L "$legacy_metadata" ]] || {
            echo "The legacy $tool terminal metadata is invalid." >&2
            exec 5>&-
            return 70
        }
        repository=""
        instance=""
        pid=""
        start=""
        while IFS='|' read -r key value extra; do
            [[ -z "${extra:-}" ]] || {
                echo "The legacy $tool terminal metadata is invalid." >&2
                exec 5>&-
                return 70
            }
            case "$key" in
                repository) repository="$value" ;;
                instance) instance="$value" ;;
                pid) pid="$value" ;;
                start) start="$value" ;;
                *)
                    echo "The legacy $tool terminal metadata is invalid." >&2
                    exec 5>&-
                    return 70
                    ;;
            esac
        done < "$legacy_metadata"
        if ! is_valid_repository_name "$repository" \
            || ! is_valid_instance "$instance" \
            || [[ ! "$pid" =~ ^(0|[1-9][0-9]*)$ ]] \
            || { [[ "$pid" == "0" ]] && [[ "$start" != "pending" ]]; } \
            || { [[ "$pid" != "0" ]] && ! is_valid_process_identity "$start"; }; then
            echo "The legacy $tool terminal metadata is invalid." >&2
            exec 5>&-
            return 70
        fi
        if [[ ! -e "$(metadata_file_for "$instance")" ]]; then
            write_metadata_unlocked "$tool" "$repository" "$instance" "$pid" "$start"
        fi
        legacy_intent="$runtime_directory/$tool.intent"
        legacy_stopping="$runtime_directory/$tool.intent.stopping"
        if [[ -f "$legacy_intent" && ! -e "$(intent_file_for "$instance")" ]]; then
            /bin/mv -f "$legacy_intent" "$(intent_file_for "$instance")"
        fi
        if [[ -f "$legacy_stopping" \
            && ! -e "$(stopping_intent_file_for "$instance")" ]]; then
            /bin/mv -f "$legacy_stopping" "$(stopping_intent_file_for "$instance")"
        fi
        /bin/rm -f -- "$legacy_metadata"
    done
    exec 5>&-
}

migrate_legacy_state || exit $?

[[ $# -ge 1 ]] || { usage; exit 64; }
