shift

case "$command_name" in
    list-projects)
        [[ $# -eq 0 ]] || fail_usage "list-projects does not accept arguments."
        list_projects
        ;;
    status)
        [[ $# -eq 0 ]] || fail_usage "status does not accept arguments."
        status_sessions
        ;;
    resources)
        [[ $# -eq 0 ]] || fail_usage "resources does not accept arguments."
        system_resources
        ;;
    update-status)
        [[ $# -eq 0 ]] || fail_usage "update-status does not accept arguments."
        agent_update_status
        ;;
    restore)
        [[ $# -eq 0 ]] || fail_usage "restore does not accept arguments."
        restore_sessions
        ;;
    start)
        [[ $# -ge 2 ]] || fail_usage "start requires a tool and repository."
        start_instance_session "$@"
        ;;
    attach)
        [[ $# -ge 2 ]] || fail_usage "attach requires a tool and repository."
        attach_instance_session "$@"
        ;;
    reattach)
        [[ $# -eq 3 ]] || fail_usage "reattach requires a tool, repository, and instance."
        reattach_instance_session "$1" "$2" "$3"
        ;;
    stop)
        [[ $# -eq 3 ]] || fail_usage "stop requires a tool, repository, and instance."
        stop_instance_session "$1" "$2" "$3"
        ;;
    codex-account)
        [[ $# -eq 0 ]] || fail_usage "codex-account does not accept arguments."
        run_codex_rpc_with_app_server_lock account
        ;;
    claude-account)
        [[ $# -eq 0 ]] || fail_usage "claude-account does not accept arguments."
        claude_account
        ;;
    codex-login)
        [[ $# -eq 0 ]] || fail_usage "codex-login does not accept arguments."
        run_codex_rpc_with_app_server_lock login
        ;;
    codex-reset)
        [[ $# -ge 1 && $# -le 2 ]] \
            || fail_usage "codex-reset requires an idempotency key and optional credit id."
        [[ "$1" =~ ^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$ ]] \
            || fail_usage "codex-reset requires a UUID idempotency key."
        run_codex_rpc_with_app_server_lock reset "$@"
        ;;
    codex|claude)
        legacy_tool="$command_name"
        legacy_repository="$(infer_repository_from_working_directory)" || exit $?
        attach_instance_session "$legacy_tool" "$legacy_repository" "$@"
        ;;
    __run-agent)
        [[ $# -ge 4 ]] || fail_usage "Invalid internal launch request."
        run_agent_instance "$@"
        ;;
    __schedule-codex-app-server-restart)
        [[ $# -eq 0 ]] || fail_usage "Invalid internal Codex restart request."
        schedule_codex_app_server_restart
        ;;
    *) fail_usage "Unknown command: $command_name" ;;
esac
