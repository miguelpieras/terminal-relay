write_claude_archive_marker() {
    local archive_directory="$1"
    local thread_id="$2"
    local marker="$archive_directory/$thread_id"
    local temporary_marker="$archive_directory/.$thread_id.$$.$RANDOM.tmp"

    if [[ -L "$marker" || -e "$marker" ]]; then
        echo "The Claude session is already archived or its archive state is invalid." >&2
        return 75
    fi
    if ! printf 'version|1\n' > "$temporary_marker" \
        || ! /bin/chmod 600 "$temporary_marker" \
        || ! /bin/mv -f "$temporary_marker" "$marker"; then
        /bin/rm -f -- "$temporary_marker"
        echo "The Claude archive state could not be written." >&2
        return 70
    fi
}

claude_thread_mutate_v2() {
    local operation="$1"
    local repository="$2"
    local thread_id="$3"
    shift 3
    local archive_directory
    local catalog
    local marker
    local project_directory

    validate_thread_id "$thread_id"
    project_directory="$(project_directory_for "$repository")" || return $?
    archive_directory="$(claude_archive_directory_for "$repository")" || return $?
    lock_provider_session claude "$thread_id" || return $?
    require_inactive_claude_thread \
        "$project_directory" "$archive_directory" "$thread_id" || {
        local status=$?
        unlock_provider_session
        return "$status"
    }
    marker="$archive_directory/$thread_id"
    case "$operation" in
        thread-rename)
            [[ "$claude_thread_archived" == "0" ]] || {
                unlock_provider_session
                echo "Archived Claude sessions must be restored before renaming." >&2
                return 75
            }
            catalog="$(run_claude_sessions_adapter \
                rename "$project_directory" "$archive_directory" \
                "$thread_id" "$1")" || {
                local status=$?
                unlock_provider_session
                return "$status"
            }
            ;;
        thread-archive)
            [[ "$claude_thread_archived" == "0" ]] || {
                unlock_provider_session
                echo "The Claude session is already archived." >&2
                return 75
            }
            write_claude_archive_marker "$archive_directory" "$thread_id" || {
                local status=$?
                unlock_provider_session
                return "$status"
            }
            catalog="$(run_claude_sessions_adapter \
                read "$project_directory" "$archive_directory" "$thread_id")" \
                || {
                local status=$?
                unlock_provider_session
                return "$status"
            }
            ;;
        thread-unarchive)
            [[ "$claude_thread_archived" == "1" \
                && -f "$marker" && ! -L "$marker" ]] || {
                unlock_provider_session
                echo "The Claude session is not archived or its archive state is invalid." >&2
                return 75
            }
            /bin/rm -f -- "$marker"
            catalog="$(run_claude_sessions_adapter \
                read "$project_directory" "$archive_directory" "$thread_id")" \
                || {
                local status=$?
                unlock_provider_session
                return "$status"
            }
            ;;
        *)
            unlock_provider_session
            return 64
            ;;
    esac
    unlock_provider_session
    emit_thread_catalog_v2 claude "$repository" "$catalog"
}

provider_thread_mutate_v2() {
    local operation="$1"
    local provider="$2"
    local repository="$3"
    local thread_id="$4"
    shift 4
    local catalog

    validate_tool "$provider"
    validate_thread_id "$thread_id"
    if [[ "$provider" == "claude" ]]; then
        claude_thread_mutate_v2 \
            "$operation" "$repository" "$thread_id" "$@"
        return
    fi
    lock_provider_session codex "$thread_id" || return $?
    catalog="$(codex_thread_mutate \
        "$operation" "$repository" "$thread_id" "$@")" || {
        local status=$?
        unlock_provider_session
        return "$status"
    }
    unlock_provider_session
    emit_thread_catalog_v2 codex "$repository" "$catalog"
}

system_resources() {
    local cpu_before
    local cpu_after
    local cpu_total_before
    local cpu_idle_before
    local cpu_total_after
    local cpu_idle_after
    local cpu_total
    local cpu_idle
    local cpu_used
    local memory_total
    local memory_available
    local disk_total
    local disk_used

    read_cpu_sample() {
        /usr/bin/awk '
            $1 == "cpu" {
                total = 0
                for (field = 2; field <= 9; field += 1) total += $field
                print total, $5 + $6
                exit
            }
        ' /proc/stat
    }

    cpu_before="$(read_cpu_sample)"
    /bin/sleep 1
    cpu_after="$(read_cpu_sample)"
    read -r cpu_total_before cpu_idle_before <<< "$cpu_before"
    read -r cpu_total_after cpu_idle_after <<< "$cpu_after"
    cpu_total=$((cpu_total_after - cpu_total_before))
    cpu_idle=$((cpu_idle_after - cpu_idle_before))
    cpu_used=$((cpu_total - cpu_idle))

    read -r memory_total memory_available < <(
        /usr/bin/awk '
            $1 == "MemTotal:" { total = $2 }
            $1 == "MemAvailable:" { available = $2 }
            END {
                if (total > 0 && available >= 0 && available <= total) {
                    print total, available
                }
            }
        ' /proc/meminfo
    )
    read -r disk_total disk_used < <(
        /bin/df -Pk / | /usr/bin/awk 'NR == 2 { print $2, $3 }'
    )

    [[ "$cpu_total" -gt 0 \
        && "$cpu_idle" -ge 0 \
        && "$cpu_idle" -le "$cpu_total" \
        && "$memory_total" -gt 0 \
        && "$memory_available" -ge 0 \
        && "$memory_available" -le "$memory_total" \
        && "$disk_total" -gt 0 \
        && "$disk_used" -ge 0 \
        && "$disk_used" -le "$disk_total" ]] || {
        echo "Worker resource usage is unavailable." >&2
        return 70
    }

    printf '%s\n' '__TERMINAL_RELAY_METRICS_V1__'
    printf 'cpu|%s|%s\n' "$cpu_used" "$cpu_total"
    printf 'memory|%s|%s\n' "$memory_total" "$memory_available"
    printf 'disk|%s|%s\n' "$disk_total" "$disk_used"
}

