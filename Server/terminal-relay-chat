def normalized_conversation_title(value: Any) -> str | None:
    """Bound a provider title the same way the session listing does."""
    if not isinstance(value, str):
        return None
    text = re.sub(
        r"\s+",
        " ",
        "".join(character if character.isprintable() else " " for character in value),
    ).strip()
    if not text:
        return None
    encoded = text.encode("utf-8")[:MAXIMUM_CONVERSATION_TITLE_BYTES]
    return encoded.decode("utf-8", errors="ignore") or None


def codex_generated_title(text: Any) -> str | None:
    """Parse the structured title turn output, mirroring the status backfill."""
    if not isinstance(text, str):
        return None
    try:
        value = json.loads(text)
    except json.JSONDecodeError:
        return None
    if not isinstance(value, dict):
        return None
    title = value.get("title")
    if not isinstance(title, str):
        return None
    title = re.sub(r"\s+", " ", title).strip().strip("\"'").rstrip(".!?")
    if not title or len(title) > 36:
        return None
    return title


class ChatError(Exception):
    def __init__(
        self,
        code: str,
        message: str,
        *,
        recoverable: bool = True,
        exit_code: int = 70,
        close: bool = False,
    ):
        super().__init__(message)
        self.code = code
        self.message = message
        self.recoverable = recoverable
        self.exit_code = exit_code
        self.close = close


def now_ms() -> int:
    return time.time_ns() // 1_000_000


def public_launch_options(options: dict[str, Any]) -> dict[str, Any]:
    """Return only the provider options exposed by the chat protocol."""
    return {
        key: value
        for key, value in options.items()
        if key in PUBLIC_LAUNCH_OPTION_KEYS
    }


def current_boot_id() -> str | None:
    """Read the worker boot identity used to stamp restart intents."""
    try:
        if os.path.islink(BOOT_ID_PATH):
            return None
        with open(BOOT_ID_PATH, "r", encoding="utf-8") as stream:
            boot_id = stream.readline().strip()
    except OSError:
        return None
    return boot_id if UUID_PATTERN.fullmatch(boot_id) else None


def launch_arguments_for(options: dict[str, Any]) -> list[str]:
    """Render canonical launch arguments for the persisted restart surface.

    Always emits at least the permission mode so a rewritten restart intent
    can never become the argument-less form that boot restore refuses.
    --full-access precedes --permission-mode because validation applies
    arguments in order: the explicit mode must win the round trip instead of
    being escalated back to bypassPermissions.
    """
    arguments: list[str] = []
    if options.get("fullAccess"):
        arguments.append("--full-access")
    arguments += ["--permission-mode", options.get("permissionMode") or "default"]
    for key, flag in (
        ("model", "--model"),
        ("effort", "--effort"),
        ("sandbox", "--sandbox"),
    ):
        if options.get(key):
            arguments += [flag, options[key]]
    if options.get("fastMode"):
        arguments.append("--fast")
    return arguments


def provider_timestamp_ms(value: Any) -> int | None:
    """Normalize provider history timestamps to Unix milliseconds."""
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        if value < 0:
            return None
        # Provider history APIs use Unix seconds, while live lifecycle fields
        # use milliseconds. Contemporary millisecond values are 12+ digits.
        try:
            return int(value if value >= 100_000_000_000 else value * 1_000)
        except (OverflowError, ValueError):
            return None
    if isinstance(value, str):
        try:
            parsed = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
        except ValueError:
            return None
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=datetime.timezone.utc)
        try:
            timestamp = parsed.timestamp()
        except (OverflowError, OSError, ValueError):
            return None
        return int(timestamp * 1_000) if timestamp >= 0 else None
    return None


def new_uuid() -> str:
    return str(uuid.uuid4())


def canonical_uuid(value: Any, label: str) -> str:
    if not isinstance(value, str) or not UUID_PATTERN.fullmatch(value):
        raise ChatError("invalidIdentity", f"The {label} is invalid.", exit_code=64)
    try:
        canonical = str(uuid.UUID(value))
    except ValueError as error:
        raise ChatError(
            "invalidIdentity", f"The {label} is invalid.", exit_code=64
        ) from error
    if canonical != value:
        raise ChatError("invalidIdentity", f"The {label} is invalid.", exit_code=64)
    return canonical


def canonical_repository(value: str) -> str:
    if not isinstance(value, str) or not REPOSITORY_PATTERN.fullmatch(value):
        raise ChatError("invalidRepository", "The repository is invalid.", exit_code=64)
    return value


def canonical_directory(value: str, label: str) -> str:
    if (
        not isinstance(value, str)
        or not os.path.isabs(value)
        or value == "/"
        or "\n" in value
    ):
        raise ChatError("invalidPath", f"The {label} is invalid.", exit_code=64)
    path = pathlib.Path(value)
    if not path.is_dir() or path.is_symlink():
        raise ChatError("invalidPath", f"The {label} is unavailable.", exit_code=66)
    resolved = os.path.realpath(value)
    if resolved != value:
        raise ChatError("invalidPath", f"The {label} is invalid.", exit_code=64)
    return value


def provider_accounts_root() -> str | None:
    if (
        os.path.realpath(__file__) != INSTALLED_PATH
        and os.environ.get("TERMINAL_RELAY_CHAT_TEST_MODE") == "1"
        and os.environ.get("TERMINAL_RELAY_TEST_PROVIDER_ACCOUNTS_ROOT")
    ):
        return os.environ["TERMINAL_RELAY_TEST_PROVIDER_ACCOUNTS_ROOT"]
    home = os.environ.get("HOME")
    if not home or not os.path.isabs(home) or home == "/" or "\n" in home:
        return None
    return os.path.join(home, PROVIDER_ACCOUNTS_DIRECTORY)


def provider_accounts_activated() -> bool:
    root = provider_accounts_root()
    if root is None:
        return False
    marker = os.path.join(root, "activated")
    try:
        descriptor = os.open(
            marker, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
        )
    except FileNotFoundError:
        return False
    except OSError as error:
        raise ChatError(
            "unsafeState", "The provider account activation state is invalid."
        ) from error
    try:
        try:
            info = os.fstat(descriptor)
            content = os.read(
                descriptor, len(PROVIDER_ACCOUNTS_ACTIVATION_CONTENT) + 1
            )
        except OSError as error:
            raise ChatError(
                "unsafeState", "The provider account activation state is invalid."
            ) from error
    finally:
        os.close(descriptor)
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid != os.getuid()
        or stat.S_IMODE(info.st_mode) != 0o600
        or content != PROVIDER_ACCOUNTS_ACTIVATION_CONTENT
    ):
        raise ChatError(
            "unsafeState", "The provider account activation state is invalid."
        )
    return True


def account_id_for(provider: str, requested: str | None) -> str | None:
    activated = provider_accounts_activated()
    environment_provider = os.environ.get("TERMINAL_RELAY_PROVIDER") or None
    environment_account = os.environ.get("TERMINAL_RELAY_ACCOUNT_ID") or None
    if environment_provider is not None and environment_provider != provider:
        raise ChatError(
            "staleAccount", "The provider account identity is stale.", exit_code=75
        )
    account_id = (
        canonical_uuid(requested, "account ID") if requested is not None else None
    )
    if environment_account is not None:
        environment_account = canonical_uuid(environment_account, "account ID")
        if account_id is None or environment_account != account_id:
            raise ChatError(
                "staleAccount", "The provider account identity is stale.", exit_code=75
            )
    if account_id is None and activated:
        raise ChatError(
            "upgradeRequired",
            "An account-aware Terminal Relay client is required.",
            exit_code=75,
        )
    return account_id


def attachment_session_directory(runtime_directory: str, relay_id: str) -> str:
    return os.path.join(runtime_directory, f"chat-{relay_id}")


def managed_attachment_root(runtime_directory: str, relay_id: str) -> str:
    return os.path.join(
        attachment_session_directory(runtime_directory, relay_id), "attachments"
    )


def legacy_attachment_root(relay_id: str) -> str:
    account_home = pwd.getpwuid(os.getuid()).pw_dir
    return os.path.join(
        account_home, ".terminal-relay", "attachments", relay_id
    )


def validate_private_directory(path: str, label: str) -> None:
    try:
        info = os.lstat(path)
    except OSError as error:
        raise ChatError("unsafeState", f"The {label} is unavailable.") from error
    if (
        not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != os.getuid()
        or stat.S_IMODE(info.st_mode) != 0o700
        or os.path.realpath(path) != path
    ):
        raise ChatError("unsafeState", f"The {label} is unsafe.")


def ensure_private_directory(path: str, parent: str, label: str) -> None:
    if os.path.dirname(path) != parent:
        raise ChatError("unsafeState", f"The {label} is unsafe.")
    if os.path.lexists(path):
        validate_private_directory(path, label)
        return
    try:
        os.mkdir(path, 0o700)
    except OSError as error:
        raise ChatError("unsafeState", f"The {label} could not be created.") from error
    validate_private_directory(path, label)


def remove_private_tree(path: str, parent: str) -> None:
    """Remove one exact child without following a link or escaping its parent."""
    if os.path.dirname(path) != parent or not os.path.lexists(path):
        return
    info = os.lstat(path)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        os.unlink(path)
        return
    if info.st_uid != os.getuid() or os.path.realpath(path) != path:
        raise ChatError("unsafeState", "The attachment directory is unsafe.")
    shutil.rmtree(path)


def clear_attachment_root(path: str) -> None:
    if not os.path.lexists(path):
        return
    parent = os.path.dirname(path)
    remove_private_tree(path, parent)


def discard_attachment_request(
    runtime_directory: str, relay_id: str, request_id: str
) -> None:
    request_id = canonical_uuid(request_id, "request ID")
    root = managed_attachment_root(runtime_directory, relay_id)
    if not os.path.lexists(root):
        return
    validate_private_directory(root, "attachment root")
    remove_private_tree(os.path.join(root, request_id), root)


def clear_relay_attachments(runtime_directory: str, relay_id: str) -> None:
    relay_id = canonical_uuid(relay_id, "relay ID")
    session_directory = attachment_session_directory(runtime_directory, relay_id)
    if os.path.lexists(session_directory):
        validate_private_directory(session_directory, "chat state directory")
    for root in (
        managed_attachment_root(runtime_directory, relay_id),
        legacy_attachment_root(relay_id),
    ):
        clear_attachment_root(root)


def _write_all(descriptor: int, data: bytes) -> None:
    offset = 0
    while offset < len(data):
        offset += os.write(descriptor, data[offset:])


def _file_digest(path: str) -> bytes:
    digest = hashlib.sha256()
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        while True:
            chunk = os.read(descriptor, 64 * 1024)
            if not chunk:
                return digest.digest()
            digest.update(chunk)
    finally:
        os.close(descriptor)


def upload_attachment(
    runtime_directory: str,
    relay_id: str,
    request_id: str,
    attachment_id: str,
    extension: str,
    declared_size: int,
) -> str:
    request_id = canonical_uuid(request_id, "request ID")
    attachment_id = canonical_uuid(attachment_id, "attachment ID")
    if (
        not isinstance(extension, str)
        or not re.fullmatch(r"[a-z0-9]{0,10}", extension)
        or isinstance(declared_size, bool)
        or not 0 <= declared_size <= MAX_ATTACHMENT_FILE_BYTES
    ):
        raise ChatError("invalidAttachments", "The attachment upload is invalid.", exit_code=64)

    session_directory = attachment_session_directory(runtime_directory, relay_id)
    validate_private_directory(session_directory, "chat state directory")
    root = managed_attachment_root(runtime_directory, relay_id)
    ensure_private_directory(root, session_directory, "attachment root")
    request_directory = os.path.join(root, request_id)
    ensure_private_directory(
        request_directory, root, "attachment request directory"
    )
    file_name = attachment_id + (f".{extension}" if extension else "")
    final_path = os.path.join(request_directory, file_name)
    temporary_path = os.path.join(
        request_directory, f".{attachment_id}.{new_uuid()}.tmp"
    )
    completed = False
    try:
        descriptor = os.open(
            temporary_path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
        )
        received = 0
        try:
            while True:
                chunk = sys.stdin.buffer.read(
                    min(64 * 1024, declared_size - received + 1)
                )
                if not chunk:
                    break
                received += len(chunk)
                if received > declared_size:
                    raise ChatError(
                        "invalidAttachments",
                        "The attachment upload size is invalid.",
                        exit_code=64,
                    )
                _write_all(descriptor, chunk)
            if received != declared_size:
                raise ChatError(
                    "invalidAttachments",
                    "The attachment upload size is invalid.",
                    exit_code=64,
                )
            os.fsync(descriptor)
        finally:
            os.close(descriptor)

        try:
            os.link(temporary_path, final_path, follow_symlinks=False)
        except FileExistsError:
            existing = os.lstat(final_path)
            if (
                not stat.S_ISREG(existing.st_mode)
                or stat.S_ISLNK(existing.st_mode)
                or existing.st_uid != os.getuid()
                or stat.S_IMODE(existing.st_mode) != 0o600
                or existing.st_size != declared_size
                or _file_digest(final_path) != _file_digest(temporary_path)
            ):
                raise ChatError(
                    "uploadConflict", "The attachment upload identity was reused.", exit_code=75
                )
        completed = True
        return final_path
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary_path)
        if not completed:
            with contextlib.suppress(OSError):
                os.rmdir(request_directory)


def json_depth(value: Any, depth: int = 0) -> int:
    if depth > MAX_JSON_DEPTH:
        return depth
    if isinstance(value, dict):
        if not value:
            return depth + 1
        return max(json_depth(key, depth + 1) for key in value) if False else max(
            [depth + 1]
            + [json_depth(item, depth + 1) for item in value.values()]
        )
    if isinstance(value, list):
        return max(
            [depth + 1] + [json_depth(item, depth + 1) for item in value]
        )
    return depth + 1


def bounded_text(
    value: Any, maximum: int = MAX_INLINE_TEXT_BYTES
) -> tuple[str, bool, int]:
    if value is None:
        return "", False, 0
    if not isinstance(value, str):
        value = json.dumps(
            sanitize_json(value), separators=(",", ":"), ensure_ascii=False
        )
    encoded = value.encode("utf-8", errors="replace")
    original = len(encoded)
    if original <= maximum:
        return value, False, original
    marker = "\n\n… output truncated by Terminal Relay …"
    allowance = max(0, maximum - len(marker.encode("utf-8")))
    result = encoded[:allowance].decode("utf-8", errors="ignore") + marker
    return result, True, original


class BoundedTextChunks:
    """Append bounded UTF-8 chunks without copying prior content per delta."""

    marker = "\n\n… output truncated by Terminal Relay …"

    def __init__(self, value: str = "", maximum: int = MAX_ITEM_BYTES):
        self.maximum = maximum
        self.chunks: list[str] = []
        self.retained_bytes = 0
        self.original_byte_count = 0
        self.truncated = False
        if value:
            self.append(value)

    def append(self, value: str, original_byte_count: int | None = None) -> None:
        encoded = value.encode("utf-8", errors="replace")
        reported = (
            original_byte_count
            if isinstance(original_byte_count, int)
            and original_byte_count >= len(encoded)
            else len(encoded)
        )
        self.original_byte_count += reported
        if self.truncated:
            return
        if self.original_byte_count <= self.maximum:
            self.chunks.append(value)
            self.retained_bytes += len(encoded)
            return

        marker_bytes = len(self.marker.encode("utf-8"))
        allowance = max(0, self.maximum - marker_bytes)
        self._trim_to(allowance)
        if self.retained_bytes < allowance:
            retained = encoded[: allowance - self.retained_bytes].decode(
                "utf-8", errors="ignore"
            )
            if retained:
                self.chunks.append(retained)
                self.retained_bytes += len(retained.encode("utf-8"))
        self.truncated = True

    def _trim_to(self, maximum: int) -> None:
        while self.chunks and self.retained_bytes > maximum:
            chunk = self.chunks.pop()
            encoded = chunk.encode("utf-8")
            before_chunk = self.retained_bytes - len(encoded)
            if before_chunk < maximum:
                retained = encoded[: maximum - before_chunk].decode(
                    "utf-8", errors="ignore"
                )
                if retained:
                    self.chunks.append(retained)
                self.retained_bytes = before_chunk + len(retained.encode("utf-8"))
                return
            self.retained_bytes = before_chunk

    def materialize(self) -> str:
        return "".join(self.chunks) + (self.marker if self.truncated else "")


def sanitize_json(value: Any, depth: int = 0) -> Any:
    """Return a bounded JSON-compatible value without arbitrary object reprs."""
    if depth >= 12:
        return "[nested value omitted]"
    if value is None or isinstance(value, (bool, int, float, str)):
        if isinstance(value, str):
            return bounded_text(value)[0]
        return value
    if dataclasses.is_dataclass(value):
        return sanitize_json(dataclasses.asdict(value), depth + 1)
    if isinstance(value, dict):
        result: dict[str, Any] = {}
        for key, item in list(value.items())[:256]:
            if isinstance(key, str) and len(key) <= 256:
                result[key] = sanitize_json(item, depth + 1)
        return result
    if isinstance(value, (list, tuple)):
        return [sanitize_json(item, depth + 1) for item in list(value)[:512]]
    if hasattr(value, "__dict__"):
        return sanitize_json(vars(value), depth + 1)
    return f"[{type(value).__name__}]"


def encode_record(value: dict[str, Any]) -> bytes:
    encoded = (
        json.dumps(value, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
        + b"\n"
    )
    if len(encoded) > MAX_RECORD_BYTES:
        raise ChatError("recordTooLarge", "A protocol record is too large.")
    return encoded


def command_fingerprint(command: dict[str, Any]) -> str:
    stable = {
        "type": command.get("type"),
        "relayId": command.get("relayId"),
        "provider": command.get("provider"),
        "accountID": command.get("accountID"),
        "providerThreadId": command.get("providerThreadId"),
        "turnId": command.get("turnId"),
        "itemId": command.get("itemId"),
        "payload": command.get("payload"),
    }
    return hashlib.sha256(
        json.dumps(stable, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()


def load_record(raw: bytes) -> dict[str, Any]:
    if len(raw) > MAX_RECORD_BYTES:
        raise ChatError(
            "recordTooLarge",
            "The protocol record exceeded the worker limit.",
            close=True,
        )
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ChatError(
            "invalidEncoding", "The protocol stream is not valid UTF-8.", close=True
        ) from error
    try:
        value = json.loads(text)
    except json.JSONDecodeError as error:
        raise ChatError("invalidJSON", "The protocol record is invalid.", close=True) from error
    if not isinstance(value, dict) or json_depth(value) > MAX_JSON_DEPTH:
        raise ChatError("invalidJSON", "The protocol record is invalid.", close=True)
    return value


def validate_launch_arguments(arguments: list[str]) -> dict[str, Any]:
    """Normalize the small provider launch surface used by native chat."""
    if len(arguments) > 64 or sum(len(item.encode("utf-8")) for item in arguments) > 32768:
        raise ChatError("invalidOptions", "The provider launch options are too large.", exit_code=64)
    accepted: dict[str, Any] = {
        "model": None,
        "effort": None,
        "permissionMode": "default",
        "fullAccess": False,
        "fastMode": False,
    }
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if "\x00" in argument or "\n" in argument or len(argument.encode("utf-8")) > 4096:
            raise ChatError("invalidOptions", "A provider launch option is invalid.", exit_code=64)
        next_value: str | None = None
        if argument in {"--model", "--effort", "--permission-mode", "--sandbox"}:
            index += 1
            if index >= len(arguments):
                raise ChatError("invalidOptions", f"{argument} requires a value.", exit_code=64)
            next_value = arguments[index]
            if not SAFE_OPTION_PATTERN.fullmatch(next_value):
                raise ChatError("invalidOptions", f"{argument} has an invalid value.", exit_code=64)
        if argument == "--model":
            accepted["model"] = next_value
        elif argument == "--effort":
            accepted["effort"] = next_value
        elif argument == "--permission-mode":
            if next_value not in {
                "default",
                "acceptEdits",
                "plan",
                "bypassPermissions",
                "dontAsk",
                "auto",
            }:
                raise ChatError("invalidOptions", "The permission mode is unsupported.", exit_code=64)
            accepted["permissionMode"] = next_value
        elif argument == "--sandbox":
            if next_value not in {"read-only", "workspace-write", "danger-full-access"}:
                raise ChatError("invalidOptions", "The sandbox mode is unsupported.", exit_code=64)
            accepted["sandbox"] = next_value
            accepted["fullAccess"] = next_value == "danger-full-access"
        elif argument in {"--dangerously-bypass-approvals-and-sandbox", "--full-access"}:
            accepted["fullAccess"] = True
            accepted["permissionMode"] = "bypassPermissions"
        elif argument in {"--fast", "--fast-mode"}:
            accepted["fastMode"] = True
        elif argument.startswith("--model="):
            value = argument.partition("=")[2]
            if not SAFE_OPTION_PATTERN.fullmatch(value):
                raise ChatError("invalidOptions", "The model is invalid.", exit_code=64)
            accepted["model"] = value
        elif argument.startswith("--effort="):
            value = argument.partition("=")[2]
            if not SAFE_OPTION_PATTERN.fullmatch(value):
                raise ChatError("invalidOptions", "The effort is invalid.", exit_code=64)
            accepted["effort"] = value
        elif argument.startswith("--permission-mode="):
            value = argument.partition("=")[2]
            if value not in {
                "default",
                "acceptEdits",
                "plan",
                "bypassPermissions",
                "dontAsk",
                "auto",
            }:
                raise ChatError("invalidOptions", "The permission mode is unsupported.", exit_code=64)
            accepted["permissionMode"] = value
        elif argument.startswith("--sandbox="):
            value = argument.partition("=")[2]
            if value not in {"read-only", "workspace-write", "danger-full-access"}:
                raise ChatError("invalidOptions", "The sandbox mode is unsupported.", exit_code=64)
            accepted["sandbox"] = value
            accepted["fullAccess"] = value == "danger-full-access"
        elif argument in {"--model", "--effort", "--permission-mode", "--sandbox"}:
            pass
        else:
            # Do not pass unknown switches through to a shell or SDK.
            raise ChatError(
                "invalidOptions",
                f"The provider launch option is unsupported: {argument}",
                exit_code=64,
            )
        index += 1
    return accepted


def chat_capabilities(
    provider: str, account_id: str | None = None
) -> dict[str, Any]:
    common: dict[str, Any] = {
        "protocolVersion": (
            ACCOUNT_PROTOCOL_VERSION if account_id is not None else PROTOCOL_VERSION
        ),
        "features": [
            "streaming",
            "history",
            "replay",
            "multi-client",
            "interrupt",
            "file-preview",
            "approvals",
            "questions",
            "attachments",
            "terminal-fallback",
        ],
        "supportsHistory": True,
        "supportsFilePreview": True,
        "supportsApprovals": True,
        "supportsQuestions": True,
        "supportsAttachments": True,
    }
    if provider == "codex":
