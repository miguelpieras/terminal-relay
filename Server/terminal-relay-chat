UUID_PATTERN = re.compile(
    r"^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
)
REPOSITORY_PATTERN = re.compile(r"^[A-Za-z0-9._-]{1,100}$")
SAFE_OPTION_PATTERN = re.compile(r"^[A-Za-z0-9._:/+=,-]{1,4096}$")


class ChatError(Exception):
    def __init__(
        self,
        code: str,
        message: str,
        *,
        recoverable: bool = True,
        exit_code: int = 70,
        close: bool = False,
    ):
        super().__init__(message)
        self.code = code
        self.message = message
        self.recoverable = recoverable
        self.exit_code = exit_code
        self.close = close


def now_ms() -> int:
    return time.time_ns() // 1_000_000


def new_uuid() -> str:
    return str(uuid.uuid4())


def canonical_uuid(value: Any, label: str) -> str:
    if not isinstance(value, str) or not UUID_PATTERN.fullmatch(value):
        raise ChatError("invalidIdentity", f"The {label} is invalid.", exit_code=64)
    try:
        canonical = str(uuid.UUID(value))
    except ValueError as error:
        raise ChatError(
            "invalidIdentity", f"The {label} is invalid.", exit_code=64
        ) from error
    if canonical != value:
        raise ChatError("invalidIdentity", f"The {label} is invalid.", exit_code=64)
    return canonical


def canonical_repository(value: str) -> str:
    if not isinstance(value, str) or not REPOSITORY_PATTERN.fullmatch(value):
        raise ChatError("invalidRepository", "The repository is invalid.", exit_code=64)
    return value


def canonical_directory(value: str, label: str) -> str:
    if (
        not isinstance(value, str)
        or not os.path.isabs(value)
        or value == "/"
        or "\n" in value
    ):
        raise ChatError("invalidPath", f"The {label} is invalid.", exit_code=64)
    path = pathlib.Path(value)
    if not path.is_dir() or path.is_symlink():
        raise ChatError("invalidPath", f"The {label} is unavailable.", exit_code=66)
    resolved = os.path.realpath(value)
    if resolved != value:
        raise ChatError("invalidPath", f"The {label} is invalid.", exit_code=64)
    return value


def json_depth(value: Any, depth: int = 0) -> int:
    if depth > MAX_JSON_DEPTH:
        return depth
    if isinstance(value, dict):
        if not value:
            return depth + 1
        return max(json_depth(key, depth + 1) for key in value) if False else max(
            [depth + 1]
            + [json_depth(item, depth + 1) for item in value.values()]
        )
    if isinstance(value, list):
        return max(
            [depth + 1] + [json_depth(item, depth + 1) for item in value]
        )
    return depth + 1


def bounded_text(
    value: Any, maximum: int = MAX_INLINE_TEXT_BYTES
) -> tuple[str, bool, int]:
    if value is None:
        return "", False, 0
    if not isinstance(value, str):
        value = json.dumps(
            sanitize_json(value), separators=(",", ":"), ensure_ascii=False
        )
    encoded = value.encode("utf-8", errors="replace")
    original = len(encoded)
    if original <= maximum:
        return value, False, original
    marker = "\n\n… output truncated by Terminal Relay …"
    allowance = max(0, maximum - len(marker.encode("utf-8")))
    result = encoded[:allowance].decode("utf-8", errors="ignore") + marker
    return result, True, original


def sanitize_json(value: Any, depth: int = 0) -> Any:
    """Return a bounded JSON-compatible value without arbitrary object reprs."""
    if depth >= 12:
        return "[nested value omitted]"
    if value is None or isinstance(value, (bool, int, float, str)):
        if isinstance(value, str):
            return bounded_text(value)[0]
        return value
    if dataclasses.is_dataclass(value):
        return sanitize_json(dataclasses.asdict(value), depth + 1)
    if isinstance(value, dict):
        result: dict[str, Any] = {}
        for key, item in list(value.items())[:256]:
            if isinstance(key, str) and len(key) <= 256:
                result[key] = sanitize_json(item, depth + 1)
        return result
    if isinstance(value, (list, tuple)):
        return [sanitize_json(item, depth + 1) for item in list(value)[:512]]
    if hasattr(value, "__dict__"):
        return sanitize_json(vars(value), depth + 1)
    return f"[{type(value).__name__}]"


def encode_record(value: dict[str, Any]) -> bytes:
    encoded = (
        json.dumps(value, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
        + b"\n"
    )
    if len(encoded) > MAX_RECORD_BYTES:
        raise ChatError("recordTooLarge", "A protocol record is too large.")
    return encoded


def command_fingerprint(command: dict[str, Any]) -> str:
    stable = {
        "type": command.get("type"),
        "relayId": command.get("relayId"),
        "provider": command.get("provider"),
        "providerThreadId": command.get("providerThreadId"),
        "turnId": command.get("turnId"),
        "itemId": command.get("itemId"),
        "payload": command.get("payload"),
    }
    return hashlib.sha256(
        json.dumps(stable, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()


def load_record(raw: bytes) -> dict[str, Any]:
    if len(raw) > MAX_RECORD_BYTES:
        raise ChatError(
            "recordTooLarge",
            "The protocol record exceeded the worker limit.",
            close=True,
        )
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ChatError(
            "invalidEncoding", "The protocol stream is not valid UTF-8.", close=True
        ) from error
    try:
        value = json.loads(text)
    except json.JSONDecodeError as error:
        raise ChatError("invalidJSON", "The protocol record is invalid.", close=True) from error
    if not isinstance(value, dict) or json_depth(value) > MAX_JSON_DEPTH:
        raise ChatError("invalidJSON", "The protocol record is invalid.", close=True)
    return value


def validate_launch_arguments(arguments: list[str]) -> dict[str, Any]:
    """Normalize the small provider launch surface used by native chat."""
    if len(arguments) > 64 or sum(len(item.encode("utf-8")) for item in arguments) > 32768:
        raise ChatError("invalidOptions", "The provider launch options are too large.", exit_code=64)
    accepted: dict[str, Any] = {
        "model": None,
        "effort": None,
        "permissionMode": "default",
        "fullAccess": False,
        "fastMode": False,
    }
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if "\x00" in argument or "\n" in argument or len(argument.encode("utf-8")) > 4096:
            raise ChatError("invalidOptions", "A provider launch option is invalid.", exit_code=64)
        next_value: str | None = None
        if argument in {"--model", "--effort", "--permission-mode", "--sandbox"}:
            index += 1
            if index >= len(arguments):
                raise ChatError("invalidOptions", f"{argument} requires a value.", exit_code=64)
            next_value = arguments[index]
            if not SAFE_OPTION_PATTERN.fullmatch(next_value):
                raise ChatError("invalidOptions", f"{argument} has an invalid value.", exit_code=64)
        if argument == "--model":
            accepted["model"] = next_value
        elif argument == "--effort":
            accepted["effort"] = next_value
        elif argument == "--permission-mode":
            if next_value not in {
                "default",
                "acceptEdits",
                "plan",
                "bypassPermissions",
                "dontAsk",
                "auto",
            }:
                raise ChatError("invalidOptions", "The permission mode is unsupported.", exit_code=64)
            accepted["permissionMode"] = next_value
        elif argument == "--sandbox":
            if next_value not in {"read-only", "workspace-write", "danger-full-access"}:
                raise ChatError("invalidOptions", "The sandbox mode is unsupported.", exit_code=64)
            accepted["sandbox"] = next_value
            accepted["fullAccess"] = next_value == "danger-full-access"
        elif argument in {"--dangerously-bypass-approvals-and-sandbox", "--full-access"}:
            accepted["fullAccess"] = True
            accepted["permissionMode"] = "bypassPermissions"
        elif argument in {"--fast", "--fast-mode"}:
            accepted["fastMode"] = True
        elif argument.startswith("--model="):
            value = argument.partition("=")[2]
            if not SAFE_OPTION_PATTERN.fullmatch(value):
                raise ChatError("invalidOptions", "The model is invalid.", exit_code=64)
            accepted["model"] = value
        elif argument.startswith("--effort="):
            value = argument.partition("=")[2]
            if not SAFE_OPTION_PATTERN.fullmatch(value):
                raise ChatError("invalidOptions", "The effort is invalid.", exit_code=64)
            accepted["effort"] = value
        elif argument.startswith("--permission-mode="):
            value = argument.partition("=")[2]
            if value not in {
                "default",
                "acceptEdits",
                "plan",
                "bypassPermissions",
                "dontAsk",
                "auto",
            }:
                raise ChatError("invalidOptions", "The permission mode is unsupported.", exit_code=64)
            accepted["permissionMode"] = value
        elif argument.startswith("--sandbox="):
            value = argument.partition("=")[2]
            if value not in {"read-only", "workspace-write", "danger-full-access"}:
                raise ChatError("invalidOptions", "The sandbox mode is unsupported.", exit_code=64)
            accepted["sandbox"] = value
            accepted["fullAccess"] = value == "danger-full-access"
        elif argument in {"--model", "--effort", "--permission-mode", "--sandbox"}:
            pass
        else:
            # Do not pass unknown switches through to a shell or SDK.
            raise ChatError(
                "invalidOptions",
                f"The provider launch option is unsupported: {argument}",
                exit_code=64,
            )
        index += 1
    return accepted


def chat_capabilities(provider: str) -> dict[str, Any]:
    common: dict[str, Any] = {
        "protocolVersion": PROTOCOL_VERSION,
        "features": [
            "streaming",
            "history",
            "replay",
            "multi-client",
            "interrupt",
            "file-preview",
            "approvals",
            "questions",
            "attachments",
            "terminal-fallback",
        ],
        "supportsHistory": True,
        "supportsFilePreview": True,
        "supportsApprovals": True,
        "supportsQuestions": True,
        "supportsAttachments": True,
    }
    if provider == "codex":
        common["features"].append("reasoning-effort")
    elif provider == "claude":
        pass
    else:
        raise ChatError("unsupportedProvider", "The provider is unsupported.", exit_code=64)
    common["features"].sort()
    return common


def display_string(value: Any, limit: int = 64 * 1024) -> str | None:
    if value is None:
        return None
    if isinstance(value, str):
        text = value
    else:
        try:
            text = json.dumps(
                sanitize_json(value),
                ensure_ascii=False,
                sort_keys=True,
                separators=(",", ":"),
            )
        except (TypeError, ValueError):
            text = f"[{type(value).__name__}]"
    encoded = text.encode("utf-8")
    if len(encoded) <= limit:
        return text
    return encoded[:limit].decode("utf-8", errors="ignore") + "\n…"


def approval_decisions(values: Any = None) -> list[dict[str, Any]]:
    """Return the small, stable decision vocabulary presented by both clients."""
    normalized: list[dict[str, Any]] = []
    raw_values = values if isinstance(values, list) else []
    aliases = {
        "accept": ("allow", "Allow", False),
        "approve": ("allow", "Allow", False),
        "allow": ("allow", "Allow", False),
        "acceptForSession": ("allowForSession", "Allow for session", False),
        "allowForSession": ("allowForSession", "Allow for session", False),
        "decline": ("deny", "Deny", False),
        "denied": ("deny", "Deny", False),
        "deny": ("deny", "Deny", False),
        "cancel": ("cancel", "Deny and stop", True),
    }
    for raw in raw_values:
        raw_id = raw if isinstance(raw, str) else (
            raw.get("id") if isinstance(raw, dict) else None
        )
        if not isinstance(raw_id, str):
            continue
        mapped = aliases.get(raw_id)
        if not mapped:
            # Complex provider-specific amendments are intentionally not sent
            # through the generic UI until their typed grant subset is modeled.
            continue
        decision_id, label, destructive = mapped
        if any(item["id"] == decision_id for item in normalized):
            continue
        if isinstance(raw, dict):
            label = str(raw.get("label") or label)
            destructive = bool(
                raw.get("destructive", raw.get("isDestructive", destructive))
            )
        normalized.append(
            {
                "id": decision_id,
                "label": label[:200],
                "destructive": destructive,
                "isDestructive": destructive,
            }
        )
    if not any(item["id"] == "allow" for item in normalized):
        normalized.insert(
            0,
            {
                "id": "allow",
                "label": "Allow",
                "destructive": False,
                "isDestructive": False,
            },
        )
    if not any(item["id"] == "deny" for item in normalized):
        normalized.append(
            {
                "id": "deny",
                "label": "Deny",
                "destructive": False,
                "isDestructive": False,
            }
        )
    return normalized


def canonical_questions(value: Any) -> list[dict[str, Any]]:
    if isinstance(value, dict):
        source = value.get("questions")
        if not isinstance(source, list):
            source = [value]
    elif isinstance(value, list):
        source = value
    else:
        source = []
    questions: list[dict[str, Any]] = []
    for index, raw in enumerate(source[:32]):
        if not isinstance(raw, dict):
            continue
        prompt = raw.get("prompt") or raw.get("question") or raw.get("header")
        if not isinstance(prompt, str) or not prompt.strip():
            continue
        question_id = raw.get("id")
        if not isinstance(question_id, str) or not question_id:
            question_id = str(index)
        raw_options = raw.get("options")
        options: list[dict[str, Any]] = []
        if isinstance(raw_options, list):
            for option_index, option in enumerate(raw_options[:64]):
                if isinstance(option, str):
                    option_id = label = option
                    detail = None
                elif isinstance(option, dict):
                    label = option.get("label") or option.get("value")
                    if not isinstance(label, str):
                        continue
                    option_id = option.get("id") or option.get("value") or label
                    if not isinstance(option_id, str):
                        option_id = str(option_index)
                    detail = option.get("detail") or option.get("description")
                    if not isinstance(detail, str):
                        detail = None
                else:
                    continue
                options.append(
                    {
                        "id": option_id[:500],
                        "label": label[:1000],
                        "detail": detail[:4000] if detail else None,
                    }
                )
        is_secret = bool(raw.get("isSecret") or raw.get("secret"))
        allows_multiple = bool(
            raw.get("allowsMultiple")
            or raw.get("multiSelect")
            or raw.get("multiple")
        )
        if is_secret:
            question_kind = "secret"
        elif options:
            question_kind = "multipleChoice" if allows_multiple else "singleChoice"
        else:
            question_kind = "freeText"
        questions.append(
            {
                "id": question_id[:500],
                "prompt": prompt[:8000],
                "kind": question_kind,
                "options": options,
                "allowsOther": bool(raw.get("allowsOther") or raw.get("isOther")),
            }
        )
    return questions


def canonical_client_answers(value: Any) -> list[dict[str, Any]]:
    if isinstance(value, dict):
        return [
            {
                "questionID": str(question_id),
                "selectedOptionIDs": (
                    answer if isinstance(answer, list) else [answer]
                ),
                "text": None,
            }
            for question_id, answer in value.items()
        ]
    if not isinstance(value, list):
        raise ChatError("invalidAnswer", "The question answer is invalid.")
    result: list[dict[str, Any]] = []
    for raw in value:
        if not isinstance(raw, dict):
            raise ChatError("invalidAnswer", "The question answer is invalid.")
        question_id = raw.get("questionID", raw.get("questionId"))
        selected = raw.get("selectedOptionIDs", raw.get("selectedOptionIds", []))
        text = raw.get("text")
        if (
            not isinstance(question_id, str)
            or not isinstance(selected, list)
            or any(not isinstance(item, str) for item in selected)
            or (text is not None and not isinstance(text, str))
        ):
            raise ChatError("invalidAnswer", "The question answer is invalid.")
        result.append(
            {
                "questionID": question_id,
                "selectedOptionIDs": selected,
                "text": text,
            }
        )
    return result


def codex_sandbox_policy(value: str) -> dict[str, Any]:
    policies = {
        "read-only": {"type": "readOnly"},
        "workspace-write": {
            "type": "workspaceWrite",
            "writableRoots": [],
            "networkAccess": False,
            "excludeTmpdirEnvVar": False,
            "excludeSlashTmp": False,
        },
        "danger-full-access": {"type": "dangerFullAccess"},
    }
    try:
        return policies[value]
