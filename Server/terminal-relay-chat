    discard = subparsers.add_parser("discard-upload", add_help=False)
    discard.add_argument("--runtime-directory", required=True)
    discard.add_argument("--relay-id", required=True)
    discard.add_argument("--provider", choices=("codex", "claude"), required=True)
    discard.add_argument("--repository", required=True)
