    stop = subparsers.add_parser("stop", add_help=False)
    stop.add_argument("--runtime-directory", required=True)
    stop.add_argument("--relay-id", required=True)
    stop.add_argument("--provider", choices=("codex", "claude"), required=True)
    stop.add_argument("--repository", required=True)
    stop.add_argument("--account-id")

    upload = subparsers.add_parser("upload", add_help=False)
    upload.add_argument("--runtime-directory", required=True)
    upload.add_argument("--relay-id", required=True)
    upload.add_argument("--provider", choices=("codex", "claude"), required=True)
    upload.add_argument("--repository", required=True)
    upload.add_argument("--account-id")
    upload.add_argument("--request-id", required=True)
    upload.add_argument("--attachment-id", required=True)
    upload.add_argument("--extension", default="")
