    chat_status = subparsers.add_parser("inspect-status", add_help=False)
    chat_status.add_argument("--runtime-directory", required=True)
    chat_status.add_argument("--account-aware", action="store_true")

    attach = subparsers.add_parser("attach", add_help=False)
