]

TOOL_ARGUMENT_KEYS = {
    "list_projects": set(),
    "list_threads": {"repository", "archived", "cursor"},
    "start_thread": {"repository"},
    "resume_thread": {"repository", "thread_id"},
    "rename_thread": {"repository", "thread_id", "name"},
    "archive_thread": {"repository", "thread_id"},
    "unarchive_thread": {"repository", "thread_id"},
}


def call_tool(name, arguments):
    if not isinstance(arguments, dict):
        raise ValueError("tool arguments must be an object")
    allowed_keys = TOOL_ARGUMENT_KEYS.get(name)
    if allowed_keys is None:
        raise ValueError("unknown tool")
    if set(arguments) - allowed_keys:
        raise ValueError("tool arguments contain unsupported fields")
    if name == "list_projects":
        return {"projects": parse_projects(run_helper("list-projects"))}
    if name == "list_threads":
        return list_threads(arguments)
    repository = require_repository(arguments.get("repository"))
    if name == "start_thread":
        return parse_thread_catalog(run_helper("thread-create", repository), repository)
    thread_id = require_thread_id(arguments.get("thread_id"))
    if name == "resume_thread":
        output = run_helper("thread-resume", repository, thread_id)
        live = parse_live_sessions(output, repository)
        if len(live) != 1 or live[0]["threadID"] != thread_id:
            raise RuntimeError("The worker did not resume the requested thread.")
        return {"threads": live, "nextCursor": None}
    if name == "rename_thread":
        name_value = require_name(arguments.get("name"))
        return parse_thread_catalog(
            run_helper("thread-rename", repository, thread_id, name_value),
            repository,
        )
    if name in ("archive_thread", "unarchive_thread"):
        command = "thread-archive" if name == "archive_thread" else "thread-unarchive"
        return parse_thread_catalog(
            run_helper(command, repository, thread_id),
            repository,
        )
    raise ValueError("unknown tool")


def response(request_id, result=None, error=None):
    value = {"jsonrpc": "2.0", "id": request_id}
    if error is not None:
        value["error"] = error
    else:
        value["result"] = result
    sys.stdout.write(json.dumps(value, separators=(",", ":"), ensure_ascii=False) + "\n")
    sys.stdout.flush()


def handle(message):
    if not isinstance(message, dict) or message.get("jsonrpc") != "2.0":
        raise ValueError("invalid JSON-RPC request")
    request_id = message.get("id")
    method = message.get("method")
    if request_id is None:
        return
    if method == "initialize":
        response(
            request_id,
            {
                "protocolVersion": "2025-03-26",
                "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": {"name": "terminal-relay", "version": "1.0.0"},
            },
        )
    elif method == "ping":
        response(request_id, {})
    elif method == "tools/list":
        response(request_id, {"tools": TOOLS})
    elif method == "tools/call":
        params = message.get("params")
        if not isinstance(params, dict) or not isinstance(params.get("name"), str):
            raise ValueError("invalid tool call")
        try:
            result = tool_result(call_tool(params["name"], params.get("arguments", {})))
        except (RuntimeError, ValueError) as error:
            result = {
                "content": [{"type": "text", "text": str(error)}],
                "isError": True,
            }
        response(request_id, result)
    else:
        response(request_id, error={"code": -32601, "message": "Method not found"})


def main():
    for encoded_line in sys.stdin.buffer:
        if len(encoded_line) > MAXIMUM_MESSAGE_BYTES:
            response(None, error={"code": -32600, "message": "Request too large"})
            continue
        try:
            handle(json.loads(encoded_line))
        except (UnicodeDecodeError, json.JSONDecodeError, ValueError):
            response(None, error={"code": -32600, "message": "Invalid Request"})


if __name__ == "__main__":
    main()
