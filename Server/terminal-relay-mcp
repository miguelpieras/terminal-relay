#!/usr/bin/python3
"""Local stdio MCP server for one Terminal Relay worker."""

import json
import os
import re
import stat
import subprocess
import sys
import uuid


INSTALLED_PATH = "/usr/local/bin/terminal-relay-mcp"
INSTALLED_HELPER = "/usr/local/bin/terminal-relay-session"
SESSION_MARKER = "__TERMINAL_RELAY_SESSION_V1__"
THREAD_MARKER = "__TERMINAL_RELAY_THREADS_V1__"
THREAD_MARKER_V2 = "__TERMINAL_RELAY_THREADS_V2__"
MAXIMUM_MESSAGE_BYTES = 1024 * 1024
PROVIDER_ACCOUNTS_DIRECTORY = ".local/share/terminal-relay/provider-accounts-v1"
PROVIDER_ACCOUNTS_ACTIVATION_CONTENT = b"version|1\n"
REPOSITORY_PATTERN = re.compile(r"^[A-Za-z0-9._-]{1,100}$")
PROVIDERS = ("codex", "claude")
CLAUDE_RESUME_ARGUMENTS = (
    "--settings",
    '{"terminalProgressBarEnabled":true}',
    "--mcp-config",
    '{"mcpServers":{"terminal_relay":{"command":"/usr/local/bin/terminal-relay-mcp"}}}',
    "--strict-mcp-config",
    "--dangerously-skip-permissions",
)


def provider_accounts_root():
    if (
        os.path.realpath(__file__) != INSTALLED_PATH
        and os.environ.get("TERMINAL_RELAY_MCP_TEST_MODE") == "1"
        and os.environ.get("TERMINAL_RELAY_MCP_TEST_PROVIDER_ACCOUNTS_ROOT")
    ):
        return os.environ["TERMINAL_RELAY_MCP_TEST_PROVIDER_ACCOUNTS_ROOT"]
    home = os.environ.get("HOME")
    if not home or not os.path.isabs(home) or home == "/" or "\n" in home:
        return None
    return os.path.join(home, PROVIDER_ACCOUNTS_DIRECTORY)


def account_activation_error():
    root = provider_accounts_root()
    if root is None:
        return None
    marker = os.path.join(root, "activated")
    try:
        descriptor = os.open(
            marker, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
        )
    except FileNotFoundError:
        return None
    except OSError:
        return "unsafeState"
    try:
        try:
            info = os.fstat(descriptor)
            content = os.read(
                descriptor, len(PROVIDER_ACCOUNTS_ACTIVATION_CONTENT) + 1
            )
        except OSError:
            return "unsafeState"
    finally:
        os.close(descriptor)
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid != os.getuid()
        or stat.S_IMODE(info.st_mode) != 0o600
        or content != PROVIDER_ACCOUNTS_ACTIVATION_CONTENT
    ):
        return "unsafeState"
    return "upgradeRequired"


def account_activation_tool_error(code):
    message = (
        "upgradeRequired: MCP tools are unavailable after multi-account activation."
        if code == "upgradeRequired"
        else "unsafeState: the provider account activation state is invalid."
    )
    return {
        "content": [{"type": "text", "text": message}],
        "structuredContent": {"code": code},
        "isError": True,
    }


def helper_path():
    current_path = os.path.realpath(__file__)
    if current_path == INSTALLED_PATH:
        return INSTALLED_HELPER
    if os.environ.get("TERMINAL_RELAY_MCP_TEST_MODE") == "1":
        candidate = os.environ.get("TERMINAL_RELAY_MCP_TEST_HELPER", "")
        if os.path.isabs(candidate) and os.path.isfile(candidate):
            return candidate
    return INSTALLED_HELPER


def helper_timeout_seconds():
    if (
        os.path.realpath(__file__) != INSTALLED_PATH
        and os.environ.get("TERMINAL_RELAY_MCP_TEST_MODE") == "1"
    ):
        value = os.environ.get("TERMINAL_RELAY_MCP_TEST_TIMEOUT_SECONDS")
        if value is not None:
            try:
                timeout = float(value)
            except ValueError:
                timeout = 30
            if 0.05 <= timeout <= 30:
                return timeout
    return 30


def require_repository(value):
    if not isinstance(value, str) or not REPOSITORY_PATTERN.fullmatch(value):
        raise ValueError("repository must be a valid worker project name")
    return value


def require_thread_id(value):
    if not isinstance(value, str):
        raise ValueError("thread_id must be a UUID")
    try:
        canonical = str(uuid.UUID(value))
    except ValueError as error:
        raise ValueError("thread_id must be a UUID") from error
    if canonical != value:
        raise ValueError("thread_id must be a canonical UUID")
    return canonical


def require_provider(value, allow_all=False):
    allowed = (*PROVIDERS, "all") if allow_all else PROVIDERS
    if not isinstance(value, str) or value not in allowed:
        raise ValueError(f"provider must be one of: {', '.join(allowed)}")
    return value


def require_name(value):
    if not isinstance(value, str) or not value.strip() or "\n" in value:
        raise ValueError("name must be a non-empty single line")
    name = value.strip()
    if len(name.encode("utf-8")) > 200:
        raise ValueError("name must be at most 200 UTF-8 bytes")
    return name


def run_helper(*arguments):
    activation_error = account_activation_error()
    if activation_error is not None:
        raise RuntimeError(activation_error)
    environment = {"PATH": "/usr/local/bin:/usr/bin:/bin"}
    if (
        os.path.realpath(__file__) != INSTALLED_PATH
        and os.environ.get("TERMINAL_RELAY_MCP_TEST_MODE") == "1"
        and os.environ.get("TERMINAL_RELAY_MCP_HELPER_LOG")
    ):
        environment["TERMINAL_RELAY_MCP_HELPER_LOG"] = os.environ[
            "TERMINAL_RELAY_MCP_HELPER_LOG"
        ]
    try:
        result = subprocess.run(
            [helper_path(), *arguments],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=helper_timeout_seconds(),
            check=False,
            env=environment,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError("The worker session helper is unavailable.") from error
    if result.returncode != 0:
        raise RuntimeError("The worker rejected the requested operation.")
    if len(result.stdout.encode("utf-8")) > MAXIMUM_MESSAGE_BYTES:
        raise RuntimeError("The worker returned an oversized response.")
    return result.stdout


def parse_projects(output):
    lines = output.splitlines()
    try:
        marker_index = lines.index(SESSION_MARKER)
    except ValueError as error:
        raise RuntimeError("The worker returned an invalid project catalog.") from error
    projects = []
    for line in lines[marker_index + 1 :]:
        if not line:
            continue
        fields = line.split("|")
        if len(fields) != 2 or fields[0] != "project":
            raise RuntimeError("The worker returned an invalid project catalog.")
        projects.append(require_repository(fields[1]))
    return sorted(set(projects))


def parse_thread_catalog(output, repository, expected_provider="codex"):
    lines = output.splitlines()
    try:
        marker = THREAD_MARKER_V2 if THREAD_MARKER_V2 in lines else THREAD_MARKER
        marker_index = lines.index(marker)
        value = json.loads(lines[marker_index + 1])
    except (ValueError, IndexError, json.JSONDecodeError) as error:
        raise RuntimeError("The worker returned an invalid thread catalog.") from error
    if not isinstance(value, dict) or not isinstance(value.get("threads"), list):
        raise RuntimeError("The worker returned an invalid thread catalog.")
    normalized = []
    seen_thread_ids = set()
    for thread in value["threads"]:
        if not isinstance(thread, dict):
            raise RuntimeError("The worker returned an invalid thread catalog.")
        provider = thread.get("provider")
        if provider != expected_provider or provider not in PROVIDERS:
            raise RuntimeError("The worker returned an invalid thread provider.")
        thread_id = require_thread_id(thread.get("threadID"))
        if thread_id in seen_thread_ids:
            raise RuntimeError("The worker returned a duplicate thread.")
        seen_thread_ids.add(thread_id)
        title = thread.get("title")
        if title is not None and (
            not isinstance(title, str) or len(title.encode("utf-8")) > 200
        ):
            raise RuntimeError("The worker returned an invalid thread title.")
        updated_at = thread.get("updatedAt")
        if not isinstance(updated_at, int) or updated_at < 0:
            raise RuntimeError("The worker returned an invalid activity time.")
        if not isinstance(thread.get("archived"), bool):
            raise RuntimeError("The worker returned an invalid archive state.")
        archived = thread["archived"]
        activity_state = thread.get("activityState", "inactive")
        if activity_state not in (
            "inactive",
            "relay-active",
            "external-active",
            "unknown",
        ):
            raise RuntimeError("The worker returned an invalid activity state.")
        active_instance = thread.get("activeInstanceToken")
        if active_instance is not None:
            active_instance = require_thread_id(active_instance)
        working = thread.get("isWorking")
        if working is not None and not isinstance(working, bool):
            raise RuntimeError("The worker returned an invalid working state.")
        capabilities = thread.get("capabilities")
        if not isinstance(capabilities, dict) or set(capabilities) != {
            "resume",
            "rename",
            "archive",
            "unarchive",
        }:
            raise RuntimeError("The worker returned invalid thread capabilities.")
        if not all(isinstance(value, bool) for value in capabilities.values()):
            raise RuntimeError("The worker returned invalid thread capabilities.")
        expected_capabilities = (
            {
                "resume": False,
                "rename": False,
                "archive": False,
                "unarchive": False,
            }
            if activity_state != "inactive"
            else {
                "resume": not archived,
                "rename": not archived,
                "archive": not archived,
                "unarchive": archived,
            }
        )
        if (
            capabilities != expected_capabilities
            or (activity_state == "relay-active") != (active_instance is not None)
            or (activity_state != "relay-active" and working is not None)
        ):
            raise RuntimeError("The worker returned inconsistent thread metadata.")
        normalized.append(
            {
                "provider": provider,
                "repositoryName": repository,
                "threadID": thread_id,
                "title": title,
                "updatedAt": updated_at,
                "archived": archived,
                "activityState": activity_state,
                "activeInstanceToken": active_instance,
                "isWorking": working,
                "capabilities": capabilities,
            }
        )
    next_cursor = value.get("nextCursor")
    if next_cursor is not None and (
        not isinstance(next_cursor, str)
        or len(next_cursor.encode("utf-8")) > 2048
        or "\n" in next_cursor
    ):
        raise RuntimeError("The worker returned an invalid thread cursor.")
    return {"threads": normalized, "nextCursor": next_cursor}


def parse_live_sessions(output, repository):
    lines = output.splitlines()
    try:
        marker_index = lines.index(SESSION_MARKER)
    except ValueError as error:
        raise RuntimeError("The worker returned invalid live sessions.") from error
    sessions = []
    for line in lines[marker_index + 1 :]:
        if not line:
            continue
        fields = line.split("|")
        if fields[0] != "session":
            continue
        if len(fields) not in (5, 7, 8, 9) or fields[2] != repository:
            continue
        provider = fields[1]
        if provider not in ("codex", "claude"):
            continue
        instance_id = require_thread_id(fields[4])
        thread_id = instance_id if provider == "claude" else None
        if len(fields) == 9 and fields[8]:
            thread_id = require_thread_id(fields[8])
        if thread_id is None:
            continue
        updated_at = 0
        if len(fields) >= 7:
            try:
                updated_at = int(fields[5])
            except ValueError as error:
                raise RuntimeError("The worker returned an invalid activity time.") from error
            if updated_at < 0:
                raise RuntimeError("The worker returned an invalid activity time.")
        title = None
        if len(fields) >= 7 and fields[6]:
            try:
                title = bytes.fromhex(fields[6]).decode("utf-8")
            except (ValueError, UnicodeDecodeError) as error:
                raise RuntimeError("The worker returned an invalid session title.") from error
            if len(title.encode("utf-8")) > 200:
                raise RuntimeError("The worker returned an invalid session title.")
        working = None
        if len(fields) >= 8 and fields[7] in ("0", "1"):
            working = fields[7] == "1"
        sessions.append(
            {
                "provider": provider,
                "repositoryName": repository,
                "threadID": thread_id,
                "title": title,
                "updatedAt": updated_at,
                "archived": False,
                "activityState": "relay-active",
                "activeInstanceToken": instance_id,
                "isWorking": working,
                "capabilities": {
                    "resume": False,
                    "rename": False,
                    "archive": False,
                    "unarchive": False,
                },
            }
        )
    return sessions


def list_threads(arguments):
    repository = require_repository(arguments.get("repository"))
    requested_provider = require_provider(arguments.get("provider", "all"), allow_all=True)
    archived = arguments.get("archived", False)
    if not isinstance(archived, bool):
        raise ValueError("archived must be a boolean")
    cursor = arguments.get("cursor")
    if cursor is not None and (
        not isinstance(cursor, str)
        or len(cursor.encode("utf-8")) > 2048
        or "\n" in cursor
    ):
        raise ValueError("cursor is invalid")
    if requested_provider == "all" and cursor:
        raise ValueError("cursor requires an explicit provider")
    providers = PROVIDERS if requested_provider == "all" else (requested_provider,)
    threads = []
    next_cursors = {}
    for provider in providers:
        helper_arguments = [
            "threads-v2",
            provider,
            repository,
            "archived" if archived else "open",
        ]
        if cursor:
            helper_arguments.append(cursor)
        catalog = parse_thread_catalog(
            run_helper(*helper_arguments),
            repository,
            provider,
        )
        threads.extend(catalog["threads"])
        next_cursors[provider] = catalog["nextCursor"]
    result = {
        "threads": threads,
        "nextCursor": (
            next_cursors[requested_provider]
            if requested_provider != "all"
            else None
        ),
    }
    if requested_provider == "all":
        result["nextCursors"] = next_cursors
    if archived:
        result["threads"].sort(
            key=lambda thread: (-thread["updatedAt"], thread["threadID"])
        )
        return result
    live = parse_live_sessions(run_helper("status"), repository)
    if requested_provider != "all":
        live = [
            thread for thread in live if thread["provider"] == requested_provider
        ]
    by_identity = {
        (thread["provider"], thread["threadID"]): thread
        for thread in result["threads"]
    }
    for thread in live:
        by_identity[(thread["provider"], thread["threadID"])] = thread
    result["threads"] = sorted(
        by_identity.values(),
        key=lambda thread: (-thread["updatedAt"], thread["threadID"]),
    )
    return result


def tool_result(value):
    text = json.dumps(value, separators=(",", ":"), ensure_ascii=False)
    return {
        "content": [{"type": "text", "text": text}],
        "structuredContent": value,
    }


