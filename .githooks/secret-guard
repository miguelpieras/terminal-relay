#!/bin/bash
set -eu

repository_root="$(git rev-parse --show-toplevel)"
cd "$repository_root"

allowed_committer_email="$(git config --local --get terminalRelay.allowedCommitterEmail || true)"
if [[ -z "$allowed_committer_email" ]]; then
    echo "Secret guard is not configured for this checkout." >&2
    echo "Set terminalRelay.allowedCommitterEmail in the repository-local Git config." >&2
    exit 1
fi

temporary_root="${TMPDIR:-/tmp}"
if [[ "$temporary_root" != /* || ! -d "$temporary_root" ]]; then
    echo "Secret guard cannot use temporary directory: $temporary_root" >&2
    exit 1
fi

scan_file="$(/usr/bin/mktemp "$temporary_root/terminal-relay-secret-guard.XXXXXX")"
commit_list_file="$(/usr/bin/mktemp "$temporary_root/terminal-relay-secret-guard-commits.XXXXXX")"
cleanup() {
    /bin/rm -f -- "$scan_file" "$commit_list_file"
}
trap cleanup EXIT

strong_secret_pattern='(-----BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY-----|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|sk-(proj-|ant-)?[A-Za-z0-9_-]{20,}|sk_(live|test)_[A-Za-z0-9]{20,}|rk_live_[A-Za-z0-9]{20,}|(AKIA|ASIA)[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{20,}|AIza[0-9A-Za-z_-]{30,}|tskey-[A-Za-z0-9_-]{20,})'
assigned_secret_pattern="['\"]?(password|passwd|secret|token|api[_-]?key)['\"]?[[:space:]]*[:=][[:space:]]*['\"]?[A-Za-z0-9/+_.=-]{24,}"
generated_tailnet_pattern='tail[0-9a-f]{4,}[.]ts[.]net'

fail_guard() {
    local category="$1"
    local location="$2"
    printf 'Secret guard blocked %s in %s. Remove it before committing or pushing.\n' \
        "$category" "$location" >&2
    return 1
}

contains_blocked_literal() {
    local value="$1"
    local blocked_literal

    while IFS= read -r blocked_literal; do
        [[ -n "$blocked_literal" ]] || continue
        if /usr/bin/printf '%s' "$value" | /usr/bin/grep -Fqi -- "$blocked_literal"; then
            return 0
        fi
    done < <(git config --local --get-all terminalRelay.blockedLiteral || true)

    return 1
}

is_sensitive_path() {
    local path="$1"

    case "$path" in
        .env|*/.env|.env.*|*/.env.*)
            case "$path" in
                *.example) return 1 ;;
            esac
            return 0
            ;;
        .netrc|*/.netrc|*.key|*.p8|*.p12|*.pem|*.pfx|*/id_dsa|*/id_ecdsa|*/id_ed25519|*/id_rsa|id_dsa|id_ecdsa|id_ed25519|id_rsa)
            return 0
            ;;
    esac

    return 1
}

scan_path() {
    local path="$1"

    if is_sensitive_path "$path"; then
        fail_guard "a sensitive filename" "$path"
        return 1
    fi

    if contains_blocked_literal "$path"; then
        fail_guard "a repository-local blocked value" "$path"
        return 1
    fi
}

scan_buffer() {
    local location="$1"
    local blocked_literal

    if /usr/bin/grep -Eaq "$strong_secret_pattern" "$scan_file"; then
        fail_guard "a credential or private key" "$location"
        return 1
    fi

    if /usr/bin/grep -Eaiq "$assigned_secret_pattern" "$scan_file"; then
        fail_guard "a likely assigned secret" "$location"
        return 1
    fi

    if /usr/bin/grep -Eaiq "$generated_tailnet_pattern" "$scan_file"; then
        fail_guard "a generated Tailscale namespace" "$location"
        return 1
    fi

    while IFS= read -r blocked_literal; do
        [[ -n "$blocked_literal" ]] || continue
        if /usr/bin/grep -Faiq -- "$blocked_literal" "$scan_file"; then
            fail_guard "a repository-local blocked value" "$location"
            return 1
        fi
    done < <(git config --local --get-all terminalRelay.blockedLiteral || true)
}

scan_blob() {
    local object="$1"
    local path="$2"
    local location="${3:-$path}"

    scan_path "$path"

    if ! git cat-file blob "$object" > "$scan_file" 2>/dev/null; then
        return 0
    fi
    scan_buffer "$location"
}

scan_prospective_identity() {
    local author_identity
    local committer_email

    committer_email="$(git var GIT_COMMITTER_IDENT | /usr/bin/sed -E 's/^.*<([^>]*)>.*$/\1/')"
    if [[ "$committer_email" != "$allowed_committer_email" ]]; then
        echo "Secret guard requires the repository-local GitHub noreply address for commits." >&2
        exit 1
    fi

    author_identity="$(git var GIT_AUTHOR_IDENT)"
    if contains_blocked_literal "$author_identity"; then
        fail_guard "a blocked author identity" "commit metadata"
        exit 1
    fi
}

scan_staged_index() {
    local path

    scan_prospective_identity
    while IFS= read -r -d '' path; do
        scan_blob ":$path" "$path"
    done < <(git ls-files --cached -z)
}

scan_commit() {
    local commit="$1"
    local path
    local short_commit

    short_commit="$(git rev-parse --short "$commit")"
    git cat-file commit "$commit" > "$scan_file"
    scan_buffer "commit $short_commit metadata"

    while IFS= read -r -d '' path; do
        if git cat-file -e "$commit:$path" 2>/dev/null; then
            scan_blob "$commit:$path" "$path" "$path at $short_commit"
        fi
    done < <(git ls-tree -r --name-only -z "$commit")
}

scan_pushed_commits() {
    local remote_name="$1"
    local local_ref
    local local_sha
    local remote_ref
    local remote_sha
    local commit
    local zero_sha="0000000000000000000000000000000000000000"

    while read -r local_ref local_sha remote_ref remote_sha; do
        [[ -n "$local_ref" ]] || continue
        [[ "$local_sha" != "$zero_sha" ]] || continue

        if [[ "$remote_sha" == "$zero_sha" ]]; then
            if ! git rev-list "$local_sha" --not --remotes="$remote_name" > "$commit_list_file"; then
                git rev-list "$local_sha" > "$commit_list_file"
            fi
        elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
            git rev-list "$remote_sha..$local_sha" > "$commit_list_file"
        else
            git rev-list "$local_sha" > "$commit_list_file"
        fi

        while IFS= read -r commit; do
            [[ -n "$commit" ]] && scan_commit "$commit"
        done < "$commit_list_file"
    done
}

case "${1:-}" in
    staged)
        scan_staged_index
        ;;
    pushed)
        shift
        scan_pushed_commits "${1:-origin}"
        ;;
    *)
        echo "usage: secret-guard <staged|pushed> [remote-name]" >&2
        exit 64
        ;;
esac
